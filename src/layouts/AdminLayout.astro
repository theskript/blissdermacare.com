  <script>
    import { requireLogin, getRole, clearAuth, decodePayload, getToken } from '../scripts/adminAuth.js';
    requireLogin();

    const token   = getToken();
    const payload = decodePayload(token || '');
    const role    = getRole();

    const usernameEl = document.getElementById('sidebar-username');
    const roleEl     = document.getElementById('sidebar-role');
    const initialsEl = document.getElementById('sidebar-initials');
    const username   = payload?.username || role || '—';
    if (usernameEl)  usernameEl.textContent = username;
    if (roleEl)      roleEl.textContent     = role || '—';
    if (initialsEl)  initialsEl.textContent = username.slice(0,2).toUpperCase();

    if (role === 'owner') {
      document.querySelectorAll('.owner-only-nav').forEach(el => el.classList.remove('hidden'));
      document.querySelectorAll('.mobile-owner-only').forEach(el => el.classList.remove('hidden'));
    }

    // ── Accordion group toggling ──────────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('.nav-group-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const grp = btn.closest<HTMLElement>('.nav-group');
        if (!grp) return;
        // If sidebar is collapsed, expand it first then open the group
        if (sidebar.classList.contains('sb-closed')) {
          applySidebarState(true);
          localStorage.setItem('bliss_sb2', 'open');
        }
        const isOpen = grp.classList.contains('grp-open');
        // Close all groups in same container, then open clicked unless it was open
        const container = grp.closest('nav, div')!;
        container.querySelectorAll('.nav-group.grp-open').forEach(g => g.classList.remove('grp-open'));
        if (!isOpen) grp.classList.add('grp-open');
      });
    });

    // ── Sidebar collapse toggle ───────────────────────────────────────────────
    const sidebar = document.getElementById('sidebar')!;
    const main    = document.getElementById('main-content')!;
    const OPEN_W  = '13rem';
    const CLOSED_W = '3.5rem';

    const isOpen = localStorage.getItem('bliss_sb2') !== 'closed';
    const isMobile = () => window.innerWidth < 1024;
    function applySidebarState(open: boolean) {
      sidebar.style.width = open ? OPEN_W : CLOSED_W;
      main.style.marginLeft = isMobile() ? '0' : (open ? OPEN_W : CLOSED_W);
      sidebar.classList.toggle('sb-open', open);
      sidebar.classList.toggle('sb-closed', !open);
    }
    applySidebarState(isOpen);

    // Reset margin on resize (e.g. rotating device)
    window.addEventListener('resize', () => applySidebarState(sidebar.classList.contains('sb-open')));

    document.getElementById('sb-toggle')?.addEventListener('click', () => {
      const willOpen = sidebar.classList.contains('sb-closed');
      applySidebarState(willOpen);
      localStorage.setItem('bliss_sb2', willOpen ? 'open' : 'closed');
    });

    function doLogout() { clearAuth(); window.location.href = '/admin/login'; }
    document.getElementById('logout-btn')?.addEventListener('click', doLogout);
    document.getElementById('mobile-logout-btn')?.addEventListener('click', doLogout);

    const mobileSidebar = document.getElementById('mobile-sidebar');
    document.getElementById('mobile-menu-btn')?.addEventListener('click', () => mobileSidebar?.classList.remove('hidden'));
    document.getElementById('mobile-menu-btn-bottom')?.addEventListener('click', () => mobileSidebar?.classList.remove('hidden'));
    document.getElementById('mobile-sidebar-overlay')?.addEventListener('click', () => mobileSidebar?.classList.add('hidden'));
    document.getElementById('mobile-close-btn')?.addEventListener('click', () => mobileSidebar?.classList.add('hidden'));
  </script>

