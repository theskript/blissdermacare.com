---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Page Builder" activeNav="page-builder">
  <div class="p-6 lg:p-8">

    <div id="page-list-view">
      <div class="mb-6 flex items-start justify-between gap-4 flex-wrap">
        <div>
          <h1 class="text-2xl font-serif font-semibold text-neutral-900">Page Builder</h1>
          <p class="text-sm text-neutral-500 mt-0.5">Create and manage custom website pages. Published pages are live at <code class="text-xs bg-neutral-100 px-1 py-0.5 rounded">/p/your-slug</code></p>
        </div>
        <button id="new-page-btn"
          class="inline-flex items-center gap-2 px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-xl transition-colors shadow-sm shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          New Page
        </button>
      </div>
      <div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden">
        <div id="pages-table" class="overflow-x-auto">
          <div class="px-6 py-10 text-center text-neutral-400 text-sm">Loading…</div>
        </div>
      </div>
    </div>

    <!-- Page editor (hidden until a page is opened) -->
    <div id="page-editor-view" class="hidden">
      <!-- Editor toolbar -->
      <div class="flex items-center gap-3 mb-5 flex-wrap">
        <button id="back-to-list" class="flex items-center gap-1.5 text-sm text-neutral-500 hover:text-neutral-800 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          All Pages
        </button>
        <span class="text-neutral-300">/</span>
        <input id="page-title-input" type="text" placeholder="Page title"
          class="text-lg font-semibold text-neutral-900 bg-transparent border-0 outline-none focus:bg-neutral-100 px-2 py-1 rounded-lg transition-colors flex-1 min-w-0"/>
        <div class="flex items-center gap-2 ml-auto shrink-0">
          <select id="page-status-select" class="px-3 py-1.5 rounded-lg border border-neutral-200 text-xs font-medium focus:border-primary-400 outline-none bg-white">
            <option value="draft">Draft</option>
            <option value="published">Published</option>
          </select>
          <button id="save-page-btn" class="px-4 py-1.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-lg transition-colors">Save</button>
          <a id="preview-page-btn" href="#" target="_blank"
            class="px-4 py-1.5 border border-neutral-300 text-neutral-600 hover:bg-neutral-50 text-sm font-medium rounded-lg transition-colors">Preview ↗</a>
        </div>
        <div id="editor-save-msg" class="text-xs text-neutral-400 hidden"></div>
      </div>

      <!-- Page meta -->
      <details class="mb-4 bg-white rounded-xl border border-neutral-200 overflow-hidden">
        <summary class="px-4 py-3 text-sm font-medium text-neutral-700 cursor-pointer select-none hover:bg-neutral-50">SEO Settings</summary>
        <div class="px-4 pb-4 space-y-3 border-t border-neutral-100">
          <div><label class="block text-xs text-neutral-500 mb-1 font-medium">URL Slug</label>
            <div class="flex items-center gap-1 text-sm"><span class="text-neutral-400">/p/</span><input id="page-slug-input" type="text" class="flex-1 px-2 py-1 rounded border border-neutral-200 text-sm font-mono focus:border-primary-400 outline-none"/></div>
          </div>
          <div><label class="block text-xs text-neutral-500 mb-1 font-medium">Meta Description</label>
            <textarea id="page-meta-input" rows="2" class="w-full px-2 py-1 rounded border border-neutral-200 text-sm focus:border-primary-400 outline-none resize-none"></textarea>
          </div>
        </div>
      </details>

      <!-- Editor canvas -->
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-4">

        <!-- Block palette (left) -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-xl border border-neutral-200 p-3 sticky top-4">
            <p class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-2.5">Add Block</p>
            <div class="space-y-1" id="block-palette">
              <!-- Populated by JS -->
            </div>
          </div>
        </div>

        <!-- Canvas (center) -->
        <div class="lg:col-span-2">
          <div id="canvas-blocks" class="space-y-2 min-h-[400px]">
            <div id="canvas-empty" class="border-2 border-dashed border-neutral-200 rounded-xl p-12 text-center text-neutral-400 text-sm">
              Click a block type from the left panel to start building your page.
            </div>
          </div>
        </div>

        <!-- Properties panel (right) -->
        <div class="lg:col-span-1">
          <div id="props-panel" class="bg-white rounded-xl border border-neutral-200 p-4 sticky top-4">
            <p class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-3">Block Properties</p>
            <p class="text-xs text-neutral-400 text-center py-4">Select a block to edit its properties.</p>
          </div>
        </div>

      </div>
    </div>

  </div>

  <script>
    import { requireLogin, apiFetch } from '../../../scripts/adminAuth.js';
    requireLogin();

    function esc(s: unknown) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function uid() { return Math.random().toString(36).slice(2); }

    // ── Block type definitions ────────────────────────────────────────────────
    const BLOCK_TYPES = [
      { type: 'hero',    label: '🖼 Hero',      icon: '🖼' },
      { type: 'heading', label: 'H Heading',    icon: 'H' },
      { type: 'text',    label: '¶ Rich Text',  icon: '¶' },
      { type: 'image',   label: '📷 Image',     icon: '📷' },
      { type: 'button',  label: '⬜ Button',    icon: '⬜' },
      { type: 'columns', label: '⊟ 2 Columns',  icon: '⊟' },
      { type: 'divider', label: '— Divider',    icon: '—' },
      { type: 'spacer',  label: '↕ Spacer',     icon: '↕' },
      { type: 'html',    label: '</> HTML',      icon: '</>' },
    ];

    function defaultContent(type: string): any {
      switch (type) {
        case 'hero':    return { heading: 'Welcome to Bliss Dermacare', subheading: 'Professional skin care in Tampa, FL', bg: '', overlay: 0.4, cta_text: 'Book Now', cta_url: '/book/' };
        case 'heading': return { text: 'Section Heading', level: 2, align: 'left' };
        case 'text':    return { html: '<p>Your content goes here.</p>' };
        case 'image':   return { url: '', alt: '', caption: '', align: 'center', width: 100 };
        case 'button':  return { text: 'Click Here', url: '/', style: 'primary', align: 'center' };
        case 'columns': return { gap: 'md', col1: '<p>Column 1 content.</p>', col2: '<p>Column 2 content.</p>' };
        case 'divider': return { style: 'solid', spacing: 'md' };
        case 'spacer':  return { height: 'md' };
        case 'html':    return { code: '<!-- Custom HTML -->' };
        default:        return {};
      }
    }

    // ── State ─────────────────────────────────────────────────────────────────
    let currentPageId: string | null = null;
    let blocks: any[] = [];
    let selectedBlockId: string | null = null;
    let dragSrcId: string | null = null;

    // ── Render block palette ──────────────────────────────────────────────────
    function renderPalette() {
      const el = document.getElementById('block-palette')!;
      el.innerHTML = BLOCK_TYPES.map(bt => `
        <button class="palette-btn w-full text-left px-3 py-2 rounded-lg text-xs font-medium text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900 transition-colors" data-type="${bt.type}">
          ${bt.label}
        </button>`).join('');
      el.querySelectorAll('.palette-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const type = (btn as HTMLElement).dataset.type!;
          blocks.push({ id: uid(), type, content: defaultContent(type) });
          renderCanvas();
          selectedBlockId = blocks[blocks.length - 1].id;
          renderProps();
        });
      });
    }

    // ── Render canvas ─────────────────────────────────────────────────────────
    function renderCanvas() {
      const canvas = document.getElementById('canvas-blocks')!;
      document.getElementById('canvas-empty')?.classList.toggle('hidden', blocks.length > 0);
      // Remove existing block elements (keep empty placeholder)
      canvas.querySelectorAll('.canvas-block').forEach(el => el.remove());

      blocks.forEach((block, idx) => {
        const el = document.createElement('div');
        el.className = `canvas-block border-2 rounded-xl overflow-hidden cursor-pointer transition-colors ${selectedBlockId === block.id ? 'border-primary-400' : 'border-neutral-200 hover:border-neutral-300'}`;
        el.dataset.id = block.id;
        el.setAttribute('draggable', 'true');

        el.innerHTML = `
          <div class="flex items-center justify-between px-3 py-2 bg-neutral-50 border-b border-neutral-100">
            <div class="flex items-center gap-2">
              <span class="text-neutral-400 cursor-grab" title="Drag to reorder">⠿</span>
              <span class="text-xs font-semibold text-neutral-500 uppercase tracking-wide">${block.type}</span>
            </div>
            <div class="flex items-center gap-1">
              <button class="block-up px-1.5 py-0.5 text-neutral-400 hover:text-neutral-700 text-xs" title="Move up" ${idx === 0 ? 'disabled' : ''}>↑</button>
              <button class="block-down px-1.5 py-0.5 text-neutral-400 hover:text-neutral-700 text-xs" title="Move down" ${idx === blocks.length - 1 ? 'disabled' : ''}>↓</button>
              <button class="block-del px-1.5 py-0.5 text-red-400 hover:text-red-600 text-xs ml-1" title="Delete">✕</button>
            </div>
          </div>
          <div class="p-3 pointer-events-none select-none">
            ${blockPreview(block)}
          </div>`;

        // Select
        el.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target.classList.contains('block-up') || target.classList.contains('block-down') || target.classList.contains('block-del')) return;
          selectedBlockId = block.id;
          renderCanvas(); renderProps();
        });

        // Move up/down
        el.querySelector('.block-up')?.addEventListener('click', (e) => { e.stopPropagation(); if (idx > 0) { [blocks[idx-1], blocks[idx]] = [blocks[idx], blocks[idx-1]]; renderCanvas(); } });
        el.querySelector('.block-down')?.addEventListener('click', (e) => { e.stopPropagation(); if (idx < blocks.length-1) { [blocks[idx], blocks[idx+1]] = [blocks[idx+1], blocks[idx]]; renderCanvas(); } });
        el.querySelector('.block-del')?.addEventListener('click', (e) => { e.stopPropagation(); if (confirm('Remove this block?')) { blocks.splice(idx, 1); if (selectedBlockId === block.id) selectedBlockId = null; renderCanvas(); renderProps(); } });

        // Drag-and-drop reorder
        el.addEventListener('dragstart', () => { dragSrcId = block.id; el.classList.add('opacity-50'); });
        el.addEventListener('dragend', () => { el.classList.remove('opacity-50'); });
        el.addEventListener('dragover', (e) => { e.preventDefault(); el.classList.add('ring-2', 'ring-primary-400'); });
        el.addEventListener('dragleave', () => { el.classList.remove('ring-2', 'ring-primary-400'); });
        el.addEventListener('drop', (e) => {
          e.preventDefault(); el.classList.remove('ring-2', 'ring-primary-400');
          if (dragSrcId && dragSrcId !== block.id) {
            const fromIdx = blocks.findIndex(b => b.id === dragSrcId);
            const toIdx   = idx;
            const [moved] = blocks.splice(fromIdx, 1);
            blocks.splice(toIdx, 0, moved);
            renderCanvas();
          }
        });

        canvas.appendChild(el);
      });
    }

    function blockPreview(block: any): string {
      const c = block.content || {};
      switch (block.type) {
        case 'hero':    return `<div class="text-center py-4 bg-neutral-800 text-white rounded text-xs"><strong>${esc(c.heading)}</strong><br/><span class="text-neutral-400">${esc(c.subheading)}</span></div>`;
        case 'heading': return `<${c.level ? 'h'+c.level : 'h2'} class="font-bold text-neutral-900" style="text-align:${c.align||'left'}">${esc(c.text||'Heading')}</${c.level ? 'h'+c.level : 'h2'}>`;
        case 'text':    return `<div class="text-xs text-neutral-600 line-clamp-2">${(c.html||'').replace(/<[^>]+>/g,' ').trim().substring(0,120)||'No content'}</div>`;
        case 'image':   return c.url ? `<img src="${esc(c.url)}" class="max-h-20 mx-auto rounded object-cover" alt=""/>` : `<div class="h-16 bg-neutral-100 rounded flex items-center justify-center text-xs text-neutral-400">No image set</div>`;
        case 'button':  return `<div style="text-align:${c.align||'center'}"><span class="inline-block px-4 py-1.5 bg-primary-600 text-white text-xs rounded-full">${esc(c.text||'Button')}</span></div>`;
        case 'columns': return `<div class="grid grid-cols-2 gap-2 text-xs text-neutral-500"><div class="bg-neutral-50 rounded p-2">Column 1</div><div class="bg-neutral-50 rounded p-2">Column 2</div></div>`;
        case 'divider': return `<hr class="border-neutral-300"/>`;
        case 'spacer':  return `<div class="h-6 bg-neutral-50 rounded flex items-center justify-center text-xs text-neutral-400">Spacer</div>`;
        case 'html':    return `<pre class="text-xs text-neutral-500 bg-neutral-50 rounded p-2 overflow-hidden">${esc((c.code||'').substring(0,80))}…</pre>`;
        default:        return `<div class="text-xs text-neutral-400">Block</div>`;
      }
    }

    // ── Render properties panel ───────────────────────────────────────────────
    function renderProps() {
      const panel = document.getElementById('props-panel')!;
      if (!selectedBlockId) {
        panel.innerHTML = `<p class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-3">Block Properties</p><p class="text-xs text-neutral-400 text-center py-4">Select a block to edit its properties.</p>`;
        return;
      }
      const block = blocks.find(b => b.id === selectedBlockId);
      if (!block) return;
      const c = block.content;

      let html = `<p class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-3">${block.type.toUpperCase()} Properties</p><div class="space-y-3 text-xs">`;
      const inp = (id: string, label: string, val: string, type = 'text') =>
        `<div><label class="block font-medium text-neutral-500 mb-0.5">${label}</label><input id="prop-${id}" type="${type}" value="${esc(val)}" class="w-full px-2 py-1.5 rounded border border-neutral-200 text-sm focus:border-primary-400 outline-none"/></div>`;
      const ta = (id: string, label: string, val: string, rows = 3) =>
        `<div><label class="block font-medium text-neutral-500 mb-0.5">${label}</label><textarea id="prop-${id}" rows="${rows}" class="w-full px-2 py-1.5 rounded border border-neutral-200 text-sm focus:border-primary-400 outline-none resize-y">${esc(val)}</textarea></div>`;
      const sel = (id: string, label: string, val: string, opts: [string,string][]) =>
        `<div><label class="block font-medium text-neutral-500 mb-0.5">${label}</label><select id="prop-${id}" class="w-full px-2 py-1.5 rounded border border-neutral-200 text-sm focus:border-primary-400 outline-none bg-white">${opts.map(([v,l]) => `<option value="${v}" ${val===v?'selected':''}>${l}</option>`).join('')}</select></div>`;
      const richta = (id: string, label: string, val: string) =>
        `<div><label class="block font-medium text-neutral-500 mb-0.5">${label}</label>
          <div class="flex gap-0.5 mb-0.5 p-1 bg-neutral-50 rounded border border-b-0 border-neutral-200">
            <button type="button" onclick="document.execCommand('bold')" class="px-1.5 py-0.5 text-xs font-bold hover:bg-neutral-200 rounded">B</button>
            <button type="button" onclick="document.execCommand('italic')" class="px-1.5 py-0.5 text-xs italic hover:bg-neutral-200 rounded">I</button>
            <button type="button" onclick="document.execCommand('createLink',false,prompt('URL:')||'')" class="px-1.5 py-0.5 text-xs hover:bg-neutral-200 rounded">🔗</button>
          </div>
          <div id="prop-${id}" contenteditable="true" class="min-h-[80px] px-2 py-1.5 rounded-b border border-neutral-200 text-sm focus:border-primary-400 outline-none">${val}</div>
        </div>`;

      switch (block.type) {
        case 'hero':
          html += inp('heading', 'Heading', c.heading||'')
            + inp('subheading', 'Subheading', c.subheading||'')
            + inp('bg', 'Background Image URL', c.bg||'')
            + inp('overlay', 'Overlay Opacity (0–1)', String(c.overlay||0.4), 'number')
            + inp('cta_text', 'CTA Button Text', c.cta_text||'')
            + inp('cta_url', 'CTA Button URL', c.cta_url||'/');
          break;
        case 'heading':
          html += inp('text', 'Text', c.text||'')
            + sel('level', 'Level', String(c.level||2), [['1','H1'],['2','H2'],['3','H3'],['4','H4']])
            + sel('align', 'Alignment', c.align||'left', [['left','Left'],['center','Center'],['right','Right']]);
          break;
        case 'text':
          html += richta('html', 'Content', c.html||'');
          break;
        case 'image':
          html += inp('url', 'Image URL', c.url||'')
            + inp('alt', 'Alt Text', c.alt||'')
            + inp('caption', 'Caption', c.caption||'')
            + sel('align', 'Alignment', c.align||'center', [['left','Left'],['center','Center'],['right','Right'],['full','Full Width']])
            + sel('width', 'Width %', String(c.width||100), [['25','25%'],['50','50%'],['75','75%'],['100','100%']]);
          break;
        case 'button':
          html += inp('text', 'Button Text', c.text||'')
            + inp('url', 'URL', c.url||'/')
            + sel('style', 'Style', c.style||'primary', [['primary','Primary'],['secondary','Secondary'],['outline','Outline']])
            + sel('align', 'Alignment', c.align||'center', [['left','Left'],['center','Center'],['right','Right']]);
          break;
        case 'columns':
          html += richta('col1', 'Column 1 Content', c.col1||'')
            + richta('col2', 'Column 2 Content', c.col2||'')
            + sel('gap', 'Gap Size', c.gap||'md', [['sm','Small'],['md','Medium'],['lg','Large']]);
          break;
        case 'divider':
          html += sel('style', 'Line Style', c.style||'solid', [['solid','Solid'],['dashed','Dashed'],['dotted','Dotted']])
            + sel('spacing', 'Vertical Spacing', c.spacing||'md', [['sm','Small'],['md','Medium'],['lg','Large']]);
          break;
        case 'spacer':
          html += sel('height', 'Height', c.height||'md', [['sm','Small (16px)'],['md','Medium (32px)'],['lg','Large (64px)'],['xl','XL (96px)']]);
          break;
        case 'html':
          html += ta('code', 'HTML Code', c.code||'', 8);
          break;
      }

      html += `</div><button id="apply-props-btn" class="w-full mt-4 py-2 bg-neutral-900 hover:bg-neutral-700 text-white text-xs font-semibold rounded-lg transition-colors">Apply Changes</button>`;
      panel.innerHTML = html;

      // Apply changes button
      document.getElementById('apply-props-btn')?.addEventListener('click', () => {
        const b = blocks.find(x => x.id === selectedBlockId);
        if (!b) return;
        const get = (id: string) => {
          const el = document.getElementById(`prop-${id}`);
          if (!el) return undefined;
          if ((el as HTMLInputElement).type === 'number') return parseFloat((el as HTMLInputElement).value);
          if (el.tagName === 'SELECT') return (el as HTMLSelectElement).value;
          if (el.getAttribute('contenteditable')) return el.innerHTML;
          return (el as HTMLInputElement).value;
        };
        switch (b.type) {
          case 'hero':    Object.assign(b.content, { heading: get('heading'), subheading: get('subheading'), bg: get('bg'), overlay: get('overlay'), cta_text: get('cta_text'), cta_url: get('cta_url') }); break;
          case 'heading': Object.assign(b.content, { text: get('text'), level: parseInt(String(get('level')||2)), align: get('align') }); break;
          case 'text':    Object.assign(b.content, { html: get('html') }); break;
          case 'image':   Object.assign(b.content, { url: get('url'), alt: get('alt'), caption: get('caption'), align: get('align'), width: parseInt(String(get('width')||100)) }); break;
          case 'button':  Object.assign(b.content, { text: get('text'), url: get('url'), style: get('style'), align: get('align') }); break;
          case 'columns': Object.assign(b.content, { col1: get('col1'), col2: get('col2'), gap: get('gap') }); break;
          case 'divider': Object.assign(b.content, { style: get('style'), spacing: get('spacing') }); break;
          case 'spacer':  Object.assign(b.content, { height: get('height') }); break;
          case 'html':    Object.assign(b.content, { code: get('code') }); break;
        }
        renderCanvas();
      });
    }

    // ── Load pages list ───────────────────────────────────────────────────────
    async function loadPages() {
      try {
        const data = await apiFetch('admin-pages', {});
        const pages = data?.pages || [];
        const tbl = document.getElementById('pages-table')!;
        if (!pages.length) {
          tbl.innerHTML = '<div class="px-6 py-12 text-center text-neutral-400 text-sm">No pages yet. Click "New Page" to create one.</div>';
          return;
        }
        tbl.innerHTML = `<table class="min-w-full text-sm"><thead><tr class="border-b border-neutral-100 text-xs font-semibold text-neutral-500 uppercase tracking-wide">
          <th class="px-5 py-3 text-left">Title</th>
          <th class="px-5 py-3 text-left hidden md:table-cell">Slug</th>
          <th class="px-5 py-3 text-center">Status</th>
          <th class="px-5 py-3 text-left hidden lg:table-cell">Updated</th>
          <th class="px-5 py-3 text-right">Actions</th>
        </tr></thead><tbody class="divide-y divide-neutral-50">${pages.map((p: any) => `
          <tr class="hover:bg-neutral-50 transition-colors">
            <td class="px-5 py-3.5 font-medium text-neutral-900">${esc(p.title)}</td>
            <td class="px-5 py-3.5 hidden md:table-cell"><code class="text-xs bg-neutral-100 px-1.5 py-0.5 rounded">/p/${esc(p.slug)}</code></td>
            <td class="px-5 py-3.5 text-center">
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold ${p.status==='published'?'bg-emerald-100 text-emerald-700':'bg-neutral-100 text-neutral-600'}">${p.status}</span>
            </td>
            <td class="px-5 py-3.5 hidden lg:table-cell text-xs text-neutral-400">${new Date(p.updated_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</td>
            <td class="px-5 py-3.5 text-right flex items-center gap-2 justify-end">
              <button class="edit-page-btn text-xs text-primary-600 hover:text-primary-700 font-medium" data-id="${esc(p.id)}">Edit</button>
              <a href="/p/${esc(p.slug)}" target="_blank" class="text-xs text-neutral-400 hover:text-neutral-600">Preview ↗</a>
              <button class="del-page-btn text-xs text-red-400 hover:text-red-600 font-medium" data-id="${esc(p.id)}">Delete</button>
            </td>
          </tr>`).join('')}</tbody></table>`;
        tbl.querySelectorAll('.edit-page-btn').forEach(btn => {
          btn.addEventListener('click', () => loadPageEditor((btn as HTMLElement).dataset.id!));
        });
        tbl.querySelectorAll('.del-page-btn').forEach(btn => {
          btn.addEventListener('click', async () => {
            if (!confirm('Delete this page permanently?')) return;
            await apiFetch('admin-pages', { method: 'DELETE', body: { id: (btn as HTMLElement).dataset.id } });
            loadPages();
          });
        });
      } catch (err: any) {
        document.getElementById('pages-table')!.innerHTML = `<div class="px-6 py-6 text-red-500 text-sm">${err.message}</div>`;
      }
    }

    async function loadPageEditor(id: string) {
      const page = await apiFetch('admin-pages', { params: { id } });
      currentPageId = page.id;
      blocks = page.blocks || [];
      selectedBlockId = null;
      (document.getElementById('page-title-input') as HTMLInputElement).value = page.title || '';
      (document.getElementById('page-slug-input') as HTMLInputElement).value = page.slug || '';
      (document.getElementById('page-meta-input') as HTMLTextAreaElement).value = page.meta_description || '';
      (document.getElementById('page-status-select') as HTMLSelectElement).value = page.status || 'draft';
      (document.getElementById('preview-page-btn') as HTMLAnchorElement).href = `/p/${page.slug}`;
      document.getElementById('page-list-view')?.classList.add('hidden');
      document.getElementById('page-editor-view')?.classList.remove('hidden');
      renderPalette(); renderCanvas(); renderProps();
    }

    async function createNewPage() {
      const title = prompt('Page title:');
      if (!title) return;
      const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      const page = await apiFetch('admin-pages', { method: 'POST', body: { title, slug, status: 'draft' } });
      loadPageEditor(page.id);
    }

    // ── Save page ─────────────────────────────────────────────────────────────
    document.getElementById('save-page-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('save-page-btn') as HTMLButtonElement;
      const msg = document.getElementById('editor-save-msg')!;
      btn.disabled = true; btn.textContent = 'Saving…';
      msg.classList.add('hidden');
      try {
        const title  = (document.getElementById('page-title-input') as HTMLInputElement).value.trim();
        const slug   = (document.getElementById('page-slug-input') as HTMLInputElement).value.trim();
        const meta   = (document.getElementById('page-meta-input') as HTMLTextAreaElement).value.trim();
        const status = (document.getElementById('page-status-select') as HTMLSelectElement).value;
        const page = await apiFetch('admin-pages', { method: 'PATCH', body: { id: currentPageId, title, slug, meta_description: meta, blocks, status } });
        (document.getElementById('preview-page-btn') as HTMLAnchorElement).href = `/p/${page.slug}`;
        msg.textContent = '✓ Saved'; msg.className = 'text-xs text-emerald-600'; msg.classList.remove('hidden');
        setTimeout(() => msg.classList.add('hidden'), 2000);
      } catch (e: any) {
        msg.textContent = `Error: ${e.message}`; msg.className = 'text-xs text-red-500'; msg.classList.remove('hidden');
      } finally { btn.disabled = false; btn.textContent = 'Save'; }
    });

    document.getElementById('back-to-list')?.addEventListener('click', () => {
      document.getElementById('page-editor-view')?.classList.add('hidden');
      document.getElementById('page-list-view')?.classList.remove('hidden');
      loadPages();
    });

    document.getElementById('new-page-btn')?.addEventListener('click', createNewPage);

    renderPalette();
    loadPages();
  </script>
</AdminLayout>
