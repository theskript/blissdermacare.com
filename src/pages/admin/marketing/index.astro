---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Marketing" activeNav="marketing">
<div class="p-6 lg:p-8">

  <!-- Header -->
  <div class="mb-6 flex items-start justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-2xl font-serif font-semibold text-neutral-900">Marketing</h1>
      <p class="text-sm text-neutral-500 mt-0.5">Email and SMS campaigns for your client list.</p>
    </div>
    <button id="compose-btn" class="inline-flex items-center gap-2 px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-xl transition-colors shadow-sm shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      New Campaign
    </button>
  </div>

  <!-- Stats -->
  <div id="mkt-stats" class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-5"></div>

  <!-- Tabs -->
  <div class="flex gap-1 mb-4 border-b border-neutral-200">
    <button class="mkt-tab active-mtab px-4 py-2 text-sm font-semibold border-b-2 border-primary-600 text-primary-700 -mb-px" data-tab="campaigns">Campaigns</button>
    <button class="mkt-tab px-4 py-2 text-sm font-medium text-neutral-500 hover:text-neutral-800 border-b-2 border-transparent -mb-px" data-tab="templates">Templates</button>
    <button class="mkt-tab px-4 py-2 text-sm font-medium text-neutral-500 hover:text-neutral-800 border-b-2 border-transparent -mb-px" data-tab="audiences">Audiences</button>
    <button class="mkt-tab px-4 py-2 text-sm font-medium text-neutral-500 hover:text-neutral-800 border-b-2 border-transparent -mb-px" data-tab="unsubs">Unsubscribes</button>
  </div>

  <div id="tab-campaigns"><div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden"><div id="campaigns-list" class="overflow-x-auto"><div class="px-6 py-10 text-center text-neutral-400 text-sm">Loading…</div></div></div></div>
  <div id="tab-templates" class="hidden"><div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden"><div class="flex items-center justify-between px-5 py-3.5 border-b border-neutral-100"><h2 class="font-semibold text-neutral-900 text-sm">Email Templates</h2><button id="save-as-template-btn" class="text-xs text-primary-600 hover:text-primary-700 font-medium hidden">Save current draft as template</button></div><div id="templates-list"><div class="px-6 py-10 text-center text-neutral-400 text-sm">Loading…</div></div></div></div>
  <div id="tab-audiences" class="hidden"><div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden"><div class="flex items-center justify-between px-5 py-3.5 border-b border-neutral-100"><h2 class="font-semibold text-neutral-900 text-sm">Saved Audiences</h2><button id="add-audience-btn" class="text-xs text-primary-600 hover:text-primary-700 font-medium">+ New Audience</button></div><div id="audiences-list"><div class="px-6 py-10 text-center text-neutral-400 text-sm">Loading…</div></div></div></div>
  <div id="tab-unsubs" class="hidden">
    <div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden">
      <div class="flex items-center justify-between px-5 py-3.5 border-b border-neutral-100 gap-3 flex-wrap">
        <h2 class="font-semibold text-neutral-900 text-sm">Unsubscribes</h2>
        <div class="flex items-center gap-2">
          <input id="unsub-search" type="text" placeholder="Search by email…" class="px-3 py-1.5 rounded-lg border border-neutral-200 text-xs focus:border-primary-400 outline-none w-48"/>
          <button id="add-unsub-btn" class="text-xs text-primary-600 hover:text-primary-700 font-medium whitespace-nowrap">+ Add / Re-subscribe</button>
        </div>
      </div>
      <div id="unsubs-list"><div class="px-6 py-10 text-center text-neutral-400 text-sm">Loading…</div></div>
    </div>
  </div>
</div>

<!-- ── Compose panel (full-width, two-column) ───────────────────────────────── -->
<div id="compose-overlay" class="hidden fixed inset-0 bg-black/40 z-40"></div>
<div id="compose-panel" class="hidden fixed inset-4 lg:inset-8 bg-white rounded-2xl shadow-2xl z-50 flex flex-col overflow-hidden">

  <!-- Panel header -->
  <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-100 shrink-0">
    <h3 class="font-semibold text-neutral-900">New Campaign</h3>
    <div class="flex items-center gap-2">
      <span id="autosave-indicator" class="text-xs text-neutral-400 hidden">Auto-saved</span>
      <button id="compose-close" class="p-1.5 rounded-lg text-neutral-400 hover:bg-neutral-100 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <!-- Two-column layout: form (left) + preview (right) -->
  <div class="flex flex-1 overflow-hidden">

    <!-- Left: form -->
    <div class="w-full lg:w-1/2 overflow-y-auto p-6 space-y-4 border-r border-neutral-100">

      <!-- Campaign name -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Campaign Name *</label>
        <input id="c-name" type="text" placeholder="e.g. Summer Promo 2026"
          class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/>
      </div>

      <!-- Channels -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1.5">Channels</label>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 cursor-pointer select-none text-sm"><input type="checkbox" id="ch-email" checked class="w-4 h-4 rounded border-neutral-300 accent-primary-600"/> Email</label>
          <label class="flex items-center gap-2 cursor-pointer select-none text-sm"><input type="checkbox" id="ch-sms" class="w-4 h-4 rounded border-neutral-300 accent-primary-600"/> SMS</label>
        </div>
      </div>

      <!-- Recipients -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1.5">Recipients</label>
        <div class="flex gap-3 mb-2">
          <label class="flex items-center gap-1.5 text-sm cursor-pointer"><input type="radio" name="recip-mode" value="segment" checked class="accent-primary-600"/> Audience Segment</label>
          <label class="flex items-center gap-1.5 text-sm cursor-pointer"><input type="radio" name="recip-mode" value="custom" class="accent-primary-600"/> Specific Clients</label>
        </div>
        <div id="segment-picker">
          <select id="c-segment" class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 outline-none bg-white">
            <option value="all">All Clients</option>
            <option value="recent_30">Recent — Last 30 Days</option>
            <option value="recent_60">Recent — Last 60 Days</option>
            <option value="lapsed_90">Lapsed — 90+ Days</option>
            <option value="members">Active Members</option>
            <option value="new_clients">New Clients (1 visit)</option>
          </select>
          <div id="segment-preview" class="mt-1 text-xs text-neutral-400">Estimating audience…</div>
        </div>
        <div id="custom-picker" class="hidden">
          <div class="relative">
            <input id="client-search-input" type="text" placeholder="Search by name, email, or phone…"
              class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 outline-none"/>
            <div id="client-search-results" class="hidden absolute top-full left-0 right-0 bg-white border border-neutral-200 rounded-lg shadow-lg z-10 max-h-48 overflow-y-auto mt-1"></div>
          </div>
          <div id="selected-recipients" class="mt-2 flex flex-wrap gap-1.5 min-h-[28px]"></div>
          <div id="custom-count" class="text-xs text-neutral-400 mt-1">0 recipients selected</div>
        </div>
      </div>

      <!-- Email subject -->
      <div id="email-subject-row">
        <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Email Subject *</label>
        <input id="c-subject" type="text" placeholder="Your exclusive offer from Bliss Dermacare"
          class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/>
      </div>

      <!-- Email body -->
      <div id="email-body-row">
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Email Body</label>
          <button id="load-template-btn" class="text-xs text-violet-600 hover:text-violet-700 font-medium">📂 Load Template</button>
        </div>
        <div class="flex gap-0.5 p-1.5 bg-neutral-50 rounded-t-lg border border-b-0 border-neutral-200">
          <button type="button" data-cmd="bold"       class="fmt-btn px-2 py-0.5 text-xs font-bold rounded hover:bg-neutral-200">B</button>
          <button type="button" data-cmd="italic"     class="fmt-btn px-2 py-0.5 text-xs italic rounded hover:bg-neutral-200">I</button>
          <button type="button" data-cmd="underline"  class="fmt-btn px-2 py-0.5 text-xs underline rounded hover:bg-neutral-200">U</button>
          <span class="w-px bg-neutral-300 mx-0.5"></span>
          <button type="button" id="insert-link-btn"  class="px-2 py-0.5 text-xs rounded hover:bg-neutral-200">🔗 Link</button>
          <button type="button" data-cmd="formatBlock" data-val="h2" class="fmt-btn px-2 py-0.5 text-xs font-semibold rounded hover:bg-neutral-200">H2</button>
          <button type="button" data-cmd="insertUnorderedList" class="fmt-btn px-2 py-0.5 text-xs rounded hover:bg-neutral-200">• List</button>
          <button type="button" id="insert-cta-btn"   class="px-2 py-0.5 text-xs rounded hover:bg-neutral-200 ml-auto">+ CTA Button</button>
        </div>
        <div id="c-body-html" contenteditable="true"
          class="min-h-[200px] px-3 py-2.5 rounded-b-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"
          style="line-height:1.7"></div>
        <p class="text-xs text-neutral-400 mt-1">Unsubscribe footer added automatically.</p>
      </div>

      <!-- SMS body -->
      <div id="sms-body-row" class="hidden">
        <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">SMS Message</label>
        <textarea id="c-body-sms" rows="3" maxlength="160"
          class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none resize-none"></textarea>
        <div class="flex justify-between mt-1">
          <p class="text-xs text-neutral-400">"Reply STOP to unsubscribe" added automatically.</p>
          <span id="sms-counter" class="text-xs text-neutral-400">0/160</span>
        </div>
      </div>

      <!-- Schedule / Send timing -->
      <div class="border-t border-neutral-100 pt-4">
        <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-2">Send Timing</label>
        <div class="space-y-2">
          <label class="flex items-center gap-2 text-sm cursor-pointer"><input type="radio" name="send-timing" value="now" checked class="accent-primary-600"/> Send immediately</label>
          <label class="flex items-center gap-2 text-sm cursor-pointer"><input type="radio" name="send-timing" value="schedule" class="accent-primary-600"/> Schedule for later</label>
        </div>
        <div id="schedule-picker" class="hidden mt-2 flex gap-2">
          <input type="date" id="c-sched-date" class="flex-1 px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 outline-none"/>
          <input type="time" id="c-sched-time" class="px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 outline-none"/>
        </div>
        <p id="schedule-label" class="text-xs text-neutral-400 mt-1 hidden"></p>
      </div>

      <!-- Action buttons -->
      <div class="flex gap-2 pt-2 border-t border-neutral-100 flex-wrap">
        <button id="test-send-btn"
          class="flex items-center gap-1.5 px-4 py-2 border border-neutral-300 text-neutral-600 hover:bg-neutral-50 text-sm font-medium rounded-xl transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          Test Send
        </button>
        <button id="save-draft-btn"
          class="px-4 py-2 border border-neutral-300 text-neutral-600 hover:bg-neutral-50 text-sm font-medium rounded-xl transition-colors">
          Save Draft
        </button>
        <button id="send-campaign-btn"
          class="flex-1 py-2 bg-primary-600 hover:bg-primary-700 disabled:opacity-50 text-white text-sm font-semibold rounded-xl transition-colors">
          Send Now
        </button>
      </div>
      <div id="send-msg" class="text-xs text-center hidden"></div>
    </div>

    <!-- Right: live preview -->
    <div class="hidden lg:flex flex-col w-1/2 bg-neutral-50">
      <div class="flex items-center justify-between px-4 py-2.5 border-b border-neutral-200 shrink-0">
        <span class="text-xs font-semibold text-neutral-500 uppercase tracking-wide">Preview</span>
        <div class="flex gap-1">
          <button id="preview-desktop" class="preview-mode-btn px-2.5 py-1 text-xs rounded-lg bg-neutral-200 text-neutral-700 font-medium">Desktop</button>
          <button id="preview-mobile"  class="preview-mode-btn px-2.5 py-1 text-xs rounded-lg text-neutral-400 font-medium hover:bg-neutral-200">Mobile</button>
        </div>
      </div>
      <div class="flex-1 overflow-y-auto p-4 flex justify-center">
        <div id="preview-wrap" class="w-full max-w-2xl transition-all duration-200">
          <div class="bg-white rounded-xl border border-neutral-200 overflow-hidden shadow-sm">
            <div class="bg-neutral-800 px-4 py-2.5 text-xs text-neutral-400 flex items-center gap-2">
              <span class="font-medium text-white">From:</span> Bliss Dermacare &lt;noreply@blissdermacare.com&gt;
            </div>
            <div class="bg-neutral-700 px-4 py-2 text-xs text-neutral-300">
              <span class="font-medium text-white">Subject:</span> <span id="preview-subject">—</span>
            </div>
            <div id="preview-body" class="p-6 text-sm text-neutral-700" style="line-height:1.75;min-height:200px">
              <p class="text-neutral-400 text-center py-8">Start typing your email to see a preview here.</p>
            </div>
            <div class="px-6 py-4 border-t border-neutral-100 text-center" style="font-size:11px;color:#9ca3af">
              You are receiving this because you've booked with Bliss Dermacare.<br/>
              8905 Regents Park Dr, Tampa, FL 33647 · (609) 366-0857<br/>
              <a href="#" style="color:#9ca3af;text-decoration:underline;">Unsubscribe</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Template picker modal -->
<div id="template-modal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/50" id="template-modal-overlay"></div>
  <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[80vh] flex flex-col z-10">
    <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-100 shrink-0">
      <h3 class="font-semibold text-neutral-900">Load Template</h3>
      <button id="template-modal-close" class="p-1.5 rounded-lg text-neutral-400 hover:bg-neutral-100">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div id="template-picker-list" class="overflow-y-auto p-4 space-y-2 flex-1"></div>
  </div>
</div>

<script>
import { requireLogin, apiFetch } from '../../../scripts/adminAuth.js';
requireLogin();

function esc(s: unknown) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

// ── State ─────────────────────────────────────────────────────────────────────
let customRecipients: any[] = [];
let templates: any[] = [];
let audiences: any[] = [];

// ── Tab switching ─────────────────────────────────────────────────────────────
document.querySelectorAll('.mkt-tab').forEach(btn => {
  btn.addEventListener('click', () => {
    const tab = (btn as HTMLElement).dataset.tab!;
    document.querySelectorAll('.mkt-tab').forEach(b => {
      const active = (b as HTMLElement).dataset.tab === tab;
      b.classList.toggle('active-mtab', active);
      b.classList.toggle('border-primary-600', active);
      b.classList.toggle('text-primary-700', active);
      b.classList.toggle('font-semibold', active);
      b.classList.toggle('text-neutral-500', !active);
      b.classList.toggle('border-transparent', !active);
      b.classList.toggle('font-medium', !active);
    });
    ['campaigns','templates','audiences','unsubs'].forEach(t =>
      document.getElementById(`tab-${t}`)?.classList.toggle('hidden', t !== tab)
    );
    if (tab === 'templates') loadTemplates();
    if (tab === 'audiences') loadAudiences();
    if (tab === 'unsubs') loadUnsubs();
  });
});

// ── Compose panel ─────────────────────────────────────────────────────────────
function openCompose() {
  (document.getElementById('c-name')  as HTMLInputElement).value = '';
  (document.getElementById('c-subject') as HTMLInputElement).value = '';
  (document.getElementById('c-body-html') as HTMLElement).innerHTML = '';
  (document.getElementById('c-body-sms') as HTMLTextAreaElement).value = '';
  customRecipients = [];
  renderCustomRecipients();
  document.getElementById('send-msg')!.className = 'text-xs text-center hidden';
  document.getElementById('compose-panel')?.classList.remove('hidden');
  document.getElementById('compose-overlay')?.classList.remove('hidden');
  previewUpdate();
  previewSegment();
}
function closeCompose() {
  document.getElementById('compose-panel')?.classList.add('hidden');
  document.getElementById('compose-overlay')?.classList.add('hidden');
}
document.getElementById('compose-btn')?.addEventListener('click', openCompose);
document.getElementById('compose-close')?.addEventListener('click', closeCompose);
document.getElementById('compose-overlay')?.addEventListener('click', closeCompose);

// ── Channel toggles ───────────────────────────────────────────────────────────
document.getElementById('ch-email')?.addEventListener('change', () => {
  const on = (document.getElementById('ch-email') as HTMLInputElement).checked;
  document.getElementById('email-subject-row')?.classList.toggle('hidden', !on);
  document.getElementById('email-body-row')?.classList.toggle('hidden', !on);
});
document.getElementById('ch-sms')?.addEventListener('change', () => {
  document.getElementById('sms-body-row')?.classList.toggle('hidden',
    !(document.getElementById('ch-sms') as HTMLInputElement).checked);
});
document.getElementById('c-body-sms')?.addEventListener('input', (e) => {
  const len = (e.target as HTMLTextAreaElement).value.length;
  const el  = document.getElementById('sms-counter')!;
  el.textContent = `${len}/160`;
  el.className = `text-xs ${len > 140 ? 'text-amber-600' : 'text-neutral-400'}`;
});

// ── Recipient mode ────────────────────────────────────────────────────────────
document.querySelectorAll('input[name="recip-mode"]').forEach(r => {
  r.addEventListener('change', () => {
    const mode = (document.querySelector('input[name="recip-mode"]:checked') as HTMLInputElement).value;
    document.getElementById('segment-picker')?.classList.toggle('hidden', mode === 'custom');
    document.getElementById('custom-picker')?.classList.toggle('hidden', mode !== 'custom');
    updateSendButton();
  });
});

// ── Segment preview ───────────────────────────────────────────────────────────
let segTimer: ReturnType<typeof setTimeout>;
async function previewSegment() {
  const seg = (document.getElementById('c-segment') as HTMLSelectElement).value;
  const el  = document.getElementById('segment-preview')!;
  el.textContent = 'Estimating…';
  try {
    const d = await apiFetch('admin-marketing', { params: { recipients: 'true', segment: seg } });
    el.textContent = `~${d.count} recipient${d.count !== 1 ? 's' : ''}${d.preview?.length ? ': ' + d.preview.slice(0,3).map((p:any) => p.name || p.email).join(', ') + (d.count > 3 ? '…' : '') : ''}`;
  } catch { el.textContent = 'Could not estimate'; }
}
document.getElementById('c-segment')?.addEventListener('change', () => {
  clearTimeout(segTimer); segTimer = setTimeout(previewSegment, 400);
});

// ── Client search for custom picker ──────────────────────────────────────────
let searchTimer: ReturnType<typeof setTimeout>;
const searchInput = document.getElementById('client-search-input') as HTMLInputElement;
const searchResults = document.getElementById('client-search-results')!;

searchInput?.addEventListener('input', () => {
  clearTimeout(searchTimer);
  const q = searchInput.value.trim();
  if (!q) { searchResults.classList.add('hidden'); return; }
  searchTimer = setTimeout(async () => {
    try {
      const d = await apiFetch('admin-marketing', { params: { clientSearch: q } });
      const clients = d.clients || [];
      if (!clients.length) { searchResults.innerHTML = '<div class="px-3 py-2 text-xs text-neutral-400">No clients found.</div>'; }
      else {
        searchResults.innerHTML = clients.map((c: any) => `
          <div class="px-3 py-2 text-sm hover:bg-neutral-50 cursor-pointer flex items-center gap-2 client-result" data-email="${esc(c.client_email)}" data-name="${esc(c.client_name)}" data-phone="${esc(c.client_phone||'')}">
            <div class="w-6 h-6 rounded-full bg-primary-100 flex items-center justify-center text-[10px] font-bold text-primary-600 shrink-0">${(c.client_name||'?')[0].toUpperCase()}</div>
            <div><div class="font-medium text-neutral-900">${esc(c.client_name||'—')}</div><div class="text-xs text-neutral-400">${esc(c.client_email)}</div></div>
          </div>`).join('');
        searchResults.querySelectorAll('.client-result').forEach(el => {
          el.addEventListener('click', () => {
            const e = (el as HTMLElement).dataset.email!;
            if (!customRecipients.find(r => r.email === e)) {
              customRecipients.push({ name: (el as HTMLElement).dataset.name, email: e, phone: (el as HTMLElement).dataset.phone });
              renderCustomRecipients();
            }
            searchInput.value = ''; searchResults.classList.add('hidden');
          });
        });
      }
      searchResults.classList.remove('hidden');
    } catch {}
  }, 300);
});
document.addEventListener('click', (e) => { if (!searchInput.contains(e.target as Node) && !searchResults.contains(e.target as Node)) searchResults.classList.add('hidden'); });

function renderCustomRecipients() {
  const el    = document.getElementById('selected-recipients')!;
  const count = document.getElementById('custom-count')!;
  el.innerHTML = customRecipients.map((r, i) => `
    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs bg-primary-100 text-primary-700 font-medium">
      ${esc(r.name || r.email)}
      <button class="hover:text-primary-900 ml-0.5" data-idx="${i}" onclick="removeRecipient(${i})">×</button>
    </span>`).join('');
  count.textContent = `${customRecipients.length} recipient${customRecipients.length !== 1 ? 's' : ''} selected`;
  updateSendButton();
}
(window as any).removeRecipient = (i: number) => { customRecipients.splice(i, 1); renderCustomRecipients(); };

function updateSendButton() {
  const mode = (document.querySelector('input[name="recip-mode"]:checked') as HTMLInputElement)?.value;
  const btn  = document.getElementById('send-campaign-btn') as HTMLButtonElement;
  if (!btn) return;
  const disabled = mode === 'custom' && customRecipients.length === 0;
  btn.disabled = disabled;
  btn.title    = disabled ? 'Add at least one recipient' : '';
}

// ── Schedule picker ───────────────────────────────────────────────────────────
document.querySelectorAll('input[name="send-timing"]').forEach(r => {
  r.addEventListener('change', () => {
    const sched = (document.querySelector('input[name="send-timing"]:checked') as HTMLInputElement).value === 'schedule';
    document.getElementById('schedule-picker')?.classList.toggle('hidden', !sched);
    const btn = document.getElementById('send-campaign-btn')!;
    btn.textContent = sched ? 'Schedule Campaign' : 'Send Now';
    updateScheduleLabel();
  });
});
['c-sched-date','c-sched-time'].forEach(id => document.getElementById(id)?.addEventListener('change', updateScheduleLabel));
function updateScheduleLabel() {
  const lbl   = document.getElementById('schedule-label')!;
  const date  = (document.getElementById('c-sched-date') as HTMLInputElement).value;
  const time  = (document.getElementById('c-sched-time') as HTMLInputElement).value;
  if (!date || !time) { lbl.classList.add('hidden'); return; }
  const dt = new Date(`${date}T${time}`);
  const diff = Math.round((dt.getTime() - Date.now()) / 60000);
  lbl.textContent = diff > 0 ? `Sends in ~${diff < 60 ? diff + ' min' : Math.round(diff/60) + 'h ' + (diff%60) + 'min'}` : 'Date is in the past!';
  lbl.className = diff > 0 ? 'text-xs text-neutral-400 mt-1' : 'text-xs text-red-500 mt-1';
  lbl.classList.remove('hidden');
}

