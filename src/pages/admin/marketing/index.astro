  } catch (e: any) {
    msg.textContent = `Error: ${e.message}`; msg.className = 'text-xs text-center text-red-500'; msg.classList.remove('hidden');
  } finally { btn.disabled = false; btn.textContent = 'Test Send'; }
});

// ── Submit campaign ───────────────────────────────────────────────────────────
async function submitCampaign(action: string) {
  const name     = (document.getElementById('c-name')     as HTMLInputElement).value.trim();
  const subject  = (document.getElementById('c-subject')  as HTMLInputElement).value.trim();
  const bodyHtml = (document.getElementById('c-body-html') as HTMLElement).innerHTML.trim();
  const bodySms  = (document.getElementById('c-body-sms') as HTMLTextAreaElement).value.trim();
  const emailOn  = (document.getElementById('ch-email')   as HTMLInputElement).checked;
  const smsOn    = (document.getElementById('ch-sms')     as HTMLInputElement).checked;
  const mode     = (document.querySelector('input[name="recip-mode"]:checked') as HTMLInputElement).value;
  const segment  = (document.getElementById('c-segment')  as HTMLSelectElement).value;
  const timing   = (document.querySelector('input[name="send-timing"]:checked') as HTMLInputElement).value;
  const schedDate= (document.getElementById('c-sched-date') as HTMLInputElement).value;
  const schedTime= (document.getElementById('c-sched-time') as HTMLInputElement).value;
  const msgEl    = document.getElementById('send-msg')!;

  if (!name) { msgEl.textContent = 'Campaign name is required.'; msgEl.className = 'text-xs text-center text-red-500'; msgEl.classList.remove('hidden'); return; }
  if (action === 'send' || action === 'schedule') {
    if (emailOn && !bodyHtml) { msgEl.textContent = 'Email body is required.'; msgEl.className = 'text-xs text-center text-red-500'; msgEl.classList.remove('hidden'); return; }
    if (timing === 'schedule' && (!schedDate || !schedTime)) { msgEl.textContent = 'Please set a schedule date and time.'; msgEl.className = 'text-xs text-center text-red-500'; msgEl.classList.remove('hidden'); return; }
  }

  const actualAction = timing === 'schedule' && action === 'send' ? 'schedule' : action;
  const btn = document.getElementById(action === 'send' ? 'send-campaign-btn' : 'save-draft-btn') as HTMLButtonElement;
  btn.disabled = true; btn.textContent = action === 'send' ? (actualAction === 'schedule' ? 'Scheduling…' : 'Sending…') : 'Saving…';
  if (actualAction === 'send') { msgEl.textContent = 'Sending — please wait…'; msgEl.className = 'text-xs text-center text-neutral-400'; msgEl.classList.remove('hidden'); }

  try {
    const result = await apiFetch('admin-marketing', { method: 'POST', body: {
      name, subject, body_html: bodyHtml, body_sms: bodySms,
      channels: [...(emailOn ? ['email'] : []), ...(smsOn ? ['sms'] : [])],
      segment_type: mode === 'custom' ? 'custom' : segment,
      segment_label: mode === 'custom' ? `${customRecipients.length} specific clients` : segment,
      custom_recipients: mode === 'custom' ? customRecipients.map(r => ({ email: r.email, name: r.name, phone: r.phone })) : [],
      scheduled_for: actualAction === 'schedule' ? new Date(`${schedDate}T${schedTime}`).toISOString() : undefined,
      action: actualAction,
    }});

    if (actualAction === 'schedule') {
      msgEl.textContent = `✓ Campaign scheduled for ${new Date(`${schedDate}T${schedTime}`).toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric',hour:'numeric',minute:'2-digit'})}.`;
      msgEl.className = 'text-xs text-center text-emerald-600';
    } else if (actualAction === 'send') {
      msgEl.textContent = `✓ Sent to ${result.sentCount} of ${result.total} recipients.${result.errorCount > 0 ? ` (${result.errorCount} failed)` : ''}`;
      msgEl.className = 'text-xs text-center text-emerald-600';
    }

    setTimeout(() => { closeCompose(); loadData(); }, 2500);
  } catch (e: any) {
    msgEl.textContent = `Error: ${e.message}`; msgEl.className = 'text-xs text-center text-red-500'; msgEl.classList.remove('hidden');
    btn.disabled = false; btn.textContent = action === 'send' ? (timing === 'schedule' ? 'Schedule Campaign' : 'Send Now') : 'Save Draft';
  }
}
document.getElementById('send-campaign-btn')?.addEventListener('click', () => submitCampaign('send'));
document.getElementById('save-draft-btn')?.addEventListener('click', () => submitCampaign('draft'));

// ── Load campaigns ────────────────────────────────────────────────────────────
async function loadData() {
  try {
    const data = await apiFetch('admin-marketing', {});
    const campaigns = data?.campaigns || [];
    const sent      = campaigns.filter((c: any) => c.status === 'sent');
    const scheduled = campaigns.filter((c: any) => c.status === 'scheduled');
    const drafts    = campaigns.filter((c: any) => c.status === 'draft');
    const totalSent = sent.reduce((s: number, c: any) => s + (c.sent_count || 0), 0);

    document.getElementById('mkt-stats')!.innerHTML = [
      `<div class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5"><div class="text-[11px] font-semibold uppercase tracking-[0.1em] text-neutral-400 mb-1">Campaigns</div><div class="text-2xl font-bold text-neutral-900">${campaigns.length}</div></div>`,
      `<div class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5"><div class="text-[11px] font-semibold uppercase tracking-[0.1em] text-neutral-400 mb-1">Emails Sent</div><div class="text-2xl font-bold text-neutral-900">${totalSent.toLocaleString()}</div></div>`,
      `<div class="bg-white rounded-xl border ${scheduled.length > 0 ? 'border-l-4 border-amber-400' : 'border-neutral-200'} px-4 py-3.5"><div class="text-[11px] font-semibold uppercase tracking-[0.1em] text-neutral-400 mb-1">Scheduled</div><div class="text-2xl font-bold text-neutral-900">${scheduled.length}</div></div>`,
      `<div class="bg-white rounded-xl border ${data.unsubCount > 0 ? 'border-l-4 border-red-300' : 'border-neutral-200'} px-4 py-3.5"><div class="text-[11px] font-semibold uppercase tracking-[0.1em] text-neutral-400 mb-1">Unsubscribes</div><div class="text-2xl font-bold text-neutral-900">${data.unsubCount}</div></div>`,
    ].join('');

    const STATUS: Record<string, string> = {
      sent: 'bg-emerald-100 text-emerald-700', draft: 'bg-neutral-100 text-neutral-600',
      sending: 'bg-amber-100 text-amber-700', scheduled: 'bg-blue-100 text-blue-700',
    };
    const wrap = document.getElementById('campaigns-list')!;
    if (!campaigns.length) {
      wrap.innerHTML = '<div class="px-6 py-12 text-center text-neutral-400 text-sm">No campaigns yet. Click "New Campaign" to start.</div>';
    } else {
      wrap.innerHTML = `<table class="min-w-full text-sm"><thead><tr class="border-b border-neutral-100 text-xs font-semibold text-neutral-500 uppercase tracking-wide">
        <th class="px-5 py-3 text-left">Campaign</th>
        <th class="px-5 py-3 text-left hidden md:table-cell">Audience</th>
        <th class="px-5 py-3 text-center">Status</th>
        <th class="px-5 py-3 text-right hidden md:table-cell">Sent / Total</th>
        <th class="px-5 py-3 text-left hidden lg:table-cell">Date</th>
        <th class="px-5 py-3 text-right"></th>
      </tr></thead><tbody class="divide-y divide-neutral-50">${campaigns.map((c: any) => `
        <tr class="hover:bg-neutral-50 transition-colors">
          <td class="px-5 py-3.5"><div class="font-medium text-neutral-900">${esc(c.name)}</div>${c.subject ? `<div class="text-xs text-neutral-400 truncate max-w-[180px]">${esc(c.subject)}</div>` : ''}</td>
          <td class="px-5 py-3.5 hidden md:table-cell text-xs text-neutral-500">${esc(c.segment_label || c.segment_type)}</td>
          <td class="px-5 py-3.5 text-center"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold ${STATUS[c.status]||'bg-neutral-100 text-neutral-600'}">${c.status}</span></td>
          <td class="px-5 py-3.5 text-right text-xs hidden md:table-cell">${c.sent_count != null ? `${c.sent_count}${c.recipient_count ? ' / '+c.recipient_count : ''}${c.error_count ? ' <span class="text-red-400">('+c.error_count+' err)</span>' : ''}` : '—'}</td>
          <td class="px-5 py-3.5 hidden lg:table-cell text-xs text-neutral-400">${c.sent_at ? new Date(c.sent_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : c.scheduled_for ? '🕐 ' + new Date(c.scheduled_for).toLocaleDateString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}) : new Date(c.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric'})}</td>
          <td class="px-5 py-3.5 text-right">${['draft','scheduled'].includes(c.status) ? `<button class="del-campaign text-xs text-red-400 hover:text-red-600 font-medium" data-id="${esc(c.id)}">Delete</button>` : ''}</td>
        </tr>`).join('')}</tbody></table>`;
      wrap.querySelectorAll('.del-campaign').forEach(btn => {
        btn.addEventListener('click', async () => {
          if (!confirm('Delete this campaign?')) return;
          try { await apiFetch('admin-marketing', { method: 'DELETE', body: { id: (btn as HTMLElement).dataset.id } }); await loadData(); }
          catch (e: any) { alert(e.message); }
        });
      });
    }
  } catch (e: any) {
    document.getElementById('campaigns-list')!.innerHTML = `<div class="px-6 py-6 text-red-500 text-sm">${e.message}</div>`;
  }
}

// ── Load templates ────────────────────────────────────────────────────────────
async function loadTemplates() {
  try {
    const d = await apiFetch('admin-marketing', { params: { resource: 'templates' } });
    templates = d.templates || [];
    const el = document.getElementById('templates-list')!;
    if (!templates.length) { el.innerHTML = '<div class="px-6 py-10 text-center text-neutral-400 text-sm">No templates.</div>'; return; }
    el.innerHTML = `<div class="divide-y divide-neutral-50">${templates.map(t => `
      <div class="px-5 py-4 flex items-center justify-between gap-4 hover:bg-neutral-50">
        <div class="flex-1 min-w-0">
          <div class="font-medium text-neutral-900 text-sm">${esc(t.name)}</div>
          <div class="text-xs text-neutral-400 truncate">${esc(t.subject||'(no subject)')}</div>
        </div>
        <div class="flex gap-2 shrink-0">
          <button class="use-template text-xs text-primary-600 hover:text-primary-700 font-medium" data-id="${esc(t.id)}">Use</button>
          <button class="del-template text-xs text-red-400 hover:text-red-600 font-medium" data-id="${esc(t.id)}">Delete</button>
        </div>
      </div>`).join('')}</div>`;
    el.querySelectorAll('.use-template').forEach(btn => {
      btn.addEventListener('click', () => {
        const t = templates.find(x => x.id === (btn as HTMLElement).dataset.id);
        if (!t) return;
        openCompose();
        if (t.subject) (document.getElementById('c-subject') as HTMLInputElement).value = t.subject;
        if (t.body_html) (document.getElementById('c-body-html') as HTMLElement).innerHTML = t.body_html;
        if (t.body_sms) (document.getElementById('c-body-sms') as HTMLTextAreaElement).value = t.body_sms;
        previewUpdate();
        document.querySelectorAll('.mkt-tab').forEach(b => {
          const active = (b as HTMLElement).dataset.tab === 'campaigns';
          b.classList.toggle('active-mtab', active);
          b.classList.toggle('border-primary-600', active); b.classList.toggle('text-primary-700', active); b.classList.toggle('font-semibold', active);
          b.classList.toggle('text-neutral-500', !active); b.classList.toggle('border-transparent', !active); b.classList.toggle('font-medium', !active);
        });
        document.getElementById('tab-campaigns')?.classList.remove('hidden');
        document.getElementById('tab-templates')?.classList.add('hidden');
      });
    });
    el.querySelectorAll('.del-template').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('Delete this template?')) return;
        await apiFetch('admin-marketing', { method: 'DELETE', body: { id: (btn as HTMLElement).dataset.id }, params: { resource: 'templates' } });
        templates = templates.filter(t => t.id !== (btn as HTMLElement).dataset.id);
        loadTemplates();
      });
    });
  } catch {}
}

// ── Load audiences ────────────────────────────────────────────────────────────
async function loadAudiences() {
  try {
    const d = await apiFetch('admin-marketing', { params: { resource: 'audiences' } });
    audiences = d.audiences || [];
    const el = document.getElementById('audiences-list')!;
    if (!audiences.length) { el.innerHTML = '<div class="px-6 py-10 text-center text-neutral-400 text-sm">No saved audiences.</div>'; return; }
    el.innerHTML = `<div class="divide-y divide-neutral-50">${audiences.map(a => `
      <div class="px-5 py-3.5 flex items-center justify-between gap-4 hover:bg-neutral-50">
        <div>
          <div class="font-medium text-neutral-900 text-sm">${esc(a.name)}</div>
          ${a.description ? `<div class="text-xs text-neutral-400">${esc(a.description)}</div>` : ''}
        </div>
        <div class="flex gap-2">
          <button class="audience-use text-xs text-primary-600 hover:text-primary-700 font-medium" data-seg="${esc(a.segment_type)}">Use</button>
        </div>
      </div>`).join('')}</div>`;
    el.querySelectorAll('.audience-use').forEach(btn => {
      btn.addEventListener('click', () => {
        const seg = (btn as HTMLElement).dataset.seg!;
        openCompose();
        (document.getElementById('c-segment') as HTMLSelectElement).value = seg;
        previewSegment();
        document.querySelectorAll('.mkt-tab').forEach(b => {
          const active = (b as HTMLElement).dataset.tab === 'campaigns';
          b.classList.toggle('active-mtab', active); b.classList.toggle('border-primary-600', active); b.classList.toggle('text-primary-700', active); b.classList.toggle('font-semibold', active);
          b.classList.toggle('text-neutral-500', !active); b.classList.toggle('border-transparent', !active); b.classList.toggle('font-medium', !active);
        });
        document.getElementById('tab-campaigns')?.classList.remove('hidden');
        document.getElementById('tab-audiences')?.classList.add('hidden');
      });
    });
  } catch {}
}

// ── Load unsubscribes ─────────────────────────────────────────────────────────
async function loadUnsubs(search = '') {
  try {
    const params: Record<string, string> = { resource: 'unsubscribes' };
    if (search) params.search = search;
    const d = await apiFetch('admin-marketing', { params });
    const unsubs = d.unsubscribes || [];
    const el = document.getElementById('unsubs-list')!;
    if (!unsubs.length) { el.innerHTML = '<div class="px-6 py-10 text-center text-neutral-400 text-sm">No unsubscribes yet.</div>'; return; }
    el.innerHTML = `<table class="min-w-full text-sm"><thead><tr class="border-b border-neutral-100 text-xs font-semibold text-neutral-500 uppercase tracking-wide">
      <th class="px-5 py-3 text-left">Email</th>
      <th class="px-5 py-3 text-center">Email Unsub</th>
      <th class="px-5 py-3 text-center">SMS Unsub</th>
      <th class="px-5 py-3 text-left hidden md:table-cell">Source</th>
      <th class="px-5 py-3 text-left hidden lg:table-cell">Date</th>
      <th class="px-5 py-3 text-right">Actions</th>
    </tr></thead><tbody class="divide-y divide-neutral-50">${unsubs.map((u: any) => `
      <tr class="hover:bg-neutral-50">
        <td class="px-5 py-3.5 text-sm font-medium text-neutral-900">${esc(u.email||'—')}</td>
        <td class="px-5 py-3.5 text-center text-xs">${u.unsub_email ? '<span class="text-red-500 font-bold">✗</span>' : '<span class="text-emerald-500">✓</span>'}</td>
        <td class="px-5 py-3.5 text-center text-xs">${u.unsub_sms   ? '<span class="text-red-500 font-bold">✗</span>' : '<span class="text-emerald-500">✓</span>'}</td>
        <td class="px-5 py-3.5 hidden md:table-cell text-xs text-neutral-400">${esc(u.source||'—')}</td>
        <td class="px-5 py-3.5 hidden lg:table-cell text-xs text-neutral-400">${new Date(u.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</td>
        <td class="px-5 py-3.5 text-right">
          <button class="resub-btn text-xs text-emerald-600 hover:text-emerald-700 font-medium" data-id="${esc(u.id)}">Re-subscribe</button>
        </td>
      </tr>`).join('')}</tbody></table>`;
    el.querySelectorAll('.resub-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('Re-subscribe this address?')) return;
        await apiFetch('admin-marketing', { method: 'PATCH', body: { id: (btn as HTMLElement).dataset.id, resubscribe: true }, params: { resource: 'unsubscribes' } });
        loadUnsubs(search);
      });
    });
  } catch {}
}

let unsubSearchTimer: ReturnType<typeof setTimeout>;
document.getElementById('unsub-search')?.addEventListener('input', (e) => {
  clearTimeout(unsubSearchTimer);
  unsubSearchTimer = setTimeout(() => loadUnsubs((e.target as HTMLInputElement).value.trim()), 350);
});
document.getElementById('add-unsub-btn')?.addEventListener('click', async () => {
  const email = prompt('Email to unsubscribe / re-subscribe:');
  if (!email) return;
  const action = confirm('OK = Unsubscribe · Cancel = Re-subscribe');
  await apiFetch('unsubscribe', { method: 'POST', body: { email, unsub_email: action, resubscribe: !action } });
  loadUnsubs();
});

loadData();
previewSegment();
