document.getElementById('template-modal-overlay')?.addEventListener('click', () => document.getElementById('template-modal')?.classList.add('hidden'));

// ── Test send ─────────────────────────────────────────────────────────────────
document.getElementById('test-send-btn')?.addEventListener('click', async () => {
