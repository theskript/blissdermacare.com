// ── Template loading ──────────────────────────────────────────────────────────
document.getElementById('load-template-btn')?.addEventListener('click', async () => {
  if (!templates.length) {
    try { const d = await apiFetch('admin-marketing', { params: { resource: 'templates' } }); templates = d.templates || []; } catch {}
  }
  const list = document.getElementById('template-picker-list')!;
  list.innerHTML = templates.map(t => `
    <div class="border border-neutral-200 rounded-xl p-4 hover:border-primary-300 cursor-pointer template-pick" data-id="${esc(t.id)}">
      <div class="font-semibold text-sm text-neutral-900 mb-0.5">${esc(t.name)}</div>
      <div class="text-xs text-neutral-500 truncate">${esc(t.subject || '(no subject)')}</div>
    </div>`).join('');
  list.querySelectorAll('.template-pick').forEach(el => {
    el.addEventListener('click', () => {
      const t = templates.find(x => x.id === (el as HTMLElement).dataset.id);
