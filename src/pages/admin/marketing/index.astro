---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Marketing" activeNav="marketing">
<style>
  .tab-active { border-bottom: 2px solid #7c3aed; color: #6d28d9; font-weight: 600; }
  .email-preview-frame { border: 1px solid #e5e7eb; border-radius: 0.75rem; background: white; min-height: 300px; overflow-y: auto; padding: 1.5rem; font-family: sans-serif; font-size: 14px; line-height: 1.6; }
  [contenteditable]:empty::before { content: attr(placeholder); color: #9ca3af; }
  .recipient-tag { display: inline-flex; align-items: center; gap: 4px; background: #ede9fe; color: #5b21b6; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 500; }
  .client-result { padding: 8px 12px; cursor: pointer; border-bottom: 1px solid #f3f4f6; }
  .client-result:hover { background: #f9fafb; }
</style>

<div class="p-6 lg:p-8">
  <!-- Header -->
  <div class="mb-6 flex items-start justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-2xl font-serif font-semibold text-neutral-900">Marketing</h1>
      <p class="text-sm text-neutral-500 mt-0.5">Send targeted email and SMS campaigns to your client list.</p>
    </div>
    <button id="compose-btn"
      class="inline-flex items-center gap-2 px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-xl transition-colors shadow-sm shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      New Campaign
    </button>
  </div>

  <!-- Stats -->
  <div id="mkt-stats" class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6"></div>

  <!-- Tabs -->
  <div class="flex gap-0 mb-5 border-b border-neutral-200">
    <button class="mkt-tab tab-active px-4 py-2.5 text-sm border-b-2 -mb-px" data-tab="campaigns">Campaigns</button>
    <button class="mkt-tab px-4 py-2.5 text-sm text-neutral-500 hover:text-neutral-800 border-b-2 border-transparent -mb-px" data-tab="templates">Templates</button>
    <button class="mkt-tab px-4 py-2.5 text-sm text-neutral-500 hover:text-neutral-800 border-b-2 border-transparent -mb-px" data-tab="audiences">Audiences</button>
    <button class="mkt-tab px-4 py-2.5 text-sm text-neutral-500 hover:text-neutral-800 border-b-2 border-transparent -mb-px" data-tab="unsubs">Unsubscribes</button>
  </div>

  <div id="tab-campaigns"><div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden"><div id="campaigns-list" class="overflow-x-auto"><div class="px-6 py-10 text-center text-neutral-400 text-sm">Loading…</div></div></div></div>
  <div id="tab-templates" class="hidden"><div id="templates-list" class="bg-white rounded-2xl border border-neutral-200 overflow-hidden"><div class="px-6 py-10 text-center text-neutral-400 text-sm">Loading…</div></div></div>
  <div id="tab-audiences" class="hidden"><div id="audiences-list" class="bg-white rounded-2xl border border-neutral-200 overflow-hidden"><div class="px-6 py-10 text-center text-neutral-400 text-sm">Loading…</div></div></div>
  <div id="tab-unsubs" class="hidden">
    <div class="flex gap-3 mb-3">
      <input id="unsub-search" type="text" placeholder="Search by email…" class="flex-1 px-3 py-2 rounded-xl border border-neutral-300 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none"/>
      <button id="add-unsub-btn" class="px-4 py-2 bg-white border border-neutral-300 hover:border-neutral-400 text-sm text-neutral-700 rounded-xl transition-colors">+ Add manually</button>
    </div>
    <div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden"><div id="unsubs-list" class="overflow-x-auto"><div class="px-6 py-10 text-center text-neutral-400 text-sm">Loading…</div></div></div>
  </div>
</div>

<!-- ══ Compose slide-over ══════════════════════════════════════════════════════ -->
<div id="compose-panel" class="hidden fixed inset-0 z-50 flex">
  <div class="absolute inset-0 bg-black/40" id="compose-overlay"></div>
  <div class="relative ml-auto w-full max-w-5xl bg-white shadow-2xl border-l border-neutral-200 flex flex-col h-full">

    <!-- Panel header -->
    <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-100 shrink-0">
      <h3 id="compose-title" class="font-semibold text-neutral-900">New Campaign</h3>
      <div class="flex items-center gap-2">
        <span id="compose-save-msg" class="text-xs text-neutral-400 hidden"></span>
        <button id="compose-close" class="p-1.5 rounded-lg text-neutral-400 hover:bg-neutral-100 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <!-- Two-col: form + preview -->
    <div class="flex flex-1 overflow-hidden">

      <!-- Left: form -->
      <div class="flex-1 overflow-y-auto p-6 space-y-5 border-r border-neutral-100" style="min-width:0">

        <!-- Campaign meta -->
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Campaign Name *</label>
            <input id="c-name" type="text" placeholder="e.g. Summer Promo 2026" class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Channels</label>
            <div class="flex gap-4 pt-1">
              <label class="flex items-center gap-1.5 cursor-pointer select-none"><input type="checkbox" id="ch-email" checked class="w-3.5 h-3.5 rounded accent-primary-600"/><span class="text-sm font-medium text-neutral-700">Email</span></label>
              <label class="flex items-center gap-1.5 cursor-pointer select-none"><input type="checkbox" id="ch-sms" class="w-3.5 h-3.5 rounded accent-primary-600"/><span class="text-sm font-medium text-neutral-700">SMS</span></label>
            </div>
          </div>
        </div>

        <!-- Subject -->
        <div id="email-subject-wrap">
          <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Email Subject *</label>
          <input id="c-subject" type="text" placeholder="Your subject line" class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/>
        </div>

        <!-- Recipients -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-2">Recipients</label>
          <div class="flex gap-3 mb-2">
            <label class="flex items-center gap-1.5 cursor-pointer text-sm">
              <input type="radio" name="rec-type" value="segment" checked class="accent-primary-600"/> Audience Segment
            </label>
            <label class="flex items-center gap-1.5 cursor-pointer text-sm">
              <input type="radio" name="rec-type" value="custom" class="accent-primary-600"/> Specific Clients
            </label>
          </div>
          <!-- Segment mode -->
          <div id="rec-segment-wrap">
            <select id="c-segment" class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 outline-none bg-white">
              <option value="all">All Clients</option>
              <option value="recent_30">Recent — Last 30 days</option>
              <option value="recent_60">Recent — Last 60 days</option>
              <option value="lapsed_90">Lapsed — 90+ days since last visit</option>
              <option value="members">Active Members only</option>
              <option value="new_clients">New Clients (1 visit)</option>
            </select>
            <p id="segment-preview" class="text-xs text-neutral-400 mt-1.5">Estimating audience…</p>
          </div>
          <!-- Individual picker -->
          <div id="rec-custom-wrap" class="hidden">
            <div class="relative mb-2">
              <input id="client-search-input" type="text" placeholder="Search by name, email, or phone…"
                class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 outline-none"/>
              <div id="client-results" class="hidden absolute top-full left-0 right-0 bg-white border border-neutral-200 rounded-lg shadow-lg z-10 max-h-40 overflow-y-auto"></div>
            </div>
            <div id="selected-recipients" class="flex flex-wrap gap-1.5 min-h-[28px]"></div>
            <p id="custom-count" class="text-xs text-neutral-400 mt-1">0 recipients selected</p>
          </div>
        </div>

        <!-- Templates picker -->
        <div id="email-body-wrap">
          <div class="flex items-center justify-between mb-1">
            <label class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Email Body *</label>
            <button id="load-template-btn" class="text-xs text-primary-600 hover:text-primary-700 font-medium">Use Template ▾</button>
          </div>
          <div id="template-picker" class="hidden mb-2 bg-white border border-neutral-200 rounded-lg shadow-lg z-10 max-h-56 overflow-y-auto"></div>
          <!-- Toolbar -->
          <div class="flex flex-wrap gap-0.5 p-1 bg-neutral-50 rounded-t-lg border border-b-0 border-neutral-200">
            <button type="button" onclick="document.execCommand('bold')" class="px-2 py-1 text-xs font-bold rounded hover:bg-neutral-200" title="Bold">B</button>
            <button type="button" onclick="document.execCommand('italic')" class="px-2 py-1 text-xs italic rounded hover:bg-neutral-200" title="Italic">I</button>
            <button type="button" onclick="document.execCommand('underline')" class="px-2 py-1 text-xs underline rounded hover:bg-neutral-200" title="Underline">U</button>
            <span class="w-px bg-neutral-300 mx-0.5"></span>
            <button type="button" onclick="insertLink()" class="px-2 py-1 text-xs rounded hover:bg-neutral-200" title="Link">🔗</button>
            <button type="button" onclick="document.execCommand('formatBlock',false,'h2')" class="px-2 py-1 text-xs font-semibold rounded hover:bg-neutral-200">H2</button>
            <button type="button" onclick="document.execCommand('formatBlock',false,'p')" class="px-2 py-1 text-xs rounded hover:bg-neutral-200">¶</button>
            <button type="button" onclick="document.execCommand('insertUnorderedList')" class="px-2 py-1 text-xs rounded hover:bg-neutral-200">• List</button>
            <span class="w-px bg-neutral-300 mx-0.5"></span>
            <button type="button" onclick="document.getElementById('c-body-html').innerHTML=''" class="px-2 py-1 text-xs text-neutral-400 rounded hover:bg-neutral-200" title="Clear">✕ Clear</button>
          </div>
          <div id="c-body-html" contenteditable="true"
            class="min-h-[200px] px-3 py-2.5 rounded-b-lg border border-neutral-200 text-sm focus:border-primary-400 outline-none"
            style="line-height:1.6"></div>
          <p class="text-xs text-neutral-400 mt-1">Unsubscribe link added automatically to footer.</p>
        </div>

        <!-- SMS body -->
        <div id="sms-body-wrap" class="hidden">
          <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">SMS Message *</label>
          <textarea id="c-body-sms" rows="3" maxlength="160" placeholder="Your SMS (160 chars max)…"
            class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 outline-none resize-none"></textarea>
          <div class="flex justify-between mt-1">
            <p class="text-xs text-neutral-400">Reply STOP appended automatically.</p>
            <span id="sms-counter" class="text-xs text-neutral-400">0/160</span>
          </div>
        </div>

        <!-- Schedule -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-2">When to Send</label>
          <div class="flex gap-3 mb-2">
            <label class="flex items-center gap-1.5 cursor-pointer text-sm"><input type="radio" name="when" value="now" checked class="accent-primary-600"/> Send Now</label>
            <label class="flex items-center gap-1.5 cursor-pointer text-sm"><input type="radio" name="when" value="schedule" class="accent-primary-600"/> Schedule</label>
          </div>
          <div id="schedule-wrap" class="hidden">
            <input id="c-scheduled-for" type="datetime-local" class="px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 outline-none"/>
            <p id="schedule-preview" class="text-xs text-neutral-400 mt-1"></p>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex flex-wrap gap-2 pt-2 border-t border-neutral-100">
          <button id="send-btn" class="flex-1 py-2.5 bg-primary-600 hover:bg-primary-700 disabled:opacity-50 text-white text-sm font-semibold rounded-xl transition-colors">Send Now</button>
          <button id="save-draft-btn" class="px-4 py-2.5 border border-neutral-300 text-neutral-600 hover:bg-neutral-50 text-sm rounded-xl transition-colors">Save Draft</button>
          <button id="test-send-btn" class="px-4 py-2.5 border border-violet-300 text-violet-600 hover:bg-violet-50 text-sm rounded-xl transition-colors">🧪 Test Send</button>
        </div>
        <div id="action-msg" class="text-xs text-center hidden"></div>

      </div>

      <!-- Right: preview -->
      <div class="w-96 shrink-0 flex flex-col bg-neutral-50 overflow-hidden">
        <div class="px-4 py-3 border-b border-neutral-200 bg-white flex items-center justify-between">
          <p class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Live Preview</p>
          <div class="flex gap-1">
            <button id="preview-desktop" class="px-2 py-1 text-[10px] font-medium rounded bg-neutral-900 text-white">Desktop</button>
            <button id="preview-mobile" class="px-2 py-1 text-[10px] font-medium rounded text-neutral-500 hover:bg-neutral-100">Mobile</button>
          </div>
        </div>
        <div class="flex-1 overflow-y-auto p-4">
          <div id="preview-container" class="transition-all" style="max-width:100%">
            <div class="bg-neutral-800 rounded-t-lg px-4 py-2 flex items-center gap-2">
              <div class="flex gap-1"><span class="w-2.5 h-2.5 rounded-full bg-red-400"></span><span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span><span class="w-2.5 h-2.5 rounded-full bg-green-400"></span></div>
              <span id="preview-subject-bar" class="text-xs text-neutral-400 truncate flex-1">(no subject)</span>
            </div>
            <div id="email-preview-body" class="email-preview-frame rounded-b-lg" style="border-top:none;border-radius:0 0 0.75rem 0.75rem">
              <p style="color:#9ca3af;text-align:center;padding:2rem 0">Start typing to see preview…</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  import { requireLogin, apiFetch } from '../../../scripts/adminAuth.js';
  requireLogin();

  function esc(s: unknown) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  (window as any).insertLink = () => { const u = prompt('URL:'); if (u) document.execCommand('createLink', false, u); };

  // ── Tabs ───────────────────────────────────────────────────────────────────
  document.querySelectorAll('.mkt-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = (btn as HTMLElement).dataset.tab!;
      document.querySelectorAll('.mkt-tab').forEach(b => {
        const a = (b as HTMLElement).dataset.tab === tab;
        b.classList.toggle('tab-active', a);
        b.classList.toggle('text-neutral-500', !a);
        b.classList.toggle('border-transparent', !a);
      });
      ['campaigns','templates','audiences','unsubs'].forEach(t =>
        document.getElementById(`tab-${t}`)?.classList.toggle('hidden', t !== tab));
      if (tab === 'templates') loadTemplates();
      if (tab === 'audiences') loadAudiences();
      if (tab === 'unsubs') loadUnsubs();
    });
  });

  // ── Compose helpers ────────────────────────────────────────────────────────
  const chEmail = () => (document.getElementById('ch-email') as HTMLInputElement).checked;
  const chSms   = () => (document.getElementById('ch-sms')   as HTMLInputElement).checked;

  document.getElementById('ch-email')?.addEventListener('change', () => {
    document.getElementById('email-subject-wrap')?.classList.toggle('hidden', !chEmail());
    document.getElementById('email-body-wrap')?.classList.toggle('hidden', !chEmail());
    updatePreview();
  });
  document.getElementById('ch-sms')?.addEventListener('change', () => {
    document.getElementById('sms-body-wrap')?.classList.toggle('hidden', !chSms());
  });

  // Schedule toggle
  document.querySelectorAll('input[name="when"]').forEach(r => {
    r.addEventListener('change', () => {
      const sched = (document.querySelector('input[name="when"]:checked') as HTMLInputElement)?.value === 'schedule';
      document.getElementById('schedule-wrap')?.classList.toggle('hidden', !sched);
      document.getElementById('send-btn')!.textContent = sched ? 'Schedule Campaign' : 'Send Now';
    });
  });

  // Schedule preview
  document.getElementById('c-scheduled-for')?.addEventListener('input', (e) => {
    const dt = new Date((e.target as HTMLInputElement).value);
    const el = document.getElementById('schedule-preview')!;
    if (isNaN(dt.getTime())) { el.textContent = ''; return; }
    const diff = dt.getTime() - Date.now();
    const h = Math.floor(diff / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    el.textContent = diff < 0 ? '⚠ Date is in the past' : `Sends in ${h > 0 ? h + 'h ' : ''}${m}m (${dt.toLocaleString('en-US', { weekday:'short', month:'short', day:'numeric', hour:'numeric', minute:'2-digit' })})`;
    el.className = `text-xs mt-1 ${diff < 0 ? 'text-red-500' : 'text-neutral-400'}`;
  });

  // SMS counter
  document.getElementById('c-body-sms')?.addEventListener('input', (e) => {
    const l = (e.target as HTMLTextAreaElement).value.length;
    const el = document.getElementById('sms-counter')!;
    el.textContent = `${l}/160`; el.className = `text-xs ${l > 140 ? 'text-amber-600' : 'text-neutral-400'}`;
  });

  // ── Live preview ───────────────────────────────────────────────────────────
  let previewMode = 'desktop';
  document.getElementById('preview-desktop')?.addEventListener('click', () => {
    previewMode = 'desktop';
    document.getElementById('preview-container')!.style.maxWidth = '100%';
    document.getElementById('preview-desktop')!.className = 'px-2 py-1 text-[10px] font-medium rounded bg-neutral-900 text-white';
    document.getElementById('preview-mobile')!.className  = 'px-2 py-1 text-[10px] font-medium rounded text-neutral-500 hover:bg-neutral-100';
  });
  document.getElementById('preview-mobile')?.addEventListener('click', () => {
    previewMode = 'mobile';
    document.getElementById('preview-container')!.style.maxWidth = '375px';
    document.getElementById('preview-mobile')!.className = 'px-2 py-1 text-[10px] font-medium rounded bg-neutral-900 text-white';
    document.getElementById('preview-desktop')!.className  = 'px-2 py-1 text-[10px] font-medium rounded text-neutral-500 hover:bg-neutral-100';
  });

  function updatePreview() {
    const subject = (document.getElementById('c-subject') as HTMLInputElement)?.value || '(no subject)';
    const body    = (document.getElementById('c-body-html') as HTMLElement)?.innerHTML || '';
    document.getElementById('preview-subject-bar')!.textContent = subject;
    const footer = `<div style="margin-top:32px;padding-top:16px;border-top:1px solid #e5e7eb;font-size:11px;color:#9ca3af;text-align:center;">Bliss Dermacare · Tampa, FL · <span style="color:#9ca3af;text-decoration:underline;">Unsubscribe</span></div>`;
    document.getElementById('email-preview-body')!.innerHTML = body
      ? (body + footer)
      : '<p style="color:#9ca3af;text-align:center;padding:2rem 0">Start typing to see preview…</p>';
  }

  document.getElementById('c-subject')?.addEventListener('input', updatePreview);
  document.getElementById('c-body-html')?.addEventListener('input', updatePreview);

  // ── Recipients ─────────────────────────────────────────────────────────────
  document.querySelectorAll('input[name="rec-type"]').forEach(r => {
    r.addEventListener('change', () => {
      const isCustom = (document.querySelector('input[name="rec-type"]:checked') as HTMLInputElement)?.value === 'custom';
      document.getElementById('rec-segment-wrap')?.classList.toggle('hidden', isCustom);
      document.getElementById('rec-custom-wrap')?.classList.toggle('hidden', !isCustom);
    });
  });

  // Segment preview
  let segTimer: ReturnType<typeof setTimeout>;
  async function previewSegment() {
    const seg = (document.getElementById('c-segment') as HTMLSelectElement)?.value;
    const el  = document.getElementById('segment-preview')!;
    el.textContent = 'Estimating…';
    try {
      const d = await apiFetch('admin-marketing', { params: { recipients: 'true', segment: seg } });
      const names = (d.preview || []).map((p: any) => p.name || p.email).join(', ');
      el.textContent = `~${d.count} recipient${d.count !== 1 ? 's' : ''}${names ? ': ' + names + (d.count > (d.preview?.length || 0) ? '…' : '') : ''}`;
    } catch { el.textContent = 'Could not estimate'; }
  }
  document.getElementById('c-segment')?.addEventListener('change', () => { clearTimeout(segTimer); segTimer = setTimeout(previewSegment, 400); });

  // Client picker
  let customRecipients: {name:string, email:string, phone?:string}[] = [];
  let clientSearchTimer: ReturnType<typeof setTimeout>;
  const searchInput = document.getElementById('client-search-input') as HTMLInputElement;
  const resultsDiv  = document.getElementById('client-results')!;

  searchInput?.addEventListener('input', () => {
    clearTimeout(clientSearchTimer);
    const q = searchInput.value.trim();
    if (!q) { resultsDiv.classList.add('hidden'); return; }
    clientSearchTimer = setTimeout(async () => {
      try {
        const d = await apiFetch('admin-marketing', { params: { clientSearch: q } });
        const clients = d.clients || [];
        if (!clients.length) { resultsDiv.innerHTML = '<div class="px-3 py-2 text-xs text-neutral-400">No results</div>'; resultsDiv.classList.remove('hidden'); return; }
        resultsDiv.innerHTML = clients.map((c: any) => `<div class="client-result" data-name="${esc(c.client_name)}" data-email="${esc(c.client_email)}" data-phone="${esc(c.client_phone||'')}"><div class="text-sm font-medium text-neutral-900">${esc(c.client_name||c.client_email)}</div><div class="text-xs text-neutral-400">${esc(c.client_email)}</div></div>`).join('');
        resultsDiv.querySelectorAll('.client-result').forEach(row => {
          row.addEventListener('click', () => {
            const r = row as HTMLElement;
            const email = r.dataset.email!;
            if (!customRecipients.find(x => x.email === email)) {
              customRecipients.push({ name: r.dataset.name || email, email, phone: r.dataset.phone });
              renderRecipientTags();
            }
            searchInput.value = ''; resultsDiv.classList.add('hidden');
          });
        });
        resultsDiv.classList.remove('hidden');
      } catch {}
    }, 300);
  });
  document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('#rec-custom-wrap')) resultsDiv.classList.add('hidden'); });

  function renderRecipientTags() {
    const container = document.getElementById('selected-recipients')!;
    container.innerHTML = customRecipients.map((r, i) => `<span class="recipient-tag">${esc(r.name||r.email)}<button data-i="${i}" class="rm-tag ml-0.5 hover:text-red-600 text-neutral-500">×</button></span>`).join('');
    container.querySelectorAll('.rm-tag').forEach(btn => {
      btn.addEventListener('click', () => { customRecipients.splice(parseInt((btn as HTMLElement).dataset.i!), 1); renderRecipientTags(); });
    });
    document.getElementById('custom-count')!.textContent = `${customRecipients.length} recipient${customRecipients.length !== 1 ? 's' : ''} selected`;
  }

  // ── Templates ──────────────────────────────────────────────────────────────
  let allTemplates: any[] = [];
  document.getElementById('load-template-btn')?.addEventListener('click', async () => {
    const picker = document.getElementById('template-picker')!;
    if (!picker.classList.contains('hidden')) { picker.classList.add('hidden'); return; }
    if (!allTemplates.length) {
      try { const d = await apiFetch('admin-marketing', { params: { resource: 'templates' } }); allTemplates = d.templates || []; } catch {}
    }
    if (!allTemplates.length) { picker.innerHTML = '<div class="px-3 py-2 text-xs text-neutral-400">No templates yet.</div>'; }
    else {
      picker.innerHTML = allTemplates.map(t => `<div class="client-result cursor-pointer" data-tid="${esc(t.id)}"><div class="text-sm font-medium text-neutral-900">${esc(t.name)}</div><div class="text-xs text-neutral-400 truncate">${esc(t.subject||'')}</div></div>`).join('');
      picker.querySelectorAll('.client-result').forEach(row => {
        row.addEventListener('click', () => {
          const t = allTemplates.find(x => x.id === (row as HTMLElement).dataset.tid)!;
          if (t.subject)    (document.getElementById('c-subject') as HTMLInputElement).value = t.subject;
          if (t.body_html)  (document.getElementById('c-body-html') as HTMLElement).innerHTML = t.body_html;
          if (t.body_sms)   (document.getElementById('c-body-sms') as HTMLTextAreaElement).value = t.body_sms;
          picker.classList.add('hidden'); updatePreview();
        });
      });
    }
    picker.classList.remove('hidden');
  });
  document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('#email-body-wrap')) document.getElementById('template-picker')?.classList.add('hidden'); });

  // ── Submit handlers ─────────────────────────────────────────────────────────
  async function submit(action: string) {
    const msgEl   = document.getElementById('action-msg')!;
    const btn     = document.getElementById(action === 'test' ? 'test-send-btn' : action === 'draft' ? 'save-draft-btn' : 'send-btn') as HTMLButtonElement;
    const name    = (document.getElementById('c-name')    as HTMLInputElement).value.trim();
    const subject = (document.getElementById('c-subject') as HTMLInputElement).value.trim();
    const bodyHtml = (document.getElementById('c-body-html') as HTMLElement).innerHTML.trim();
    const bodySms  = (document.getElementById('c-body-sms')  as HTMLTextAreaElement).value.trim();
    const segmentType = (document.getElementById('c-segment') as HTMLSelectElement)?.value || 'all';
    const isCustom    = (document.querySelector('input[name="rec-type"]:checked') as HTMLInputElement)?.value === 'custom';
    const isSched     = (document.querySelector('input[name="when"]:checked') as HTMLInputElement)?.value === 'schedule';
    const schedFor    = (document.getElementById('c-scheduled-for') as HTMLInputElement)?.value;

    if (!name) { msgEl.textContent = 'Campaign name is required.'; msgEl.className = 'text-xs text-center text-red-500'; msgEl.classList.remove('hidden'); return; }

    if (action === 'test') {
      const testEmail = prompt('Send test to email address:'); if (!testEmail) return;
      btn.disabled = true; btn.textContent = 'Sending…';
      try {
        const r = await apiFetch('admin-marketing', { params: { resource: 'campaign' }, method: 'POST', body: { name, subject, body_html: bodyHtml, body_text: '', body_sms: bodySms, channels: [chEmail() && 'email', chSms() && 'sms'].filter(Boolean), action: 'test', test_email: testEmail } });
        msgEl.textContent = `✓ Test sent to ${r.sentTo}`; msgEl.className = 'text-xs text-center text-emerald-600';
      } catch (e: any) { msgEl.textContent = `Error: ${e.message}`; msgEl.className = 'text-xs text-center text-red-500'; }
      finally { btn.disabled = false; btn.textContent = '🧪 Test Send'; msgEl.classList.remove('hidden'); }
      return;
    }

    const effectiveAction = isSched ? 'schedule' : action;
    if (effectiveAction === 'send' || effectiveAction === 'schedule') {
      if (chEmail() && (!subject || !bodyHtml)) { msgEl.textContent = 'Email subject and body are required.'; msgEl.className = 'text-xs text-center text-red-500'; msgEl.classList.remove('hidden'); return; }
      if (chSms() && !bodySms) { msgEl.textContent = 'SMS message is required.'; msgEl.className = 'text-xs text-center text-red-500'; msgEl.classList.remove('hidden'); return; }
      if (effectiveAction === 'schedule' && !schedFor) { msgEl.textContent = 'Please select a send date/time.'; msgEl.className = 'text-xs text-center text-red-500'; msgEl.classList.remove('hidden'); return; }
    }

    btn.disabled = true;
    btn.textContent = effectiveAction === 'send' ? 'Sending…' : effectiveAction === 'schedule' ? 'Scheduling…' : 'Saving…';
    if (effectiveAction === 'send') { msgEl.textContent = 'Sending — this may take a moment for large lists…'; msgEl.className = 'text-xs text-center text-neutral-400'; msgEl.classList.remove('hidden'); }

    try {
      const result = await apiFetch('admin-marketing', {
        params: { resource: 'campaign' },
        method: 'POST',
        body: {
          name, subject, body_html: bodyHtml, body_text: '', body_sms: bodySms,
          channels: [chEmail() && 'email', chSms() && 'sms'].filter(Boolean),
          segment_type: isCustom ? 'custom' : segmentType,
          segment_label: isCustom ? `${customRecipients.length} specific clients` : segmentType,
          custom_recipients: isCustom ? customRecipients.map(r => ({ name: r.name, email: r.email, phone: r.phone })) : [],
          scheduled_for: schedFor ? new Date(schedFor).toISOString() : null,
          action: effectiveAction,
        },
      });
      if (effectiveAction === 'send') {
        msgEl.textContent = `✓ Sent to ${result.sentCount} of ${result.total} recipients.`;
        msgEl.className = 'text-xs text-center text-emerald-600';
        setTimeout(() => { closeCompose(); loadData(); }, 2500);
      } else if (effectiveAction === 'schedule') {
        msgEl.textContent = `✓ Scheduled for ${new Date(schedFor!).toLocaleString()}.`;
        msgEl.className = 'text-xs text-center text-emerald-600';
        setTimeout(() => { closeCompose(); loadData(); }, 2000);
      } else { closeCompose(); loadData(); }
    } catch (e: any) {
      msgEl.textContent = `Error: ${e.message}`; msgEl.className = 'text-xs text-center text-red-500';
      btn.disabled = false;
      btn.textContent = effectiveAction === 'send' ? 'Send Now' : effectiveAction === 'schedule' ? 'Schedule Campaign' : 'Save Draft';
    }
    msgEl.classList.remove('hidden');
  }

  document.getElementById('send-btn')?.addEventListener('click',       () => submit('send'));
  document.getElementById('save-draft-btn')?.addEventListener('click', () => submit('draft'));
  document.getElementById('test-send-btn')?.addEventListener('click',  () => submit('test'));

  // ── Open / close compose ───────────────────────────────────────────────────
  function openCompose() {
    (document.getElementById('c-name') as HTMLInputElement).value = '';
    (document.getElementById('c-subject') as HTMLInputElement).value = '';
    (document.getElementById('c-body-html') as HTMLElement).innerHTML = '';
    (document.getElementById('c-body-sms') as HTMLTextAreaElement).value = '';
    customRecipients = []; renderRecipientTags();
    document.getElementById('action-msg')!.className = 'text-xs text-center hidden';
    document.getElementById('send-btn')!.textContent = 'Send Now';
    document.getElementById('compose-panel')?.classList.remove('hidden');
    updatePreview(); previewSegment();
  }
  function closeCompose() {
    document.getElementById('compose-panel')?.classList.add('hidden');
  }
  document.getElementById('compose-btn')?.addEventListener('click', openCompose);
  document.getElementById('compose-close')?.addEventListener('click', closeCompose);
  document.getElementById('compose-overlay')?.addEventListener('click', closeCompose);

  // ── Load main data ─────────────────────────────────────────────────────────
  const STATUS_CLS: Record<string,string> = {
    sent: 'bg-emerald-100 text-emerald-700', draft: 'bg-neutral-100 text-neutral-600',
    sending: 'bg-amber-100 text-amber-700', scheduled: 'bg-blue-100 text-blue-700',
  };

  async function loadData() {
    try {
      const data = await apiFetch('admin-marketing', {});
      const campaigns = data?.campaigns || [];
      const sent      = campaigns.filter((c: any) => c.status === 'sent');
      const drafts    = campaigns.filter((c: any) => c.status === 'draft');
      const scheduled = campaigns.filter((c: any) => c.status === 'scheduled');
      const totalSent = sent.reduce((s: number, c: any) => s + (c.sent_count || 0), 0);

      document.getElementById('mkt-stats')!.innerHTML = [
        `<a href="#" class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5 hover:border-neutral-300 transition-colors"><div class="text-[11px] font-semibold uppercase tracking-[0.1em] text-neutral-400 mb-1">Total Campaigns</div><div class="text-2xl font-bold text-neutral-900">${campaigns.length}</div><div class="text-[11px] text-neutral-400">${drafts.length} draft · ${scheduled.length} scheduled</div></a>`,
        `<div class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5"><div class="text-[11px] font-semibold uppercase tracking-[0.1em] text-neutral-400 mb-1">Total Sends</div><div class="text-2xl font-bold text-neutral-900">${totalSent.toLocaleString()}</div><div class="text-[11px] text-neutral-400">across ${sent.length} campaigns</div></div>`,
        `<div class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5 ${scheduled.length > 0 ? 'border-l-4 border-blue-400' : ''}"><div class="text-[11px] font-semibold uppercase tracking-[0.1em] text-neutral-400 mb-1">Scheduled</div><div class="text-2xl font-bold text-neutral-900">${scheduled.length}</div><div class="text-[11px] text-neutral-400">queued to send</div></div>`,
        `<div class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5 ${data.unsubCount > 0 ? 'border-l-4 border-red-300' : ''}"><div class="text-[11px] font-semibold uppercase tracking-[0.1em] text-neutral-400 mb-1">Unsubscribes</div><div class="text-2xl font-bold text-neutral-900">${data.unsubCount}</div><div class="text-[11px] text-neutral-400">total opted out</div></div>`,
      ].join('');

      const wrap = document.getElementById('campaigns-list')!;
      if (!campaigns.length) {
        wrap.innerHTML = '<div class="px-6 py-12 text-center text-neutral-400 text-sm">No campaigns yet. Click "New Campaign" to get started.</div>';
        return;
      }
      wrap.innerHTML = `<table class="min-w-full text-sm"><thead><tr class="border-b border-neutral-100 text-xs font-semibold text-neutral-500 uppercase tracking-wide">
        <th class="px-5 py-3 text-left">Campaign</th>
        <th class="px-5 py-3 text-left hidden md:table-cell">Audience</th>
        <th class="px-5 py-3 text-center">Status</th>
        <th class="px-5 py-3 text-right hidden md:table-cell">Sent</th>
        <th class="px-5 py-3 text-right hidden md:table-cell">Errors</th>
        <th class="px-5 py-3 text-left hidden lg:table-cell">Date</th>
        <th class="px-5 py-3 text-right">Actions</th>
      </tr></thead><tbody class="divide-y divide-neutral-50">${campaigns.map((c: any) => `
        <tr class="hover:bg-neutral-50 transition-colors">
          <td class="px-5 py-3.5">
            <div class="font-medium text-neutral-900">${esc(c.name)}</div>
            ${c.subject ? `<div class="text-xs text-neutral-400 truncate max-w-[200px]">${esc(c.subject)}</div>` : ''}
            <div class="flex gap-1 mt-0.5">${(c.channels||['email']).map((ch: string) => `<span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded-full bg-neutral-100 text-neutral-500">${ch}</span>`).join('')}</div>
          </td>
          <td class="px-5 py-3.5 hidden md:table-cell text-xs text-neutral-500">${esc(c.segment_label || c.segment_type)}</td>
          <td class="px-5 py-3.5 text-center">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold ${STATUS_CLS[c.status] || 'bg-neutral-100 text-neutral-600'}">${c.status}</span>
            ${c.status === 'scheduled' && c.scheduled_for ? `<div class="text-[10px] text-blue-500 mt-0.5">${new Date(c.scheduled_for).toLocaleString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'})}</div>` : ''}
          </td>
          <td class="px-5 py-3.5 text-right text-xs text-neutral-500 hidden md:table-cell">${c.sent_count != null ? `${c.sent_count}/${c.recipient_count||0}` : '—'}</td>
          <td class="px-5 py-3.5 text-right text-xs hidden md:table-cell ${c.error_count > 0 ? 'text-red-400' : 'text-neutral-300'}">${c.error_count || 0}</td>
          <td class="px-5 py-3.5 hidden lg:table-cell text-xs text-neutral-400">${c.sent_at ? new Date(c.sent_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : c.scheduled_for ? '⏰ Scheduled' : new Date(c.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric'})}</td>
          <td class="px-5 py-3.5 text-right">
            ${(c.status === 'draft' || c.status === 'scheduled') ? `<button class="del-campaign-btn text-xs text-red-400 hover:text-red-600 font-medium" data-id="${esc(c.id)}">Delete</button>` : ''}
          </td>
        </tr>`).join('')}</tbody></table>`;
      wrap.querySelectorAll('.del-campaign-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          if (!confirm('Delete this campaign?')) return;
          try { await apiFetch('admin-marketing', { params: { resource: 'campaign' }, method: 'DELETE', body: { id: (btn as HTMLElement).dataset.id } }); await loadData(); }
          catch (e: any) { alert(e.message); }
        });
      });
    } catch (e: any) {
      document.getElementById('campaigns-list')!.innerHTML = `<div class="px-6 py-6 text-red-500 text-sm">${e.message}</div>`;
    }
  }

  // ── Templates tab ──────────────────────────────────────────────────────────
  async function loadTemplates() {
    const wrap = document.getElementById('templates-list')!;
    try {
      const d = await apiFetch('admin-marketing', { params: { resource: 'templates' } });
      const templates = d.templates || [];
      wrap.innerHTML = `
        <div class="flex items-center justify-between px-5 py-3.5 border-b border-neutral-100">
          <h2 class="font-semibold text-neutral-900 text-sm">Email Templates</h2>
          <button id="new-template-btn" class="text-xs text-primary-600 hover:text-primary-700 font-medium">+ New template</button>
        </div>
        <div class="divide-y divide-neutral-50">
          ${templates.length ? templates.map((t: any) => `
          <div class="px-5 py-3.5 flex items-center justify-between gap-4 hover:bg-neutral-50">
            <div class="flex-1 min-w-0">
              <div class="font-medium text-neutral-900 text-sm">${esc(t.name)}</div>
              <div class="text-xs text-neutral-400 truncate">${esc(t.subject||'(no subject)')}</div>
            </div>
            <div class="flex gap-2 shrink-0">
              <button class="use-template-btn text-xs text-primary-600 hover:text-primary-700 font-medium" data-tid="${esc(t.id)}">Use</button>
              <button class="del-template-btn text-xs text-red-400 hover:text-red-600 font-medium" data-tid="${esc(t.id)}">Delete</button>
            </div>
          </div>`).join('') : '<div class="px-5 py-8 text-center text-neutral-400 text-sm">No custom templates. 5 starter templates are available when composing.</div>'}
        </div>`;
      document.getElementById('new-template-btn')?.addEventListener('click', async () => {
        const name = prompt('Template name:'); if (!name) return;
        const subject = prompt('Default subject (optional):') || '';
        await apiFetch('admin-marketing', { params: { resource: 'templates' }, method: 'POST', body: { name, subject, body_html: '', body_sms: '' } });
        loadTemplates(); allTemplates = [];
      });
      wrap.querySelectorAll('.use-template-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const t = templates.find((x: any) => x.id === (btn as HTMLElement).dataset.tid);
          if (t) { if (t.subject) (document.getElementById('c-subject') as HTMLInputElement).value = t.subject; if (t.body_html) (document.getElementById('c-body-html') as HTMLElement).innerHTML = t.body_html; openCompose(); updatePreview(); }
        });
      });
      wrap.querySelectorAll('.del-template-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          if (!confirm('Delete this template?')) return;
          await apiFetch('admin-marketing', { params: { resource: 'templates' }, method: 'DELETE', body: { id: (btn as HTMLElement).dataset.tid } });
          loadTemplates(); allTemplates = [];
        });
      });
    } catch (e: any) { wrap.innerHTML = `<div class="px-5 py-6 text-red-500 text-sm">${e.message}</div>`; }
  }

  // ── Audiences tab ──────────────────────────────────────────────────────────
  async function loadAudiences() {
    const wrap = document.getElementById('audiences-list')!;
    try {
      const d = await apiFetch('admin-marketing', { params: { resource: 'audiences' } });
      const audiences = d.audiences || [];
      wrap.innerHTML = `
        <div class="flex items-center justify-between px-5 py-3.5 border-b border-neutral-100">
          <h2 class="font-semibold text-neutral-900 text-sm">Saved Audiences</h2>
          <button id="new-audience-btn" class="text-xs text-primary-600 hover:text-primary-700 font-medium">+ New audience</button>
        </div>
        <table class="min-w-full text-sm"><thead><tr class="border-b border-neutral-100 text-xs font-semibold text-neutral-500 uppercase tracking-wide">
          <th class="px-5 py-3 text-left">Name</th>
          <th class="px-5 py-3 text-left">Segment Rule</th>
          <th class="px-5 py-3 text-left hidden md:table-cell">Description</th>
          <th class="px-5 py-3 text-right">Actions</th>
        </tr></thead><tbody class="divide-y divide-neutral-50">
        ${audiences.map((a: any) => `<tr class="hover:bg-neutral-50">
          <td class="px-5 py-3.5 font-medium text-neutral-900">${esc(a.name)}</td>
          <td class="px-5 py-3.5"><code class="text-xs bg-neutral-100 px-2 py-0.5 rounded">${esc(a.segment_type)}</code></td>
          <td class="px-5 py-3.5 text-xs text-neutral-400 hidden md:table-cell">${esc(a.description||'')}</td>
          <td class="px-5 py-3.5 text-right">
            <button class="use-audience-btn text-xs text-primary-600 hover:text-primary-700 font-medium mr-2" data-seg="${esc(a.segment_type)}" data-name="${esc(a.name)}">Use</button>
            ${!['all','recent_30','recent_60','lapsed_90','members','new_clients'].includes(a.segment_type) ? `<button class="del-audience-btn text-xs text-red-400 hover:text-red-600 font-medium" data-aid="${esc(a.id)}">Delete</button>` : ''}
          </td>
        </tr>`).join('')}
        </tbody></table>`;
      document.getElementById('new-audience-btn')?.addEventListener('click', async () => {
        const name = prompt('Audience name:'); if (!name) return;
        const segOpts = ['all','recent_30','recent_60','lapsed_90','members','new_clients'];
        const seg = prompt(`Segment rule (${segOpts.join(' | ')}):`);
        if (!seg || !segOpts.includes(seg)) { alert('Invalid segment type'); return; }
        const desc = prompt('Description (optional):') || '';
        await apiFetch('admin-marketing', { params: { resource: 'audiences' }, method: 'POST', body: { name, segment_type: seg, description: desc } });
        loadAudiences();
      });
      wrap.querySelectorAll('.use-audience-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const el = document.getElementById('c-segment') as HTMLSelectElement;
          if (el) el.value = (btn as HTMLElement).dataset.seg!;
          document.querySelector('input[name="rec-type"][value="segment"]')?.dispatchEvent(new Event('change'));
          (document.querySelector('input[name="rec-type"][value="segment"]') as HTMLInputElement).checked = true;
          openCompose(); previewSegment();
        });
      });
      wrap.querySelectorAll('.del-audience-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          if (!confirm('Delete this audience?')) return;
          await apiFetch('admin-marketing', { params: { resource: 'audiences' }, method: 'DELETE', body: { id: (btn as HTMLElement).dataset.aid } });
          loadAudiences();
        });
      });
    } catch (e: any) { wrap.innerHTML = `<div class="px-5 py-6 text-red-500 text-sm">${e.message}</div>`; }
  }

  // ── Unsubscribes tab ───────────────────────────────────────────────────────
  let unsubTimer: ReturnType<typeof setTimeout>;
  async function loadUnsubs(search = '') {
    const wrap = document.getElementById('unsubs-list')!;
    wrap.innerHTML = '<div class="px-5 py-6 text-center text-neutral-400 text-sm">Loading…</div>';
    try {
      const params: Record<string,string> = { resource: 'unsubscribes' };
      if (search) params.search = search;
      const d = await apiFetch('admin-marketing', { params });
      const unsubs = d.unsubscribes || [];
      if (!unsubs.length) { wrap.innerHTML = '<div class="px-5 py-8 text-center text-neutral-400 text-sm">No unsubscribes found.</div>'; return; }
      wrap.innerHTML = `<table class="min-w-full text-sm"><thead><tr class="border-b border-neutral-100 text-xs font-semibold text-neutral-500 uppercase tracking-wide">
        <th class="px-5 py-3 text-left">Email</th>
        <th class="px-5 py-3 text-center">Email</th>
        <th class="px-5 py-3 text-center">SMS</th>
        <th class="px-5 py-3 text-left hidden md:table-cell">Source</th>
        <th class="px-5 py-3 text-left hidden lg:table-cell">Date</th>
        <th class="px-5 py-3 text-right">Actions</th>
      </tr></thead><tbody class="divide-y divide-neutral-50">
      ${unsubs.map((u: any) => `<tr class="hover:bg-neutral-50">
        <td class="px-5 py-3 font-mono text-xs text-neutral-900">${esc(u.email||'')}</td>
        <td class="px-5 py-3 text-center">${u.unsub_email ? '🔴' : '🟢'}</td>
        <td class="px-5 py-3 text-center">${u.unsub_sms ? '🔴' : '🟢'}</td>
        <td class="px-5 py-3 text-xs text-neutral-400 hidden md:table-cell">${esc(u.source||'')}</td>
        <td class="px-5 py-3 text-xs text-neutral-400 hidden lg:table-cell">${new Date(u.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</td>
        <td class="px-5 py-3 text-right">
          <button class="resub-btn text-xs text-emerald-600 hover:text-emerald-700 font-medium" data-uid="${esc(u.id)}">Re-subscribe</button>
        </td>
      </tr>`).join('')}
      </tbody></table>`;
      wrap.querySelectorAll('.resub-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          await apiFetch('admin-marketing', { params: { resource: 'unsubscribes' }, method: 'PATCH', body: { id: (btn as HTMLElement).dataset.uid, resubscribe: true } });
          loadUnsubs(search);
        });
      });
    } catch (e: any) { wrap.innerHTML = `<div class="px-5 py-6 text-red-500 text-sm">${e.message}</div>`; }
  }

  document.getElementById('unsub-search')?.addEventListener('input', (e) => {
    clearTimeout(unsubTimer);
    unsubTimer = setTimeout(() => loadUnsubs((e.target as HTMLInputElement).value.trim()), 400);
  });

  document.getElementById('add-unsub-btn')?.addEventListener('click', async () => {
    const email = prompt('Email to add/update:'); if (!email) return;
    const reSubscribe = !confirm(`Click OK to UNSUBSCRIBE this email.\nClick Cancel to RE-SUBSCRIBE.`);
    await apiFetch('unsubscribe', { method: 'POST', body: { email, unsub_email: !reSubscribe, resubscribe: reSubscribe } });
    loadUnsubs();
  });

  loadData();
</script>
</AdminLayout>
