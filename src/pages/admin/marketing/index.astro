---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Marketing" activeNav="marketing">
  <div class="p-6 lg:p-8">

    <div class="mb-6 flex items-start justify-between gap-4 flex-wrap">
      <div>
        <h1 class="text-2xl font-serif font-semibold text-neutral-900">Marketing</h1>
        <p class="text-sm text-neutral-500 mt-0.5">Send promotional emails and SMS to your client list. Clients who have booked are automatically included.</p>
      </div>
      <button id="compose-btn"
        class="inline-flex items-center gap-2 px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-xl transition-colors shadow-sm shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        New Campaign
      </button>
    </div>

    <!-- Stats -->
    <div id="mkt-stats" class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6"></div>

    <!-- Tabs -->
    <div class="flex gap-1 mb-4 border-b border-neutral-200">
      <button class="mkt-tab active-tab px-4 py-2 text-sm font-medium border-b-2 border-primary-600 text-primary-700 -mb-px" data-tab="campaigns">Campaigns</button>
      <button class="mkt-tab px-4 py-2 text-sm font-medium text-neutral-500 hover:text-neutral-800 border-b-2 border-transparent -mb-px" data-tab="unsubs">Unsubscribes</button>
    </div>

    <!-- Campaigns tab -->
    <div id="tab-campaigns">
      <div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden">
        <div id="campaigns-list" class="overflow-x-auto">
          <div class="px-6 py-10 text-center text-neutral-400 text-sm">Loading…</div>
        </div>
      </div>
    </div>

    <!-- Unsubscribes tab -->
    <div id="tab-unsubs" class="hidden">
      <div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden">
        <div class="flex items-center justify-between px-5 py-3.5 border-b border-neutral-100">
          <h2 class="font-semibold text-neutral-900 text-sm">Unsubscribes</h2>
          <button id="add-unsub-btn" class="text-xs text-primary-600 hover:text-primary-700 font-medium">+ Add manually</button>
        </div>
        <div id="unsubs-list" class="overflow-x-auto">
          <div class="px-6 py-8 text-center text-neutral-400 text-sm">Loading…</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Compose slide-over -->
  <div id="compose-panel" class="hidden fixed inset-y-0 right-0 w-full sm:w-[560px] bg-white shadow-2xl border-l border-neutral-200 z-50 flex flex-col">
    <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-100 shrink-0">
      <h3 id="compose-title" class="font-semibold text-neutral-900">New Campaign</h3>
      <button id="compose-close" class="p-1.5 rounded-lg text-neutral-400 hover:bg-neutral-100 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div id="compose-body" class="flex-1 overflow-y-auto p-6 space-y-5">

      <div>
        <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Campaign Name *</label>
        <input id="c-name" type="text" placeholder="e.g. Summer Promotion 2026"
          class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Channels</label>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 cursor-pointer select-none">
            <input type="checkbox" id="ch-email" checked class="w-4 h-4 rounded border-neutral-300 accent-primary-600"/>
            <span class="text-sm font-medium text-neutral-700">Email</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer select-none">
            <input type="checkbox" id="ch-sms" class="w-4 h-4 rounded border-neutral-300 accent-primary-600"/>
            <span class="text-sm font-medium text-neutral-700">SMS</span>
          </label>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Audience Segment</label>
        <select id="c-segment" class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 outline-none bg-white">
          <option value="all">All Clients</option>
          <option value="recent_30">Recent — Last 30 days</option>
          <option value="recent_60">Recent — Last 60 days</option>
          <option value="lapsed_90">Lapsed — 90+ days since last visit</option>
          <option value="members">Active Members only</option>
          <option value="new_clients">New Clients (1 visit)</option>
        </select>
        <div id="segment-preview" class="mt-1.5 text-xs text-neutral-400">Estimating audience…</div>
      </div>

      <!-- Email fields -->
      <div id="email-fields">
        <div class="mb-4">
          <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Email Subject</label>
          <input id="c-subject" type="text" placeholder="Your exclusive offer from Bliss Dermacare"
            class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Email Body</label>
          <!-- Mini rich-text toolbar -->
          <div class="flex gap-1 mb-1 p-1.5 bg-neutral-50 rounded-t-lg border border-b-0 border-neutral-200">
            <button type="button" onclick="document.execCommand('bold')" class="px-2 py-0.5 text-xs font-bold rounded hover:bg-neutral-200 transition-colors" title="Bold">B</button>
            <button type="button" onclick="document.execCommand('italic')" class="px-2 py-0.5 text-xs italic rounded hover:bg-neutral-200 transition-colors" title="Italic">I</button>
            <button type="button" onclick="document.execCommand('underline')" class="px-2 py-0.5 text-xs underline rounded hover:bg-neutral-200 transition-colors" title="Underline">U</button>
            <span class="w-px bg-neutral-300 mx-0.5"></span>
            <button type="button" onclick="insertLink()" class="px-2 py-0.5 text-xs rounded hover:bg-neutral-200 transition-colors" title="Insert link">🔗</button>
            <button type="button" onclick="document.execCommand('formatBlock', false, 'h2')" class="px-2 py-0.5 text-xs font-semibold rounded hover:bg-neutral-200 transition-colors" title="Heading">H2</button>
            <button type="button" onclick="document.execCommand('insertUnorderedList')" class="px-2 py-0.5 text-xs rounded hover:bg-neutral-200 transition-colors" title="List">• List</button>
          </div>
          <div id="c-body-html" contenteditable="true"
            class="min-h-[180px] px-3 py-2.5 rounded-b-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"
            style="line-height:1.6"></div>
          <p class="text-xs text-neutral-400 mt-1.5">An unsubscribe link will be automatically added to the footer.</p>
        </div>
      </div>

      <!-- SMS field -->
      <div id="sms-fields" class="hidden">
        <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">SMS Message</label>
        <textarea id="c-body-sms" rows="3" maxlength="160" placeholder="Your message (160 chars max)…"
          class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none resize-none"></textarea>
        <div class="flex justify-between mt-1">
          <p class="text-xs text-neutral-400">"Reply STOP to unsubscribe" is added automatically.</p>
          <span id="sms-counter" class="text-xs text-neutral-400">0/160</span>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex gap-3 pt-2 border-t border-neutral-100">
        <button id="send-campaign-btn"
          class="flex-1 py-2.5 bg-primary-600 hover:bg-primary-700 disabled:opacity-50 text-white text-sm font-semibold rounded-xl transition-colors">
          Send Now
        </button>
        <button id="save-draft-btn"
          class="px-5 py-2.5 border border-neutral-300 text-neutral-600 hover:bg-neutral-50 text-sm font-medium rounded-xl transition-colors">
          Save Draft
        </button>
      </div>
      <div id="send-msg" class="text-xs text-center hidden"></div>

    </div>
  </div>
  <div id="compose-overlay" class="hidden fixed inset-0 bg-black/20 z-40"></div>

  <script>
    import { requireLogin, apiFetch, getRole } from '../../../scripts/adminAuth.js';
    requireLogin();
    const role = getRole(); void role;

    function esc(s: unknown) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    // Rich text link insert
    (window as any).insertLink = () => {
      const url = prompt('Enter URL:');
      if (url) document.execCommand('createLink', false, url);
    };

    // ── Tabs ─────────────────────────────────────────────────────────────────
    document.querySelectorAll('.mkt-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = (btn as HTMLElement).dataset.tab!;
        document.querySelectorAll('.mkt-tab').forEach(b => {
          b.classList.toggle('active-tab', (b as HTMLElement).dataset.tab === tab);
          b.classList.toggle('border-primary-600', (b as HTMLElement).dataset.tab === tab);
          b.classList.toggle('text-primary-700', (b as HTMLElement).dataset.tab === tab);
          b.classList.toggle('text-neutral-500', (b as HTMLElement).dataset.tab !== tab);
          b.classList.toggle('border-transparent', (b as HTMLElement).dataset.tab !== tab);
        });
        document.getElementById('tab-campaigns')?.classList.toggle('hidden', tab !== 'campaigns');
        document.getElementById('tab-unsubs')?.classList.toggle('hidden', tab !== 'unsubs');
        if (tab === 'unsubs') loadUnsubs();
      });
    });

    // ── Channel toggles ───────────────────────────────────────────────────────
    document.getElementById('ch-email')?.addEventListener('change', () => {
      document.getElementById('email-fields')?.classList.toggle('hidden', !(document.getElementById('ch-email') as HTMLInputElement).checked);
    });
    document.getElementById('ch-sms')?.addEventListener('change', () => {
      document.getElementById('sms-fields')?.classList.toggle('hidden', !(document.getElementById('ch-sms') as HTMLInputElement).checked);
    });

    // SMS counter
    document.getElementById('c-body-sms')?.addEventListener('input', (e) => {
      const len = (e.target as HTMLTextAreaElement).value.length;
      const el = document.getElementById('sms-counter')!;
      el.textContent = `${len}/160`;
      el.className = `text-xs ${len > 140 ? 'text-amber-600' : 'text-neutral-400'}`;
    });

    // ── Segment preview ───────────────────────────────────────────────────────
    let segPreviewTimer: ReturnType<typeof setTimeout>;
    async function previewSegment() {
      const seg = (document.getElementById('c-segment') as HTMLSelectElement).value;
      const el  = document.getElementById('segment-preview')!;
      el.textContent = 'Estimating…';
      try {
        const d = await apiFetch('admin-marketing', { params: { recipients: 'true', segment: seg } });
        el.textContent = `~${d.count} recipient${d.count !== 1 ? 's' : ''}${d.preview?.length ? ': ' + d.preview.map((p: any) => p.name || p.email).join(', ') + (d.count > d.preview.length ? '…' : '') : ''}`;
      } catch { el.textContent = 'Could not estimate'; }
    }
    document.getElementById('c-segment')?.addEventListener('change', () => {
      clearTimeout(segPreviewTimer);
      segPreviewTimer = setTimeout(previewSegment, 400);
    });

    // ── Compose panel ─────────────────────────────────────────────────────────
    function openCompose() {
      (document.getElementById('c-name')  as HTMLInputElement).value = '';
      (document.getElementById('c-subject')as HTMLInputElement).value = '';
      (document.getElementById('c-body-html') as HTMLElement).innerHTML = '';
      (document.getElementById('c-body-sms') as HTMLTextAreaElement).value = '';
      document.getElementById('send-msg')!.className = 'text-xs text-center hidden';
      document.getElementById('compose-panel')?.classList.remove('hidden');
      document.getElementById('compose-panel')?.classList.add('flex');
      document.getElementById('compose-overlay')?.classList.remove('hidden');
      previewSegment();
    }
    function closeCompose() {
      document.getElementById('compose-panel')?.classList.add('hidden');
      document.getElementById('compose-panel')?.classList.remove('flex');
      document.getElementById('compose-overlay')?.classList.add('hidden');
    }
    document.getElementById('compose-btn')?.addEventListener('click', openCompose);
    document.getElementById('compose-close')?.addEventListener('click', closeCompose);
    document.getElementById('compose-overlay')?.addEventListener('click', closeCompose);

    async function submitCampaign(action: 'send' | 'draft') {
      const name     = (document.getElementById('c-name')     as HTMLInputElement).value.trim();
      const subject  = (document.getElementById('c-subject')  as HTMLInputElement).value.trim();
      const bodyHtml = (document.getElementById('c-body-html') as HTMLElement).innerHTML.trim();
      const bodySms  = (document.getElementById('c-body-sms') as HTMLTextAreaElement).value.trim();
      const segment  = (document.getElementById('c-segment')  as HTMLSelectElement).value;
      const emailOn  = (document.getElementById('ch-email')   as HTMLInputElement).checked;
      const smsOn    = (document.getElementById('ch-sms')     as HTMLInputElement).checked;
      const msgEl    = document.getElementById('send-msg')!;

      if (!name) { msgEl.textContent = 'Campaign name is required.'; msgEl.className = 'text-xs text-center text-red-500'; return; }
      if (action === 'send') {
        if (emailOn && (!subject || !bodyHtml)) { msgEl.textContent = 'Email subject and body are required.'; msgEl.className = 'text-xs text-center text-red-500'; return; }
        if (smsOn && !bodySms) { msgEl.textContent = 'SMS message is required.'; msgEl.className = 'text-xs text-center text-red-500'; return; }
        if (!emailOn && !smsOn) { msgEl.textContent = 'Select at least one channel.'; msgEl.className = 'text-xs text-center text-red-500'; return; }
      }

      const btn = document.getElementById(action === 'send' ? 'send-campaign-btn' : 'save-draft-btn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = action === 'send' ? 'Sending…' : 'Saving…';
      msgEl.textContent = action === 'send' ? 'Sending — this may take a moment for large lists…' : '';
      msgEl.className = 'text-xs text-center text-neutral-400';
      if (action === 'send') msgEl.classList.remove('hidden');

      try {
        const result = await apiFetch('admin-marketing', {
          method: 'POST',
          body: {
            name, subject, body_html: bodyHtml, body_sms: bodySms,
            channels: [...(emailOn ? ['email'] : []), ...(smsOn ? ['sms'] : [])],
            segment_type: segment, action,
          },
        });
        if (action === 'send') {
          msgEl.textContent = `✓ Sent to ${result.sentCount} of ${result.total} recipients.`;
          msgEl.className = 'text-xs text-center text-emerald-600';
          setTimeout(() => { closeCompose(); loadData(); }, 2500);
        } else {
          closeCompose(); loadData();
        }
      } catch (err: any) {
        msgEl.textContent = `Error: ${err.message}`;
        msgEl.className = 'text-xs text-center text-red-500';
        btn.disabled = false; btn.textContent = action === 'send' ? 'Send Now' : 'Save Draft';
      }
    }
    document.getElementById('send-campaign-btn')?.addEventListener('click', () => submitCampaign('send'));
    document.getElementById('save-draft-btn')?.addEventListener('click', () => submitCampaign('draft'));

    // ── Load data ─────────────────────────────────────────────────────────────
    async function loadData() {
      try {
        const data = await apiFetch('admin-marketing', {});
        const campaigns = data?.campaigns || [];

        // Stats
        const sent  = campaigns.filter((c: any) => c.status === 'sent');
        const drafts = campaigns.filter((c: any) => c.status === 'draft');
        const totalSent = sent.reduce((s: number, c: any) => s + (c.sent_count || 0), 0);
        document.getElementById('mkt-stats')!.innerHTML = [
          `<div class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5"><div class="text-[11px] font-semibold uppercase tracking-[0.1em] text-neutral-400 mb-1">Total Campaigns</div><div class="text-2xl font-bold text-neutral-900">${campaigns.length}</div></div>`,
          `<div class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5"><div class="text-[11px] font-semibold uppercase tracking-[0.1em] text-neutral-400 mb-1">Emails Sent</div><div class="text-2xl font-bold text-neutral-900">${totalSent.toLocaleString()}</div></div>`,
          `<div class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5"><div class="text-[11px] font-semibold uppercase tracking-[0.1em] text-neutral-400 mb-1">Drafts</div><div class="text-2xl font-bold text-neutral-900">${drafts.length}</div></div>`,
          `<div class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5 ${data.unsubCount > 0 ? 'border-l-4 border-red-300' : ''}"><div class="text-[11px] font-semibold uppercase tracking-[0.1em] text-neutral-400 mb-1">Unsubscribes</div><div class="text-2xl font-bold text-neutral-900">${data.unsubCount}</div></div>`,
        ].join('');

        // Campaigns table
        const SEGMENT_LABELS: Record<string, string> = {
          all: 'All Clients', recent_30: 'Last 30 days', recent_60: 'Last 60 days',
          lapsed_90: 'Lapsed 90d', members: 'Members', new_clients: 'New Clients',
        };
        const STATUS_CLS: Record<string, string> = {
          sent: 'bg-emerald-100 text-emerald-700', draft: 'bg-neutral-100 text-neutral-600',
          sending: 'bg-amber-100 text-amber-700',
        };
        const wrap = document.getElementById('campaigns-list')!;
        if (!campaigns.length) {
          wrap.innerHTML = '<div class="px-6 py-12 text-center text-neutral-400 text-sm">No campaigns yet. Click "New Campaign" to get started.</div>';
        } else {
          wrap.innerHTML = `<table class="min-w-full text-sm"><thead><tr class="border-b border-neutral-100 text-xs font-semibold text-neutral-500 uppercase tracking-wide">
            <th class="px-5 py-3 text-left">Name</th>
            <th class="px-5 py-3 text-left hidden md:table-cell">Segment</th>
            <th class="px-5 py-3 text-center">Status</th>
            <th class="px-5 py-3 text-right hidden md:table-cell">Sent</th>
            <th class="px-5 py-3 text-left hidden lg:table-cell">Date</th>
            <th class="px-5 py-3 text-right">Actions</th>
          </tr></thead><tbody class="divide-y divide-neutral-50">${campaigns.map((c: any) => `
            <tr class="hover:bg-neutral-50 transition-colors">
              <td class="px-5 py-3.5">
                <div class="font-medium text-neutral-900">${esc(c.name)}</div>
                ${c.subject ? `<div class="text-xs text-neutral-400 truncate max-w-[200px]">${esc(c.subject)}</div>` : ''}
              </td>
              <td class="px-5 py-3.5 hidden md:table-cell text-xs text-neutral-500">${SEGMENT_LABELS[c.segment_type] || c.segment_type}</td>
              <td class="px-5 py-3.5 text-center">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold ${STATUS_CLS[c.status] || 'bg-neutral-100 text-neutral-600'}">${c.status}</span>
              </td>
              <td class="px-5 py-3.5 text-right text-xs text-neutral-500 hidden md:table-cell">${c.sent_count || '—'}</td>
              <td class="px-5 py-3.5 hidden lg:table-cell text-xs text-neutral-400">${c.sent_at ? new Date(c.sent_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : new Date(c.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric'})}</td>
              <td class="px-5 py-3.5 text-right">
                ${c.status === 'draft' ? `<button class="del-campaign-btn text-xs text-red-400 hover:text-red-600 font-medium" data-id="${esc(c.id)}">Delete</button>` : ''}
              </td>
            </tr>`).join('')}</tbody></table>`;
          wrap.querySelectorAll('.del-campaign-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
              if (!confirm('Delete this draft campaign?')) return;
              try {
                await apiFetch('admin-marketing', { method: 'DELETE', body: { id: (btn as HTMLElement).dataset.id } });
                await loadData();
              } catch (e: any) { alert(e.message); }
            });
          });
        }
      } catch (err: any) {
        document.getElementById('campaigns-list')!.innerHTML = `<div class="px-6 py-6 text-red-500 text-sm">${err.message}</div>`;
      }
    }

    async function loadUnsubs() {
      try {
        const { data } = await apiFetch('admin-marketing', {}) as any;
        void data;
        // Fetch unsubscribes directly
        const resp = await fetch('/.netlify/functions/unsubscribe', {
          headers: { Authorization: `Bearer ${localStorage.getItem('bliss_admin_token')}` }
        });
        // Since unsubscribe GET is public (token-based), we can't list them from here
        // We'll show a placeholder note
        document.getElementById('unsubs-list')!.innerHTML =
          '<div class="px-6 py-6 text-neutral-400 text-sm text-center">Unsubscribe management — view and export from the Supabase dashboard under the <code>marketing_unsubscribes</code> table.<br/><br/>Use the "+ Add manually" button above to add/re-subscribe clients.</div>';
      } catch {}
    }

    document.getElementById('add-unsub-btn')?.addEventListener('click', async () => {
      const email = prompt('Email address to unsubscribe (leave blank to skip):');
      if (!email) return;
      const reSubscribe = confirm(`Add as UNSUBSCRIBED?\nOK = Unsubscribe, Cancel = Re-subscribe`);
      try {
        await apiFetch('unsubscribe', { method: 'POST', body: { email, unsub_email: reSubscribe, resubscribe: !reSubscribe } });
        alert(reSubscribe ? 'Added to unsubscribe list.' : 'Re-subscribed.');
        loadUnsubs();
      } catch (e: any) { alert(e.message); }
    });

    loadData();
  </script>

  <style>
    [contenteditable="true"]:empty::before { content: attr(placeholder); color: #9ca3af; }
    .active-tab { border-bottom-color: #7c3aed !important; color: #6d28d9 !important; font-weight: 600; }
  </style>

</AdminLayout>
