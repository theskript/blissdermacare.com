---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Dashboard" activeNav="dashboard">

  <div class="p-6 lg:p-8">

    <!-- Page header -->
    <div class="flex items-start justify-between gap-4 mb-6 flex-wrap">
      <div>
        <h1 class="text-2xl font-serif font-semibold text-neutral-900">Dashboard</h1>
        <p id="today-label" class="text-sm text-neutral-500 mt-1">Loading…</p>
      </div>
      <a href="/admin/new-appointment"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-xl transition-colors shadow-sm shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        New Appointment
      </a>
    </div>

    <!-- ⚡ Needs-action inbox -->
    <div id="inbox-section" class="hidden mb-5 space-y-2">
    </div>

    <!-- 2-col grid: appointments (left) + pre-service forms (right) -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-4">

      <!-- Appointments column -->
      <div class="lg:col-span-3 space-y-4">

        <!-- Today's appointments -->
        <div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden">
          <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-100">
            <h2 class="font-semibold text-neutral-900">Today's Schedule</h2>
            <div class="flex items-center gap-3">
              <span id="today-count-badge" class="hidden text-xs bg-primary-100 text-primary-700 font-bold px-2.5 py-0.5 rounded-full"></span>
              <a href="/admin/calendar" class="text-xs text-primary-600 hover:text-primary-700 font-medium">Calendar →</a>
            </div>
          </div>
          <div id="today-list" class="divide-y divide-neutral-100">
            <div class="px-6 py-8 text-center text-neutral-400 text-sm">Loading…</div>
          </div>
        </div>

        <!-- Upcoming (next 7 days) -->
        <div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden">
          <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-100">
            <h2 class="font-semibold text-neutral-900">Next 7 Days</h2>
            <span id="week-count-badge" class="hidden text-xs bg-neutral-100 text-neutral-600 font-bold px-2.5 py-0.5 rounded-full"></span>
          </div>
          <div id="upcoming-list" class="divide-y divide-neutral-100">
            <div class="px-6 py-10 text-center text-neutral-400 text-sm">Loading…</div>
          </div>
        </div>

      </div>

      <!-- Pre-service forms column -->
      <div class="lg:col-span-2 space-y-4">

        <!-- Today's PSF submissions -->
        <div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden">
          <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-100">
            <h2 class="font-semibold text-neutral-900">Forms Today</h2>
            <div class="flex items-center gap-3">
              <span id="psf-today-badge" class="hidden text-xs bg-violet-100 text-violet-700 font-bold px-2.5 py-0.5 rounded-full"></span>
              <a href="/admin/pre-service-forms" class="text-xs text-primary-600 hover:text-primary-700 font-medium">View all →</a>
            </div>
          </div>
          <div id="psf-today-list" class="divide-y divide-neutral-100 max-h-72 overflow-y-auto">
            <div class="px-6 py-8 text-center text-neutral-400 text-sm">Loading…</div>
          </div>
        </div>

        <!-- Recent PSF submissions -->
        <div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden">
          <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-100">
            <h2 class="font-semibold text-neutral-900">Unread Forms</h2>
            <span id="psf-recent-badge" class="hidden text-xs bg-violet-100 text-violet-700 font-bold px-2.5 py-0.5 rounded-full"></span>
          </div>
          <div id="psf-recent-list" class="divide-y divide-neutral-100 max-h-96 overflow-y-auto">
            <div class="px-6 py-8 text-center text-neutral-400 text-sm">Loading…</div>
          </div>
        </div>

      </div>

    </div>

  </div>

  <!-- Appointment detail slide-over -->
  <div id="detail-panel" class="hidden fixed inset-y-0 right-0 w-full sm:w-[440px] bg-white shadow-2xl border-l border-neutral-200 z-50 flex flex-col">
    <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-100">
      <h3 class="font-semibold text-neutral-900">Appointment Details</h3>
      <button id="close-detail" class="p-1.5 rounded-lg text-neutral-400 hover:bg-neutral-100 hover:text-neutral-600 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <div id="detail-content" class="flex-1 overflow-y-auto p-6"></div>
  </div>
  <div id="detail-overlay" class="hidden fixed inset-0 bg-black/20 z-40"></div>

  <script>
    import { requireLogin, apiFetch, getRole, formatDate } from '../../scripts/adminAuth.js';
    requireLogin();

    const role = getRole();

    // ── Date helpers ──────────────────────────────────────────────────────────
    function todayStr() {
      return new Date().toISOString().split('T')[0];
    }
    function addDays(dateStr: string, days: number) {
      const d = new Date(dateStr + 'T12:00:00');
      d.setDate(d.getDate() + days);
      return d.toISOString().split('T')[0];
    }
    function fullDateLabel(dateStr: string) {
      return new Date(dateStr + 'T12:00:00').toLocaleDateString('en-US', {
        weekday: 'long', month: 'long', day: 'numeric', year: 'numeric',
      });
    }

    const STATUS_COLORS: Record<string, string> = {
      'Confirmed':            'bg-emerald-100 text-emerald-700',
      'Completed':            'bg-blue-100 text-blue-700',
      'Pending Confirmation': 'bg-orange-100 text-orange-700',
      'Cancelled':            'bg-red-100 text-red-700',
      'No-Show':              'bg-purple-100 text-purple-700',
    };

    function statusBadge(status: string) {
      const cls = STATUS_COLORS[status] || 'bg-neutral-100 text-neutral-600';
      return `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold ${cls}">${status || '—'}</span>`;
    }

    // ── Render appointment row ─────────────────────────────────────────────
    function apptRow(rec: any, showDate = false) {
      const f = rec.fields;
      let timeMain = f['Time'] || '—';
      let timePeriod = '';
      const tm = (f['Time'] || '').match(/^(\d+:\d+)\s*(AM|PM)?$/i);
      if (tm) { timeMain = tm[1]; timePeriod = (tm[2] || '').toUpperCase(); }

      const priceHtml = role === 'owner' && f['Price'] != null
        ? `<div class="text-sm font-bold text-primary-700 shrink-0">$${Number(f['Price']).toFixed(0)}</div>`
        : '';

      const noPsfBadge = f['hasPSF'] === false
        ? `<span class="ml-1.5 inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-700 border border-amber-200" title="No pre-service form on file">No PSF</span>`
        : '';

      return `
        <div class="px-6 py-4 hover:bg-neutral-50 transition-colors cursor-pointer appt-row flex items-center gap-4" data-id="${rec.id}" data-rec='${JSON.stringify(rec).replace(/'/g, "&#39;")}'>
          ${showDate
            ? `<div class="text-center w-16 shrink-0">
                <div class="text-[10px] font-bold text-neutral-400 uppercase tracking-wide">${new Date((f['Date'] || '') + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'short' })}</div>
                <div class="text-xs font-semibold text-neutral-500">${new Date((f['Date'] || '') + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</div>
                <div class="text-sm font-bold text-neutral-700 leading-tight">${timeMain}</div>
                <div class="text-xs text-neutral-400">${timePeriod}</div>
              </div>`
            : `<div class="text-center w-14 shrink-0">
                <div class="text-xl font-bold text-neutral-900 leading-tight">${timeMain}</div>
                <div class="text-xs text-neutral-400">${timePeriod}</div>
              </div>`
          }
          <div class="w-px bg-neutral-100 self-stretch shrink-0"></div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap mb-0.5">
              <span class="text-sm font-semibold text-neutral-900">${f['Client Name'] || 'Unknown'}</span>
              ${statusBadge(f['Status'])}
              ${f['Pending Payment'] ? '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700">Unpaid</span>' : ''}
              ${noPsfBadge}
            </div>
            <div class="text-xs text-neutral-500 truncate">${(f['Services'] || '—').substring(0, 70)}${(f['Services'] || '').length > 70 ? '…' : ''}</div>
            ${f['Client Phone'] ? `<div class="text-xs text-neutral-400 mt-0.5">${f['Client Phone']}</div>` : ''}
          </div>
          ${priceHtml}
          <svg class="w-4 h-4 text-neutral-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>`;
    }

    function esc(s: unknown) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    // ── PSF row ───────────────────────────────────────────────────────────────
    function psfRow(form: any) {
      const isUnread = !form.read_at;
      const submitted = new Date(form.created_at);
      const diffMs = Date.now() - submitted.getTime();
      const diffH  = Math.floor(diffMs / 3600000);
      const diffM  = Math.floor(diffMs / 60000);
      const timeAgo = diffH >= 24
        ? submitted.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
        : diffH > 0 ? `${diffH}h ago` : diffM > 0 ? `${diffM}m ago` : 'just now';
      const service = (form.service_requested || '').substring(0, 55) + ((form.service_requested || '').length > 55 ? '…' : '');
      const apptDate = form.appointment_date
        ? new Date(form.appointment_date + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
        : '';
      const apptTime = (() => {
        const t = form.appointment_time || '';
        const m = t.match(/^(\d{1,2}):(\d{2})/);
        if (!m) return t;
        let h = parseInt(m[1], 10); const min = m[2];
        const period = h >= 12 ? 'PM' : 'AM';
        if (h > 12) h -= 12; else if (h === 0) h = 12;
        return `${h}:${min} ${period}`;
      })();
      return `
        <div class="px-5 py-3.5 hover:bg-neutral-50 transition-colors psf-row${isUnread ? ' psf-unread' : ''}" data-psf-id="${esc(form.id)}">
          <div class="flex items-start gap-2.5">
            <span class="mt-1.5 w-2 h-2 rounded-full shrink-0 ${isUnread ? 'bg-violet-500' : 'bg-transparent'}"></span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-sm font-semibold text-neutral-900">${esc(form.name || '—')}</span>
                ${isUnread ? '<span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-violet-100 text-violet-700">New</span>' : ''}
              </div>
              ${service ? `<div class="text-xs text-neutral-500 mt-0.5 truncate">${esc(service)}</div>` : ''}
              ${apptDate ? `<div class="text-xs text-neutral-400 mt-0.5">Appt ${apptDate}${apptTime ? ' · ' + esc(apptTime) : ''}</div>` : ''}
            </div>
            <div class="text-xs text-neutral-400 shrink-0 mt-0.5">${timeAgo}</div>
          </div>
        </div>`;
    }

    // ── Detail panel ─────────────────────────────────────────────────────────
    let currentRec: any = null;

    function openDetail(rec: any) {
      currentRec = rec;
      const f = rec.fields;
      const panel = document.getElementById('detail-panel');
      const overlay = document.getElementById('detail-overlay');
      const content = document.getElementById('detail-content');

      const canDelete = role === 'owner';
      const statusOptions = ['Pending Confirmation', 'Confirmed', 'Completed', 'Cancelled', 'No-Show'];

      content!.innerHTML = `
        <div class="space-y-5">
          <div>
            <div class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Client</div>
            <div class="text-base font-semibold text-neutral-900">${f['Client Name'] || '—'}</div>
            <div class="text-sm text-neutral-500">${f['Client Email'] || ''}</div>
            <div class="text-sm text-neutral-500">${f['Client Phone'] || ''}</div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <div class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Date</div>
              <div class="text-sm text-neutral-800">${formatDate(f['Date'])}</div>
            </div>
            <div>
              <div class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Time</div>
              <div class="text-sm text-neutral-800">${f['Time'] || '—'}</div>
            </div>
          </div>
          <div>
            <div class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Services</div>
            <div class="text-sm text-neutral-800">${f['Services'] || '—'}</div>
          </div>
          ${role === 'owner' && f['Price'] != null ? `
          <div class="grid grid-cols-2 gap-4">
            <div>
              <div class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Price</div>
              <div class="text-sm font-semibold text-primary-700">$${Number(f['Price']).toFixed(2)}</div>
            </div>
            <div>
              <div class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Payment</div>
              ${f['Payment Method'] === 'stripe'
                ? '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-700">Stripe (Online)</span>'
                : f['Payment Method'] === 'in_person'
                  ? '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">In Person</span>'
                  : '<span class="text-sm text-neutral-500">—</span>'}
            </div>
          </div>` : ''}
          <div>
            <div class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Source</div>
            <div class="text-sm text-neutral-800">${f['Source'] || 'Website'}</div>
          </div>
          ${f['Notes'] ? `
          <div>
            <div class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Client Notes</div>
            <div class="text-sm text-neutral-800 bg-neutral-50 rounded-lg p-3">${f['Notes']}</div>
          </div>` : ''}
          <div>
            <div class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-2">Status</div>
            <select id="status-select" class="w-full px-3 py-2 rounded-lg border border-neutral-300 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none">
              ${statusOptions.map(s => `<option value="${s}" ${f['Status'] === s ? 'selected' : ''}>${s}</option>`).join('')}
            </select>
          </div>
          <div>
            <label class="flex items-center gap-2 cursor-pointer select-none">
              <input type="checkbox" id="pending-payment-check" ${f['Pending Payment'] ? 'checked' : ''} class="w-4 h-4 rounded border-neutral-300 accent-amber-500"/>
              <span class="text-sm font-medium text-neutral-700">Pending Payment (Unpaid)</span>
            </label>
          </div>
          <div>
            <div class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-2">Internal Notes</div>
            <textarea id="internal-notes" rows="3" placeholder="Add staff notes…"
              class="w-full px-3 py-2 rounded-lg border border-neutral-300 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none resize-none">${f['Internal Notes'] || ''}</textarea>
          </div>
          <div class="flex gap-3 pt-2">
            <button id="save-detail-btn" class="flex-1 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-xl transition-colors">Save Changes</button>
            ${canDelete ? `<button id="delete-detail-btn" class="py-2.5 px-4 border border-red-200 text-red-500 hover:bg-red-50 text-sm font-semibold rounded-xl transition-colors">Delete</button>` : ''}
          </div>
          <div id="detail-msg" class="text-xs text-center text-neutral-400"></div>

          <!-- Send Reminder -->
          <div class="border-t border-neutral-100 pt-5 mt-2">
            <div class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-3">Send Reminder</div>
            <div class="space-y-3">
              <div class="flex gap-2">
                <select id="reminder-channel" class="flex-1 px-3 py-2 rounded-lg border border-neutral-300 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none">
                  <option value="sms">SMS only</option>
                  <option value="email">Email only</option>
                  <option value="both">SMS + Email</option>
                </select>
                <button id="fill-template-btn" class="px-3 py-2 text-xs border border-neutral-300 rounded-lg text-neutral-600 hover:bg-neutral-50 transition-colors whitespace-nowrap">Use Template</button>
              </div>
              <details class="text-xs">
                <summary class="cursor-pointer text-neutral-400 hover:text-neutral-600 select-none py-1">Override recipient (optional)</summary>
                <div class="grid grid-cols-2 gap-2 mt-2">
                  <input id="reminder-override-phone" type="tel" placeholder="Alt phone (e.g. 8135550000)"
                    class="px-2.5 py-2 rounded-lg border border-neutral-300 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none" />
                  <input id="reminder-override-email" type="email" placeholder="Alt email address"
                    class="px-2.5 py-2 rounded-lg border border-neutral-300 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none" />
                </div>
                <p class="text-neutral-400 mt-1.5 leading-snug">Leave blank to use the client's stored contact info. Filled values take priority.</p>
              </details>
              <input id="reminder-subject" type="text" placeholder="Email subject" value="Your Appointment Reminder — Bliss Dermacare"
                class="w-full px-3 py-2 rounded-lg border border-neutral-300 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none" />
              <textarea id="reminder-message" rows="4" placeholder="Message to client…"
                class="w-full px-3 py-2 rounded-lg border border-neutral-300 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none resize-none"></textarea>
              <button id="send-reminder-btn" class="w-full py-2.5 border border-primary-400 text-primary-600 hover:bg-primary-50 text-sm font-semibold rounded-xl transition-colors">Send Reminder</button>
              <div id="reminder-msg" class="text-xs text-center text-neutral-400 hidden"></div>
            </div>
          </div>
        </div>`;

      panel?.classList.remove('hidden');
      panel?.classList.add('flex');
      overlay?.classList.remove('hidden');

      document.getElementById('save-detail-btn')?.addEventListener('click', saveDetail);
      document.getElementById('delete-detail-btn')?.addEventListener('click', deleteDetail);

      // Fill reminder template
      document.getElementById('fill-template-btn')?.addEventListener('click', () => {
        const dateLabel = f['Date'] ? new Date(f['Date'] + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) : 'your scheduled date';
        const template =
          `Hi ${(f['Client Name'] || 'there').split(' ')[0]}! 💗 This is a friendly reminder from Bliss Dermacare — ` +
          `you have an appointment on ${dateLabel} at ${f['Time'] || 'your scheduled time'} ` +
          `for ${f['Services'] || 'your appointment'}. ` +
          `We're at 8905 Regents Park Dr, Tampa, FL 33647. ` +
          `Questions? Call or text (609) 366-0857. See you soon!`;
        (document.getElementById('reminder-message') as HTMLTextAreaElement).value = template;
      });

      // Send reminder
      document.getElementById('send-reminder-btn')?.addEventListener('click', async () => {
        const channel       = (document.getElementById('reminder-channel') as HTMLSelectElement).value;
        const message       = (document.getElementById('reminder-message') as HTMLTextAreaElement).value.trim();
        const subject       = (document.getElementById('reminder-subject') as HTMLInputElement).value.trim();
        const overridePhone = (document.getElementById('reminder-override-phone') as HTMLInputElement)?.value.trim() || '';
        const overrideEmail = (document.getElementById('reminder-override-email') as HTMLInputElement)?.value.trim() || '';
        const msgEl         = document.getElementById('reminder-msg')!;
        if (!message) { msgEl.textContent = 'Please enter a message.'; msgEl.classList.remove('hidden', 'text-green-600', 'text-red-500'); msgEl.classList.add('text-red-500'); return; }
        const btn = document.getElementById('send-reminder-btn') as HTMLButtonElement;
        btn.disabled = true; btn.textContent = 'Sending…';
        try {
          const result = await apiFetch('admin-send-reminder', { method: 'POST', body: { appointmentId: rec.id, channel, message, subject, overridePhone, overrideEmail } });
          const parts: string[] = [];
          if (result.smsSent)   parts.push('SMS sent');
          if (result.emailSent) parts.push('Email sent');
          if (result.errors?.length) parts.push(...result.errors);
          msgEl.textContent = parts.join(' · ') || 'Sent';
          msgEl.classList.remove('hidden', 'text-red-500');
          msgEl.classList.add('text-green-600');
        } catch (err: any) {
          msgEl.textContent = `Error: ${err.message}`;
          msgEl.classList.remove('hidden', 'text-green-600');
          msgEl.classList.add('text-red-500');
        } finally {
          btn.disabled = false; btn.textContent = 'Send Reminder';
          msgEl.classList.remove('hidden');
        }
      });
    }

    async function saveDetail() {
      const status         = (document.getElementById('status-select')       as HTMLSelectElement)?.value;
      const pendingPayment = (document.getElementById('pending-payment-check')as HTMLInputElement)?.checked;
      const notes          = (document.getElementById('internal-notes')       as HTMLTextAreaElement)?.value;
      const msg = document.getElementById('detail-msg');
      try {
        await apiFetch('admin-appointments', {
          method: 'PATCH',
          body: { id: currentRec.id, fields: { Status: status, 'Pending Payment': pendingPayment, 'Internal Notes': notes } },
        });
        if (msg) msg.textContent = '✓ Saved';
        currentRec.fields['Status']          = status;
        currentRec.fields['Pending Payment'] = pendingPayment;
        currentRec.fields['Internal Notes']  = notes;
        loadData(); // refresh list
      } catch (err: any) {
        if (msg) msg.textContent = `Error: ${err.message}`;
      }
    }

    async function deleteDetail() {
      if (!confirm(`Delete appointment for ${currentRec.fields['Client Name']}? This cannot be undone.`)) return;
      try {
        await apiFetch('admin-appointments', { method: 'DELETE', body: { id: currentRec.id } });
        closeDetail();
        loadData();
      } catch (err: any) {
        alert(`Delete failed: ${err.message}`);
      }
    }

    function closeDetail() {
      document.getElementById('detail-panel')?.classList.add('hidden');
      document.getElementById('detail-panel')?.classList.remove('flex');
      document.getElementById('detail-overlay')?.classList.add('hidden');
      currentRec = null;
    }

    document.getElementById('close-detail')?.addEventListener('click', closeDetail);
    document.getElementById('detail-overlay')?.addEventListener('click', closeDetail);

    // ── Load data ─────────────────────────────────────────────────────────────
    async function loadData() {
      const today = todayStr();
      const weekEnd = addDays(today, 7);

      document.getElementById('today-label')!.textContent = fullDateLabel(today);

      const since48h = new Date(Date.now() - 48 * 3600 * 1000).toISOString();

      const requests: Promise<any>[] = [
        apiFetch('admin-appointments', { params: { date: today } }),
        apiFetch('admin-appointments', { params: { startDate: addDays(today, 1), endDate: weekEnd } }),
        apiFetch('admin-appointments', { params: { status: 'Pending Confirmation' } }),
        apiFetch('admin-pre-service-forms', { params: { unread: 'true', limit: '100' } }).catch(() => null),
        apiFetch('admin-pre-service-forms', { params: { limit: '30' } }).catch(() => null),
      ];

      const [todayData, weekData, pendingData, unreadPSFData, psfData] = await Promise.all(requests);

      const allPSFs    = (psfData?.records || []) as any[];
      const todayLocal = new Date().toLocaleDateString();
      const todayPSFs  = allPSFs.filter((f: any) => f.created_at && new Date(f.created_at).toLocaleDateString() === todayLocal);
      const unreadPSFs = (unreadPSFData?.records || []) as any[];

      const todayRecs   = todayData?.records   || [];
      const weekRecs    = weekData?.records    || [];
      const pendingRecs = pendingData?.records || [];
      const unreadPSFs  = unreadPSFData?.records || [];

      // ── Inbox: needs-attention alerts ──────────────────────────────────────
      const inboxEl = document.getElementById('inbox-section')!;
      const inboxItems: string[] = [];

      if (pendingRecs.length > 0) {
        inboxItems.push(`
          <a href="/admin/appointments" class="flex items-center gap-4 bg-amber-50 border border-amber-200 rounded-2xl px-5 py-3.5 hover:bg-amber-100 transition-colors">
            <div class="w-9 h-9 rounded-full bg-amber-200 flex items-center justify-center shrink-0">
              <span class="text-amber-800 text-base font-bold">${pendingRecs.length}</span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-semibold text-amber-900">Booking request${pendingRecs.length !== 1 ? 's' : ''} awaiting confirmation</div>
              <div class="text-xs text-amber-700 truncate">${pendingRecs.map((r: any) => r.fields['Client Name'] || '?').slice(0, 4).join(', ')}${pendingRecs.length > 4 ? ` +${pendingRecs.length - 4} more` : ''}</div>
            </div>
            <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>`);
      }

      if (unreadPSFs.length > 0) {
        inboxItems.push(`
          <a href="/admin/pre-service-forms" class="flex items-center gap-4 bg-blue-50 border border-blue-200 rounded-2xl px-5 py-3.5 hover:bg-blue-100 transition-colors">
            <div class="w-9 h-9 rounded-full bg-blue-200 flex items-center justify-center shrink-0">
              <span class="text-blue-800 text-base font-bold">${unreadPSFs.length}</span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-semibold text-blue-900">${unreadPSFs.length} unread pre-service form${unreadPSFs.length !== 1 ? 's' : ''}</div>
              <div class="text-xs text-blue-700 truncate">${unreadPSFs.map((r: any) => r.name || '?').slice(0, 4).join(', ')}${unreadPSFs.length > 4 ? ` +${unreadPSFs.length - 4} more` : ''}</div>
            </div>
            <svg class="w-4 h-4 text-blue-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>`);
      }

      if (inboxItems.length > 0) {
        inboxEl.innerHTML = inboxItems.join('');
        inboxEl.classList.remove('hidden');
      } else {
        inboxEl.classList.add('hidden');
      }

      // Count badges
      const todayBadge = document.getElementById('today-count-badge')!;
      const weekBadge  = document.getElementById('week-count-badge')!;
      if (todayRecs.length > 0) { todayBadge.textContent = String(todayRecs.length); todayBadge.classList.remove('hidden'); }
      if (weekRecs.length > 0)  { weekBadge.textContent  = `${weekRecs.length} upcoming`; weekBadge.classList.remove('hidden'); }

      // Today list
      const todayEl = document.getElementById('today-list')!;
      if (todayRecs.length === 0) {
        todayEl.innerHTML = `
          <div class="px-6 py-10 text-center">
            <div class="text-neutral-400 text-sm mb-3">No appointments scheduled for today 🌸</div>
            <a href="/admin/new-appointment" class="inline-flex items-center gap-1.5 text-xs text-primary-600 hover:text-primary-700 font-semibold border border-primary-200 rounded-full px-4 py-1.5 hover:bg-primary-50 transition-colors">
              + Book an appointment for today
            </a>
          </div>`;
      } else {
        todayEl.innerHTML = todayRecs.map((r: any) => apptRow(r)).join('');
      }

      // Upcoming list
      const upcomingEl = document.getElementById('upcoming-list')!;
      if (weekRecs.length === 0) {
        upcomingEl.innerHTML = `
          <div class="px-6 py-10 text-center">
            <div class="text-neutral-400 text-sm mb-3">Nothing scheduled in the next 7 days.</div>
            <a href="/admin/new-appointment" class="inline-flex items-center gap-1.5 text-xs text-primary-600 hover:text-primary-700 font-semibold border border-primary-200 rounded-full px-4 py-1.5 hover:bg-primary-50 transition-colors">
              + Add a booking
            </a>
          </div>`;
      } else {
        upcomingEl.innerHTML = weekRecs.map((r: any) => apptRow(r, true)).join('');
      }

      // PSF today section
      const psfTodayEl = document.getElementById('psf-today-list')!;
      const psfTodayBadge = document.getElementById('psf-today-badge')!;
      if (todayPSFs.length === 0) {
        psfTodayEl.innerHTML = '<div class="px-6 py-8 text-center text-neutral-400 text-sm">No forms submitted today.</div>';
      } else {
        psfTodayBadge.textContent = String(todayPSFs.length);
        psfTodayBadge.classList.remove('hidden');
        psfTodayEl.innerHTML = todayPSFs.map(psfRow).join('');
      }

      // PSF unread section
      const psfRecentEl = document.getElementById('psf-recent-list')!;
      const psfRecentBadge = document.getElementById('psf-recent-badge')!;
      if (unreadPSFs.length === 0) {
        psfRecentEl.innerHTML = '<div class="px-6 py-8 text-center text-neutral-400 text-sm">No unread forms.</div>';
      } else {
        psfRecentBadge.textContent = `${unreadPSFs.length} unread`;
        psfRecentBadge.classList.remove('hidden');
        psfRecentEl.innerHTML = unreadPSFs.map(psfRow).join('');
      }

      // Attach appointment click handlers
      document.querySelectorAll('.appt-row').forEach(el => {
        el.addEventListener('click', () => {
          const rec = JSON.parse((el as HTMLElement).dataset.rec || '{}');
          openDetail(rec);
        });
      });

      // PSF click → mark as read
      document.querySelectorAll('.psf-row').forEach(el => {
        el.addEventListener('click', () => {
          const id = (el as HTMLElement).dataset.psfId;
          if (!id || !el.classList.contains('psf-unread')) return;
          el.classList.remove('psf-unread');
          el.querySelector('.bg-violet-500')?.classList.replace('bg-violet-500', 'bg-transparent');
          el.querySelector('.bg-violet-100')?.remove();
          apiFetch('admin-pre-service-forms', { method: 'PATCH', body: { id, read: true } }).catch(() => null);
        });
      });
    }

    loadData().catch(err => console.error('Dashboard load error:', err));
  </script>

</AdminLayout>
