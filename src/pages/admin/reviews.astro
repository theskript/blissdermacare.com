---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Client Reviews" activeNav="reviews">
  <div class="p-6 lg:p-8">
    <div class="mb-8 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-serif font-semibold text-neutral-900">Client Reviews</h1>
        <p class="mt-1 text-sm text-neutral-500">Review submissions before publishing them to the website.</p>
      </div>
      <a href="/reviews/" target="_blank" class="inline-flex items-center gap-2 rounded-lg border border-neutral-200 bg-white px-4 py-2.5 text-sm font-medium text-neutral-700 hover:border-neutral-300">View public page ↗</a>
    </div>

    <div class="mb-6 flex flex-wrap gap-2" id="filters">
      <button data-filter="all" class="filter-btn rounded-full bg-neutral-900 px-4 py-2 text-sm font-semibold text-white">All <span id="count-all"></span></button>
      <button data-filter="pending" class="filter-btn rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-neutral-600">Pending <span id="count-pending"></span></button>
      <button data-filter="published" class="filter-btn rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-neutral-600">Published <span id="count-published"></span></button>
      <button data-filter="hidden" class="filter-btn rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-neutral-600">Hidden <span id="count-hidden"></span></button>
    </div>

    <div id="review-list" class="space-y-4">
      <div class="rounded-lg border border-neutral-200 bg-white p-10 text-center text-sm text-neutral-400">Loading reviews...</div>
    </div>
  </div>

  <div id="edit-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <button id="edit-overlay" class="absolute inset-0 bg-black/40" aria-label="Close editor"></button>
    <div class="relative z-10 w-full max-w-xl rounded-lg bg-white shadow-2xl">
      <div class="flex items-center justify-between border-b border-neutral-100 px-6 py-5">
        <h2 class="font-semibold text-neutral-900">Edit review</h2>
        <button id="edit-close" class="text-neutral-400 hover:text-neutral-700" aria-label="Close">✕</button>
      </div>
      <form id="edit-form" class="space-y-4 p-6">
        <input type="hidden" name="id" />
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="text-sm font-medium text-neutral-700">Display name<input name="client_name" required maxlength="80" class="mt-1.5 w-full rounded-lg border border-neutral-300 px-3 py-2.5" /></label>
          <label class="text-sm font-medium text-neutral-700">Service<input name="service_name" required maxlength="120" class="mt-1.5 w-full rounded-lg border border-neutral-300 px-3 py-2.5" /></label>
        </div>
        <label class="block text-sm font-medium text-neutral-700">Rating
          <select name="rating" class="mt-1.5 w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5">
            <option value="5">5 stars</option><option value="4">4 stars</option><option value="3">3 stars</option><option value="2">2 stars</option><option value="1">1 star</option>
          </select>
        </label>
        <label class="block text-sm font-medium text-neutral-700">Review<textarea name="review_text" required minlength="20" maxlength="1200" rows="6" class="mt-1.5 w-full resize-y rounded-lg border border-neutral-300 px-3 py-2.5"></textarea></label>
        <label class="block text-sm font-medium text-neutral-700">Homepage order<input name="sort_order" type="number" min="0" class="mt-1.5 w-full rounded-lg border border-neutral-300 px-3 py-2.5" /></label>
        <div id="edit-error" class="hidden rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700"></div>
        <div class="flex justify-end gap-3 border-t border-neutral-100 pt-5">
          <button type="button" id="edit-cancel" class="rounded-lg border border-neutral-200 px-4 py-2.5 text-sm font-medium text-neutral-700">Cancel</button>
          <button class="rounded-lg bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-700">Save changes</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { apiFetch, requireLogin } from '../../scripts/adminAuth.js';

    type Review = { id: string; client_name: string; email: string; service_name: string; rating: number; review_text: string; published: boolean; featured: boolean; sort_order: number; moderated_at: string | null; created_at: string };
    let reviews: Review[] = [];
    let filter = 'all';
    const list = document.getElementById('review-list')!;
    const modal = document.getElementById('edit-modal')!;
    const editForm = document.getElementById('edit-form') as HTMLFormElement;

    requireLogin();

    function escapeHtml(value: unknown) {
      return String(value ?? '').replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char]!);
    }

    function statusOf(review: Review) {
      if (review.published) return 'published';
      return review.moderated_at ? 'hidden' : 'pending';
    }

    function render() {
      const counts = {
        all: reviews.length,
        pending: reviews.filter(review => statusOf(review) === 'pending').length,
        published: reviews.filter(review => review.published).length,
        hidden: reviews.filter(review => statusOf(review) === 'hidden').length,
      };
      Object.entries(counts).forEach(([key, value]) => { document.getElementById(`count-${key}`)!.textContent = `(${value})`; });
      const visible = filter === 'all' ? reviews : reviews.filter(review => statusOf(review) === filter);
      if (!visible.length) {
        list.innerHTML = '<div class="rounded-lg border border-neutral-200 bg-white p-10 text-center text-sm text-neutral-400">No reviews in this view.</div>';
        return;
      }
      list.innerHTML = visible.map(review => `
        <article class="rounded-lg border border-neutral-200 bg-white p-5 shadow-sm">
          <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
            <div class="min-w-0 max-w-3xl">
              <div class="mb-3 flex flex-wrap items-center gap-2">
                <span class="text-amber-500 tracking-wider">${'★'.repeat(review.rating)}<span class="text-neutral-300">${'★'.repeat(5 - review.rating)}</span></span>
                <span class="rounded-full px-2.5 py-1 text-xs font-semibold ${review.published ? 'bg-emerald-100 text-emerald-700' : review.moderated_at ? 'bg-neutral-200 text-neutral-600' : 'bg-amber-100 text-amber-700'}">${statusOf(review)}</span>
                ${review.featured ? '<span class="rounded-full bg-primary-100 px-2.5 py-1 text-xs font-semibold text-primary-700">Homepage</span>' : ''}
              </div>
              <blockquote class="leading-relaxed text-neutral-700">“${escapeHtml(review.review_text)}”</blockquote>
              <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                <strong class="text-neutral-900">${escapeHtml(review.client_name)}</strong>
                <span class="text-primary-700">${escapeHtml(review.service_name)}</span>
                <span class="text-neutral-400">${escapeHtml(review.email)}</span>
                <span class="text-neutral-400">${new Date(review.created_at).toLocaleDateString()}</span>
              </div>
            </div>
            <div class="flex shrink-0 flex-wrap gap-2">
              <button data-action="publish" data-id="${review.id}" class="rounded-lg px-3 py-2 text-xs font-semibold ${review.published ? 'border border-neutral-200 text-neutral-600 hover:bg-neutral-50' : 'bg-emerald-600 text-white hover:bg-emerald-700'}">${review.published ? 'Hide' : 'Publish'}</button>
              <button data-action="feature" data-id="${review.id}" class="rounded-lg border border-neutral-200 px-3 py-2 text-xs font-semibold text-neutral-600 hover:bg-neutral-50">${review.featured ? 'Unfeature' : 'Feature'}</button>
              <button data-action="edit" data-id="${review.id}" class="rounded-lg border border-neutral-200 px-3 py-2 text-xs font-semibold text-neutral-600 hover:bg-neutral-50">Edit</button>
              <button data-action="delete" data-id="${review.id}" class="rounded-lg border border-red-200 px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-50">Delete</button>
            </div>
          </div>
        </article>`).join('');
    }

    async function load() {
      const data = await apiFetch('admin-reviews');
      reviews = data?.records || [];
      render();
    }

    document.getElementById('filters')!.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!button) return;
      filter = button.dataset.filter!;
      document.querySelectorAll('.filter-btn').forEach(item => item.className = 'filter-btn rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-neutral-600');
      button.className = 'filter-btn rounded-full bg-neutral-900 px-4 py-2 text-sm font-semibold text-white';
      render();
    });

    list.addEventListener('click', async event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-action]');
      if (!button) return;
      const review = reviews.find(item => item.id === button.dataset.id);
      if (!review) return;
      const action = button.dataset.action;
      if (action === 'delete') {
        if (!confirm(`Permanently delete ${review.client_name}'s review?`)) return;
        await apiFetch('admin-reviews', { method: 'DELETE', body: { id: review.id } });
      } else if (action === 'publish') {
        await apiFetch('admin-reviews', { method: 'PATCH', body: { id: review.id, published: !review.published, featured: review.published ? false : review.featured } });
      } else if (action === 'feature') {
        await apiFetch('admin-reviews', { method: 'PATCH', body: { id: review.id, featured: !review.featured, published: !review.featured ? true : review.published } });
      } else if (action === 'edit') {
        const fields = editForm.elements as typeof editForm.elements & Record<string, HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>;
        fields.id.value = review.id;
        fields.client_name.value = review.client_name;
        fields.service_name.value = review.service_name;
        fields.rating.value = String(review.rating);
        fields.review_text.value = review.review_text;
        fields.sort_order.value = String(review.sort_order || 0);
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        return;
      }
      await load();
    });

    editForm.addEventListener('submit', async event => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(editForm));
      await apiFetch('admin-reviews', { method: 'PATCH', body: { ...data, rating: Number(data.rating), sort_order: Number(data.sort_order) } });
      closeModal();
      await load();
    });

    function closeModal() { modal.classList.add('hidden'); modal.classList.remove('flex'); }
    document.getElementById('edit-close')!.addEventListener('click', closeModal);
    document.getElementById('edit-cancel')!.addEventListener('click', closeModal);
    document.getElementById('edit-overlay')!.addEventListener('click', closeModal);

    load().catch(error => { list.innerHTML = `<div class="rounded-lg border border-red-200 bg-red-50 p-5 text-sm text-red-700">${escapeHtml(error.message)}</div>`; });
  </script>
</AdminLayout>