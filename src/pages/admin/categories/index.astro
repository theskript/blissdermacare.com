---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Service Categories" activeNav="categories">

  <div class="p-6 lg:p-8">
    <div class="mb-6 flex items-start justify-between gap-4 flex-wrap">
      <div>
        <h1 class="text-2xl font-serif font-semibold text-neutral-900">Service Categories</h1>
        <p class="text-sm text-neutral-500 mt-1">Manage the categories shown on the services hub, booking form, and navigation. Changes go live immediately.</p>
      </div>
      <button id="add-cat-btn"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-xl transition-colors shadow-sm shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add Category
      </button>
    </div>

    <div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden">
      <div id="cat-table-wrap" class="overflow-x-auto">
        <div class="px-6 py-10 text-center text-neutral-400 text-sm">Loading…</div>
      </div>
      <div class="px-6 py-3 border-t border-neutral-100 text-xs text-neutral-400" id="cat-count">—</div>
    </div>
  </div>

  <!-- Edit / Create panel -->
  <div id="cat-panel" class="hidden fixed inset-y-0 right-0 w-full sm:w-[440px] bg-white shadow-2xl border-l border-neutral-200 z-50 flex flex-col">
    <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-100 shrink-0">
      <h3 id="cat-panel-title" class="font-semibold text-neutral-900">Edit Category</h3>
      <button id="cat-close" class="p-1.5 rounded-lg text-neutral-400 hover:bg-neutral-100 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div id="cat-panel-body" class="flex-1 overflow-y-auto p-6 space-y-5 font-sans"></div>
  </div>
  <div id="cat-overlay" class="hidden fixed inset-0 bg-black/20 z-40"></div>

  <script>
    import { requireLogin, apiFetch } from '../../../scripts/adminAuth.js';
    requireLogin();

    function esc(s: unknown) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    let allCats: any[] = [];
    let editingId: string | null = null;

    async function load() {
      const wrap = document.getElementById('cat-table-wrap')!;
      wrap.innerHTML = '<div class="px-6 py-10 text-center text-neutral-400 text-sm">Loading…</div>';
      try {
        const data = await apiFetch('admin-categories');
        allCats = data?.categories || [];
        document.getElementById('cat-count')!.textContent = `${allCats.length} categor${allCats.length !== 1 ? 'ies' : 'y'}`;
        render();
      } catch (err: any) {
        wrap.innerHTML = `<div class="px-6 py-6 text-red-500 text-sm">${err.message}</div>`;
      }
    }

    function render() {
      const wrap = document.getElementById('cat-table-wrap')!;
      if (!allCats.length) {
        wrap.innerHTML = '<div class="px-6 py-12 text-center text-neutral-400 text-sm">No categories yet.</div>';
        return;
      }
      wrap.innerHTML = `
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-neutral-100 text-xs font-semibold text-neutral-500 uppercase tracking-wide">
              <th class="px-6 py-3 text-left">Category</th>
              <th class="px-6 py-3 text-left hidden sm:table-cell">Slug</th>
              <th class="px-6 py-3 text-left hidden md:table-cell">Page URL</th>
              <th class="px-6 py-3 text-center">Sort</th>
              <th class="px-6 py-3 text-center">Active</th>
              <th class="px-6 py-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-50">
            ${allCats.map(cat => `
              <tr class="hover:bg-neutral-50 transition-colors">
                <td class="px-6 py-4">
                  <p class="font-semibold text-neutral-900">${esc(cat.name)}</p>
                  ${cat.tagline ? `<p class="text-xs text-neutral-400 mt-0.5 truncate max-w-[200px]">${esc(cat.tagline)}</p>` : ''}
                </td>
                <td class="px-6 py-4 hidden sm:table-cell font-mono text-xs text-neutral-500">${esc(cat.slug)}</td>
                <td class="px-6 py-4 hidden md:table-cell text-xs text-neutral-500">${esc(cat.page_url || '—')}</td>
                <td class="px-6 py-4 text-center text-xs text-neutral-400">${cat.sort_order ?? 0}</td>
                <td class="px-6 py-4 text-center">
                  ${cat.active
                    ? '<span class="inline-block w-2 h-2 bg-emerald-500 rounded-full"></span>'
                    : '<span class="inline-block w-2 h-2 bg-neutral-300 rounded-full"></span>'}
                </td>
                <td class="px-6 py-4 text-right">
                  <button class="cat-edit-btn px-3 py-1.5 text-xs font-medium border border-neutral-200 text-neutral-600 hover:border-primary-300 hover:text-primary-600 rounded-lg transition-colors" data-id="${esc(cat.id)}">Edit</button>
                </td>
              </tr>`).join('')}
          </tbody>
        </table>`;

      wrap.querySelectorAll('.cat-edit-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = allCats.find(c => c.id === (btn as HTMLElement).dataset.id);
          if (cat) openPanel(cat);
        });
      });
    }

    function openPanel(cat: any | null) {
      editingId = cat?.id || null;
      document.getElementById('cat-panel-title')!.textContent = cat ? 'Edit Category' : 'Add Category';
      const body = document.getElementById('cat-panel-body')!;
      body.innerHTML = `
        <div><label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Name *</label>
          <input id="f-name" type="text" value="${esc(cat?.name || '')}"
            class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/></div>
        <div><label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Slug *</label>
          <input id="f-slug" type="text" value="${esc(cat?.slug || '')}" placeholder="url-safe-id"
            class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm font-mono focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/>
          <p class="text-xs text-neutral-400 mt-1">Used to filter services by category. Changing this will break existing service assignments.</p></div>
        <div><label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Tagline</label>
          <input id="f-tagline" type="text" value="${esc(cat?.tagline || '')}" placeholder="Shown under category name in nav/cards"
            class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/></div>
        <div><label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Description</label>
          <textarea id="f-desc" rows="2"
            class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none resize-none">${esc(cat?.description || '')}</textarea></div>
        <div><label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Page URL</label>
          <input id="f-url" type="text" value="${esc(cat?.page_url || '')}" placeholder="/services/my-category/"
            class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/></div>
        <div><label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Image URL</label>
          <input id="f-img" type="text" value="${esc(cat?.image_url || '')}" placeholder="https://..."
            class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/>
          ${cat?.image_url ? `<img src="${esc(cat.image_url)}" class="mt-2 h-16 rounded-lg object-cover w-full" alt=""/>` : ''}</div>
        <div class="grid grid-cols-2 gap-4">
          <div><label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Sort Order</label>
            <input id="f-sort" type="number" value="${cat?.sort_order ?? 0}"
              class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 outline-none"/></div>
          <div class="flex items-end pb-2">
            <label class="flex items-center gap-2 cursor-pointer select-none">
              <input type="checkbox" id="f-active" ${(cat?.active ?? true) ? 'checked' : ''} class="w-4 h-4 rounded border-neutral-300 accent-emerald-500"/>
              <span class="text-sm font-medium text-neutral-700">Active</span>
            </label>
          </div>
        </div>
        <div class="flex gap-3 pt-2">
          <button id="f-save-btn" class="flex-1 py-2.5 bg-primary-600 hover:bg-primary-700 disabled:opacity-50 text-white text-sm font-semibold rounded-xl transition-colors">Save</button>
          ${cat ? `<button id="f-del-btn" class="py-2.5 px-4 border border-red-200 text-red-500 hover:bg-red-50 text-sm font-semibold rounded-xl transition-colors">Delete</button>` : ''}
        </div>
        <div id="f-msg" class="text-xs text-center hidden"></div>`;

      // Auto-slug from name
      if (!cat) {
        const nameEl = document.getElementById('f-name') as HTMLInputElement;
        const slugEl = document.getElementById('f-slug') as HTMLInputElement;
        nameEl.addEventListener('input', () => {
          if (!slugEl.dataset.manual)
            slugEl.value = nameEl.value.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
        });
        slugEl.addEventListener('input', () => { slugEl.dataset.manual = '1'; });
      }

      document.getElementById('f-save-btn')?.addEventListener('click', async () => {
        const btn = document.getElementById('f-save-btn') as HTMLButtonElement;
        const msg = document.getElementById('f-msg')!;
        const name    = (document.getElementById('f-name') as HTMLInputElement).value.trim();
        const slug    = (document.getElementById('f-slug') as HTMLInputElement).value.trim();
        const tagline = (document.getElementById('f-tagline') as HTMLInputElement).value.trim();
        const desc    = (document.getElementById('f-desc') as HTMLTextAreaElement).value.trim();
        const url     = (document.getElementById('f-url') as HTMLInputElement).value.trim();
        const imgUrl  = (document.getElementById('f-img') as HTMLInputElement).value.trim();
        const sort    = parseInt((document.getElementById('f-sort') as HTMLInputElement).value || '0', 10);
        const active  = (document.getElementById('f-active') as HTMLInputElement).checked;
        if (!name || !slug) {
          msg.textContent = 'Name and slug are required.'; msg.className = 'text-xs text-center text-red-500'; msg.classList.remove('hidden'); return;
        }
        btn.disabled = true; btn.textContent = 'Saving…';
        try {
          const fields = { name, slug, tagline: tagline||null, description: desc||null, page_url: url||null, image_url: imgUrl||null, sort_order: sort, active };
          if (editingId) await apiFetch('admin-categories', { method: 'PATCH', body: { id: editingId, ...fields } });
          else           await apiFetch('admin-categories', { method: 'POST',  body: fields });
          closePanel(); await load();
        } catch (err: any) {
          msg.textContent = `Error: ${err.message}`; msg.className = 'text-xs text-center text-red-500'; msg.classList.remove('hidden');
          btn.disabled = false; btn.textContent = 'Save';
        }
      });

      document.getElementById('f-del-btn')?.addEventListener('click', async () => {
        if (!editingId) return;
        const catName = allCats.find(c => c.id === editingId)?.name || 'this category';
        if (!confirm(`Delete "${catName}"? This cannot be undone.`)) return;
        try {
          await apiFetch('admin-categories', { method: 'DELETE', params: { id: editingId } });
          closePanel(); await load();
        } catch (err: any) { alert(`Delete failed: ${err.message}`); }
      });

      document.getElementById('cat-panel')?.classList.remove('hidden');
      document.getElementById('cat-panel')?.classList.add('flex');
      document.getElementById('cat-overlay')?.classList.remove('hidden');
    }

    function closePanel() {
      document.getElementById('cat-panel')?.classList.add('hidden');
      document.getElementById('cat-panel')?.classList.remove('flex');
      document.getElementById('cat-overlay')?.classList.add('hidden');
      editingId = null;
    }

    document.getElementById('cat-close')?.addEventListener('click', closePanel);
    document.getElementById('cat-overlay')?.addEventListener('click', closePanel);
    document.getElementById('add-cat-btn')?.addEventListener('click', () => openPanel(null));

    load();
  </script>
</AdminLayout>
