---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Promo Codes" activeNav="promo-codes">

  <div class="p-6 lg:p-8">
    <div class="mb-6 flex items-start justify-between gap-4 flex-wrap">
      <div>
        <h1 class="text-2xl font-serif font-semibold text-neutral-900">Promo Codes</h1>
        <p class="text-sm text-neutral-500 mt-1">Create and manage discount codes for use at booking. Codes are validated server-side and apply automatically at checkout.</p>
      </div>
      <button id="add-promo-btn"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-xl transition-colors shadow-sm shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add Promo Code
      </button>
    </div>

    <div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden">
      <div id="promo-table-wrap" class="overflow-x-auto">
        <div class="px-6 py-10 text-center text-neutral-400 text-sm">Loading…</div>
      </div>
    </div>
  </div>

  <!-- Slide-over -->
  <div id="promo-panel" class="hidden fixed inset-y-0 right-0 w-full sm:w-[440px] bg-white shadow-2xl border-l border-neutral-200 z-50 flex flex-col">
    <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-100 shrink-0">
      <h3 id="promo-panel-title" class="font-semibold text-neutral-900">Add Promo Code</h3>
      <button id="promo-close" class="p-1.5 rounded-lg text-neutral-400 hover:bg-neutral-100 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div id="promo-panel-body" class="flex-1 overflow-y-auto p-6 space-y-5"></div>
  </div>
  <div id="promo-overlay" class="hidden fixed inset-0 bg-black/20 z-40"></div>

  <script>
    import { requireLogin, apiFetch } from '../../../scripts/adminAuth.js';
    requireLogin();

    function esc(s: unknown) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    let allCodes: any[] = [];
    let editingId: string | null = null;

    async function load() {
      const wrap = document.getElementById('promo-table-wrap')!;
      try {
        const data = await apiFetch('admin-promo-codes', {});
        allCodes = data?.promoCodes || [];
        render();
      } catch (err: any) {
        wrap.innerHTML = `<div class="px-6 py-6 text-red-500 text-sm">${err.message}</div>`;
      }
    }

    function render() {
      const wrap = document.getElementById('promo-table-wrap')!;
      if (!allCodes.length) {
        wrap.innerHTML = '<div class="px-6 py-12 text-center text-neutral-400 text-sm">No promo codes yet.</div>';
        return;
      }
      const now = new Date();
      wrap.innerHTML = `
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-neutral-100 text-xs font-semibold text-neutral-500 uppercase tracking-wide">
              <th class="px-6 py-3 text-left">Code</th>
              <th class="px-6 py-3 text-left">Discount</th>
              <th class="px-6 py-3 text-center">Uses</th>
              <th class="px-6 py-3 text-left hidden md:table-cell">Expires</th>
              <th class="px-6 py-3 text-center">Status</th>
              <th class="px-6 py-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-50">
            ${allCodes.map(c => {
              const expired = c.expires_at && new Date(c.expires_at) < now;
              const exhausted = c.max_uses != null && c.uses >= c.max_uses;
              const effective = c.active && !expired && !exhausted;
              const statusCls = effective ? 'bg-emerald-100 text-emerald-700' : 'bg-neutral-100 text-neutral-500';
              const statusLabel = !c.active ? 'Inactive' : expired ? 'Expired' : exhausted ? 'Exhausted' : 'Active';
              const discountLabel = c.type === 'percent' ? `${c.value}% off` : `$${(c.value/100).toFixed(0)} off`;
              const usesLabel = c.max_uses != null ? `${c.uses} / ${c.max_uses}` : `${c.uses} / ∞`;
              const expiresLabel = c.expires_at
                ? new Date(c.expires_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                : '—';
              return `
              <tr class="hover:bg-neutral-50 transition-colors">
                <td class="px-6 py-4">
                  <div class="font-bold font-mono text-neutral-900">${esc(c.code)}</div>
                  ${c.description ? `<div class="text-xs text-neutral-400 mt-0.5">${esc(c.description)}</div>` : ''}
                  ${c.min_subtotal ? `<div class="text-xs text-neutral-400">Min $${(c.min_subtotal/100).toFixed(0)}</div>` : ''}
                </td>
                <td class="px-6 py-4 font-semibold text-primary-700">${discountLabel}</td>
                <td class="px-6 py-4 text-center text-xs text-neutral-500">${usesLabel}</td>
                <td class="px-6 py-4 text-xs text-neutral-500 hidden md:table-cell">${expiresLabel}</td>
                <td class="px-6 py-4 text-center">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold ${statusCls}">${statusLabel}</span>
                </td>
                <td class="px-6 py-4 text-right">
                  <button class="promo-edit-btn px-3 py-1.5 text-xs font-medium border border-neutral-200 text-neutral-600 hover:border-primary-300 hover:text-primary-600 rounded-lg transition-colors mr-1" data-id="${esc(c.id)}">Edit</button>
                  ${c.active ? `<button class="promo-del-btn px-3 py-1.5 text-xs font-medium border border-red-200 text-red-500 hover:bg-red-50 rounded-lg transition-colors" data-id="${esc(c.id)}">Deactivate</button>` : ''}
                </td>
              </tr>`;
            }).join('')}
          </tbody>
        </table>`;

      document.querySelectorAll('.promo-edit-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const code = allCodes.find(c => c.id === (btn as HTMLElement).dataset.id);
          if (code) openPanel(code);
        });
      });
      document.querySelectorAll('.promo-del-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id!;
          const code = allCodes.find(c => c.id === id);
          if (!confirm(`Deactivate promo code "${code?.code}"?`)) return;
          try {
            await apiFetch('admin-promo-codes', { method: 'DELETE', body: { id } });
            await load();
          } catch (err: any) { alert(`Failed: ${err.message}`); }
        });
      });
    }

    function openPanel(code: any | null) {
      editingId = code?.id || null;
      document.getElementById('promo-panel-title')!.textContent = code ? `Edit: ${code.code}` : 'Add Promo Code';
      const body = document.getElementById('promo-panel-body')!;
      const expiresVal = code?.expires_at ? new Date(code.expires_at).toISOString().split('T')[0] : '';

      body.innerHTML = `
        <div>
          <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Code *</label>
          <input id="f-code" type="text" value="${esc(code?.code || '')}" placeholder="e.g. WELCOME20"
            class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm font-mono uppercase focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"
            style="text-transform:uppercase"/>
          <p class="text-xs text-neutral-400 mt-1">Customers enter this at checkout — case-insensitive.</p>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Internal Note</label>
          <input id="f-desc" type="text" value="${esc(code?.description || '')}" placeholder="e.g. Summer 2026 campaign"
            class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Discount Type *</label>
            <select id="f-type" class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 outline-none">
              <option value="percent" ${(code?.type || 'percent') === 'percent' ? 'selected' : ''}>Percent off (%)</option>
              <option value="fixed"   ${code?.type === 'fixed'   ? 'selected' : ''}>Fixed amount ($)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Value *</label>
            <input id="f-value" type="number" min="1" value="${code?.type === 'fixed' ? (code.value/100).toFixed(2) : (code?.value ?? '')}"
              placeholder="${(code?.type || 'percent') === 'fixed' ? '0.00 ($)' : '0–100 (%)'}"
              class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Max Uses</label>
            <input id="f-max-uses" type="number" min="1" value="${code?.max_uses ?? ''}" placeholder="Leave blank = unlimited"
              class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Expiry Date</label>
            <input id="f-expires" type="date" value="${expiresVal}"
              class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/>
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Minimum Subtotal ($)</label>
          <input id="f-min-sub" type="number" min="0" step="0.01" value="${code?.min_subtotal != null ? (code.min_subtotal/100).toFixed(2) : ''}" placeholder="Leave blank = no minimum"
            class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/>
        </div>
        ${code ? `
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-1">Uses (manual override)</label>
            <input id="f-uses" type="number" min="0" value="${code.uses}"
              class="w-full px-3 py-2 rounded-lg border border-neutral-200 text-sm focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none"/>
          </div>
          <div class="flex items-end pb-2">
            <label class="flex items-center gap-2 cursor-pointer select-none">
              <input type="checkbox" id="f-active" ${code.active ? 'checked' : ''} class="w-4 h-4 rounded border-neutral-300 accent-emerald-500"/>
              <span class="text-sm font-medium text-neutral-700">Active</span>
            </label>
          </div>
        </div>` : ''}
        <div class="flex gap-3 pt-2">
          <button id="f-save-btn" class="flex-1 py-2.5 bg-primary-600 hover:bg-primary-700 disabled:opacity-50 text-white text-sm font-semibold rounded-xl transition-colors">Save</button>
        </div>
        <div id="f-msg" class="text-xs text-center hidden"></div>
      `;

      // Update value placeholder when type changes
      document.getElementById('f-type')?.addEventListener('change', (e) => {
        const t = (e.target as HTMLSelectElement).value;
        (document.getElementById('f-value') as HTMLInputElement).placeholder = t === 'fixed' ? '0.00 ($)' : '0–100 (%)';
      });

      document.getElementById('f-save-btn')?.addEventListener('click', async () => {
        const btn  = document.getElementById('f-save-btn') as HTMLButtonElement;
        const msg  = document.getElementById('f-msg')!;
        const codeVal  = (document.getElementById('f-code')     as HTMLInputElement).value.trim().toUpperCase();
        const desc     = (document.getElementById('f-desc')     as HTMLInputElement).value.trim();
        const type     = (document.getElementById('f-type')     as HTMLSelectElement).value;
        const rawValue = parseFloat((document.getElementById('f-value') as HTMLInputElement).value);
        const maxUses  = (document.getElementById('f-max-uses') as HTMLInputElement).value;
        const expires  = (document.getElementById('f-expires')  as HTMLInputElement).value;
        const minSub   = (document.getElementById('f-min-sub')  as HTMLInputElement).value;
        const usesEl   = document.getElementById('f-uses')   as HTMLInputElement | null;
        const activeEl = document.getElementById('f-active') as HTMLInputElement | null;

        if (!codeVal || isNaN(rawValue) || rawValue <= 0) {
          msg.textContent = 'Code and a valid discount value are required.';
          msg.className = 'text-xs text-center text-red-500'; msg.classList.remove('hidden'); return;
        }
        const value = type === 'fixed' ? Math.round(rawValue * 100) : Math.round(rawValue);

        btn.disabled = true; btn.textContent = 'Saving…';
        try {
          const fields: Record<string, any> = {
            code: codeVal, type, value, description: desc || null,
            max_uses:    maxUses ? parseInt(maxUses, 10) : null,
            expires_at:  expires || null,
            min_subtotal: minSub ? Math.round(parseFloat(minSub) * 100) : null,
          };
          if (usesEl)   fields.uses   = parseInt(usesEl.value, 10);
          if (activeEl) fields.active = activeEl.checked;

          if (editingId) {
            await apiFetch('admin-promo-codes', { method: 'PATCH', body: { id: editingId, ...fields } });
          } else {
            await apiFetch('admin-promo-codes', { method: 'POST', body: fields });
          }
          closePanel();
          await load();
        } catch (err: any) {
          msg.textContent = `Error: ${err.message}`;
          msg.className = 'text-xs text-center text-red-500'; msg.classList.remove('hidden');
          btn.disabled = false; btn.textContent = 'Save';
        }
      });

      document.getElementById('promo-panel')?.classList.remove('hidden');
      document.getElementById('promo-panel')?.classList.add('flex');
      document.getElementById('promo-overlay')?.classList.remove('hidden');
    }

    function closePanel() {
      document.getElementById('promo-panel')?.classList.add('hidden');
      document.getElementById('promo-panel')?.classList.remove('flex');
      document.getElementById('promo-overlay')?.classList.add('hidden');
      editingId = null;
    }

    document.getElementById('promo-close')?.addEventListener('click', closePanel);
    document.getElementById('promo-overlay')?.addEventListener('click', closePanel);
    document.getElementById('add-promo-btn')?.addEventListener('click', () => openPanel(null));

    load();
  </script>

</AdminLayout>
