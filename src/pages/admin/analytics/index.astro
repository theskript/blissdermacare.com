---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Analytics" activeNav="analytics">
<div class="p-6 lg:p-8 max-w-screen-xl">

  <!-- Header -->
  <div class="flex items-start justify-between gap-4 mb-6 flex-wrap">
    <div>
      <h1 class="text-2xl font-serif font-semibold text-neutral-900">Analytics</h1>
      <p class="text-sm text-neutral-500 mt-0.5">Business performance metrics and booking trends.</p>
    </div>
    <select id="period-select" class="px-3 py-2 rounded-xl border border-neutral-300 text-sm bg-white focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none">
      <option value="3">Last 3 months</option>
      <option value="6" selected>Last 6 months</option>
      <option value="12">Last 12 months</option>
      <option value="24">Last 24 months</option>
    </select>
  </div>

  <!-- KPI cards -->
  <div id="kpi-row" class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
    <div class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5 animate-pulse"><div class="h-4 bg-neutral-100 rounded w-24 mb-2"></div><div class="h-7 bg-neutral-100 rounded w-12"></div></div>
    <div class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5 animate-pulse"><div class="h-4 bg-neutral-100 rounded w-24 mb-2"></div><div class="h-7 bg-neutral-100 rounded w-12"></div></div>
    <div class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5 animate-pulse"><div class="h-4 bg-neutral-100 rounded w-24 mb-2"></div><div class="h-7 bg-neutral-100 rounded w-12"></div></div>
    <div class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5 animate-pulse"><div class="h-4 bg-neutral-100 rounded w-24 mb-2"></div><div class="h-7 bg-neutral-100 rounded w-12"></div></div>
  </div>

  <!-- Charts grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">

    <!-- Monthly trend -->
    <div class="bg-white rounded-2xl border border-neutral-200 p-5">
      <h2 class="font-semibold text-neutral-900 text-sm mb-4">Appointments by Month</h2>
      <div id="chart-monthly" class="space-y-2"></div>
    </div>

    <!-- Busiest days -->
    <div class="bg-white rounded-2xl border border-neutral-200 p-5">
      <h2 class="font-semibold text-neutral-900 text-sm mb-4">Busiest Days of Week</h2>
      <div id="chart-days" class="space-y-2"></div>
    </div>

    <!-- Busiest hours -->
    <div class="bg-white rounded-2xl border border-neutral-200 p-5">
      <h2 class="font-semibold text-neutral-900 text-sm mb-4">Busiest Time Slots</h2>
      <div id="chart-hours" class="space-y-2"></div>
    </div>

    <!-- Top services -->
    <div class="bg-white rounded-2xl border border-neutral-200 p-5">
      <h2 class="font-semibold text-neutral-900 text-sm mb-4">Most Booked Services</h2>
      <div id="chart-services" class="space-y-2"></div>
    </div>

  </div>

  <!-- Top clients table -->
  <div class="bg-white rounded-2xl border border-neutral-200 overflow-hidden">
    <div class="flex items-center justify-between px-5 py-3.5 border-b border-neutral-100">
      <h2 class="font-semibold text-neutral-900 text-sm">Most Frequent Clients</h2>
      <span class="text-xs text-neutral-400">Top 10 by visit count</span>
    </div>
    <div id="clients-table" class="overflow-x-auto">
      <div class="px-5 py-8 text-center text-neutral-400 text-sm">Loading…</div>
    </div>
  </div>

</div>

<script>
  import { requireLogin, apiFetch, getRole } from '../../../scripts/adminAuth.js';
  requireLogin();
  const role = getRole();

  function bar(value: number, max: number, color = 'bg-primary-500') {
    const pct = max > 0 ? Math.round((value / max) * 100) : 0;
    return `<div class="flex items-center gap-2">
      <div class="flex-1 h-2 bg-neutral-100 rounded-full overflow-hidden">
        <div class="${color} h-2 rounded-full transition-all" style="width:${pct}%"></div>
      </div>
      <span class="text-xs text-neutral-500 w-8 text-right">${value}</span>
    </div>`;
  }

  function kpiCard(label: string, value: string, sub: string, accent = '') {
    return `<div class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5 ${accent ? 'border-l-4 ' + accent : ''}">
      <div class="text-[11px] font-semibold uppercase tracking-[0.1em] text-neutral-400 mb-1">${label}</div>
      <div class="text-2xl font-bold text-neutral-900 leading-none mb-0.5">${value}</div>
      <div class="text-[11px] text-neutral-400">${sub}</div>
    </div>`;
  }

  async function load(months: number) {
    // Show loading state
    document.getElementById('kpi-row')!.innerHTML = Array(4).fill('<div class="bg-white rounded-xl border border-neutral-200 px-4 py-3.5 animate-pulse"><div class="h-4 bg-neutral-100 rounded w-24 mb-2"></div><div class="h-7 bg-neutral-100 rounded w-12"></div></div>').join('');
    ['chart-monthly','chart-days','chart-hours','chart-services','clients-table'].forEach(id =>
      document.getElementById(id)!.innerHTML = '<div class="py-4 text-center text-neutral-400 text-sm">Loading…</div>');

    try {
      const d = await apiFetch('admin-analytics', { params: { months: String(months) } });

      // ── KPIs ──────────────────────────────────────────────────────────────
      const retentionPct = d.uniqueClients > 0 ? Math.round((d.repeatClients / d.uniqueClients) * 100) : 0;
      let kpis = [
        kpiCard('Total Appointments', String(d.total), `last ${months} months`),
        kpiCard('Unique Clients', String(d.uniqueClients), `${d.repeatClients} returned (${retentionPct}% retention)`, 'border-emerald-400'),
        kpiCard('Avg / Month', String(d.avgApptPerMonth), 'appointments per month'),
      ];
      if (role === 'owner' && d.totalRevenue != null) {
        kpis.push(kpiCard('Revenue', `$${Number(d.totalRevenue).toLocaleString('en-US', {maximumFractionDigits:0})}`, `last ${months} months`, 'border-primary-400'));
      } else {
        kpis.push(kpiCard('Repeat Rate', `${retentionPct}%`, 'of clients returned'));
      }
      document.getElementById('kpi-row')!.innerHTML = kpis.join('');

      // ── Monthly trend ─────────────────────────────────────────────────────
      const maxMonth = Math.max(...d.monthlyTrend.map((m: any) => m.count), 1);
      document.getElementById('chart-monthly')!.innerHTML = d.monthlyTrend.length === 0
        ? '<p class="text-xs text-neutral-400 text-center py-4">No data</p>'
        : d.monthlyTrend.map((m: any) => {
          const label = new Date(m.month + '-15').toLocaleDateString('en-US', { month: 'short', year: '2-digit' });
          const revLabel = role === 'owner' && m.revenue ? ` · $${Math.round(m.revenue).toLocaleString()}` : '';
          return `<div><div class="flex justify-between text-xs text-neutral-600 mb-0.5"><span>${label}</span><span class="text-neutral-400">${m.count}${revLabel}</span></div>${bar(m.count, maxMonth)}</div>`;
        }).join('');

      // ── Busiest days ──────────────────────────────────────────────────────
      const maxDay = Math.max(...d.byDay.map((d: any) => d.count), 1);
      document.getElementById('chart-days')!.innerHTML = d.byDay
        .sort((a: any, b: any) => b.count - a.count)
        .map((d: any) => `<div><div class="flex justify-between text-xs text-neutral-600 mb-0.5"><span>${d.day}</span><span class="text-neutral-400">${d.count}</span></div>${bar(d.count, maxDay, 'bg-violet-400')}</div>`)
        .join('');

      // ── Busiest hours ─────────────────────────────────────────────────────
      const maxHour = Math.max(...d.byHour.map((h: any) => h.count), 1);
      document.getElementById('chart-hours')!.innerHTML = d.byHour.length === 0
        ? '<p class="text-xs text-neutral-400 text-center py-4">No time data</p>'
        : d.byHour
          .sort((a: any, b: any) => b.count - a.count)
          .slice(0, 8)
          .map((h: any) => `<div><div class="flex justify-between text-xs text-neutral-600 mb-0.5"><span>${h.label}</span><span class="text-neutral-400">${h.count}</span></div>${bar(h.count, maxHour, 'bg-amber-400')}</div>`)
          .join('');

      // ── Top services ──────────────────────────────────────────────────────
      const maxSvc = Math.max(...d.topServices.map((s: any) => s.count), 1);
      document.getElementById('chart-services')!.innerHTML = d.topServices.length === 0
        ? '<p class="text-xs text-neutral-400 text-center py-4">No data</p>'
        : d.topServices.map((s: any) => `<div><div class="flex justify-between text-xs text-neutral-600 mb-0.5"><span class="truncate pr-2">${s.name}</span><span class="text-neutral-400 shrink-0">${s.count}x</span></div>${bar(s.count, maxSvc, 'bg-emerald-400')}</div>`).join('');

      // ── Top clients ───────────────────────────────────────────────────────
      const clients = document.getElementById('clients-table')!;
      if (!d.topClients.length) {
        clients.innerHTML = '<div class="px-5 py-8 text-center text-neutral-400 text-sm">No client data yet.</div>';
      } else {
        clients.innerHTML = `<table class="min-w-full text-sm"><thead><tr class="border-b border-neutral-100 text-xs font-semibold text-neutral-500 uppercase tracking-wide">
          <th class="px-5 py-3 text-left">Client</th>
          <th class="px-5 py-3 text-center">Visits</th>
          <th class="px-5 py-3 text-center">Status</th>
          <th class="px-5 py-3 text-left hidden md:table-cell">Last Visit</th>
        </tr></thead><tbody class="divide-y divide-neutral-50">
        ${d.topClients.map((c: any, i: number) => {
          const medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : `${i+1}.`;
          const status = c.count >= 10 ? 'bg-primary-100 text-primary-700' : c.count >= 5 ? 'bg-emerald-100 text-emerald-700' : 'bg-neutral-100 text-neutral-600';
          const statusLabel = c.count >= 10 ? 'VIP' : c.count >= 5 ? 'Regular' : 'Occasional';
          return `<tr class="hover:bg-neutral-50 transition-colors">
            <td class="px-5 py-3">
              <span class="mr-2 text-sm">${medal}</span>
              <span class="font-medium text-neutral-900">${c.name || '—'}</span>
              ${c.email ? `<div class="text-xs text-neutral-400 ml-6">${c.email}</div>` : ''}
            </td>
            <td class="px-5 py-3 text-center font-bold text-neutral-900">${c.count}</td>
            <td class="px-5 py-3 text-center"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold ${status}">${statusLabel}</span></td>
            <td class="px-5 py-3 hidden md:table-cell text-xs text-neutral-400">${c.lastVisit ? new Date(c.lastVisit + 'T12:00:00').toLocaleDateString('en-US', {month:'short',day:'numeric',year:'numeric'}) : '—'}</td>
          </tr>`;
        }).join('')}
        </tbody></table>`;
      }
    } catch (err: any) {
      document.getElementById('kpi-row')!.innerHTML = `<div class="col-span-4 text-red-500 text-sm px-4">${err.message}</div>`;
    }
  }

  let period = 6;
  document.getElementById('period-select')?.addEventListener('change', (e) => {
    period = parseInt((e.target as HTMLSelectElement).value, 10);
    load(period);
  });

  load(period);
</script>
</AdminLayout>
