---
import Layout from '../../layouts/Layout.astro';
// Slug is resolved client-side so this is a static catch-all shell
const slug = Astro.params.slug || '';
---
<Layout title="Loading…" description="">
  <div id="page-root" class="max-w-4xl mx-auto px-6 py-12">
    <div class="animate-pulse space-y-4">
      <div class="h-8 bg-neutral-100 rounded w-64"></div>
      <div class="h-4 bg-neutral-100 rounded w-full"></div>
      <div class="h-4 bg-neutral-100 rounded w-5/6"></div>
    </div>
  </div>

  <script is:inline define:vars={{ slug }}>
    const SPACER = { sm: '1rem', md: '2rem', lg: '4rem', xl: '6rem' };
    const GAP    = { sm: '1rem', md: '1.5rem', lg: '2.5rem' };
    const BTN    = {
      primary:   'display:inline-block;padding:0.65rem 1.5rem;background:#7c3aed;color:white;border-radius:9999px;text-decoration:none;font-weight:600;font-size:0.875rem',
      secondary: 'display:inline-block;padding:0.65rem 1.5rem;background:#f3f4f6;color:#111;border-radius:9999px;text-decoration:none;font-weight:600;font-size:0.875rem',
      outline:   'display:inline-block;padding:0.65rem 1.5rem;background:transparent;color:#7c3aed;border:2px solid #7c3aed;border-radius:9999px;text-decoration:none;font-weight:600;font-size:0.875rem',
    };

    function renderBlock(block) {
      const c = block.content || {};
      switch (block.type) {
        case 'hero': return `
          <div style="position:relative;min-height:380px;display:flex;align-items:center;justify-content:center;text-align:center;background:${c.bg?`url(${c.bg}) center/cover`:' #1a1a1a'};border-radius:1rem;overflow:hidden;margin-bottom:2rem">
            <div style="position:absolute;inset:0;background:rgba(0,0,0,${c.overlay||0.4})"></div>
            <div style="position:relative;z-index:1;padding:3rem 1.5rem;color:white">
              <h1 style="font-family:Georgia,serif;font-size:2.5rem;font-weight:700;margin-bottom:0.75rem">${c.heading||''}</h1>
              ${c.subheading ? `<p style="font-size:1.1rem;opacity:0.9;margin-bottom:1.5rem">${c.subheading}</p>` : ''}
              ${c.cta_text ? `<a href="${c.cta_url||'/'}" style="${BTN.primary}">${c.cta_text}</a>` : ''}
            </div>
          </div>`;
        case 'heading': {
          const tag = `h${c.level||2}`;
          const sz  = ['','2.25rem','1.875rem','1.5rem','1.25rem'][c.level||2] || '1.875rem';
          return `<${tag} style="font-family:Georgia,serif;font-size:${sz};font-weight:700;text-align:${c.align||'left'};margin:0 0 1rem">${c.text||''}</${tag}>`;
        }
        case 'text':    return `<div style="line-height:1.75;color:#374151;margin-bottom:1.5rem">${c.html||''}</div>`;
        case 'image':   return c.url ? `
          <figure style="text-align:${c.align||'center'};margin:0 0 1.5rem">
            <img src="${c.url}" alt="${c.alt||''}" style="max-width:${c.width||100}%;border-radius:0.75rem;display:inline-block"/>
            ${c.caption ? `<figcaption style="font-size:0.8rem;color:#9ca3af;margin-top:0.5rem">${c.caption}</figcaption>` : ''}
          </figure>` : '';
        case 'button':  return `<div style="text-align:${c.align||'center'};margin:1.5rem 0"><a href="${c.url||'/'}" style="${BTN[c.style||'primary']||BTN.primary}">${c.text||'Click Here'}</a></div>`;
        case 'columns': return `
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:${GAP[c.gap||'md']};margin:1.5rem 0">
            <div style="line-height:1.75">${c.col1||''}</div>
            <div style="line-height:1.75">${c.col2||''}</div>
          </div>`;
        case 'divider': return `<hr style="border:none;border-top:1px ${c.style||'solid'} #e5e7eb;margin:${SPACER[c.spacing||'md']} 0"/>`;
        case 'spacer':  return `<div style="height:${SPACER[c.height||'md']}"></div>`;
        case 'html':    return c.code || '';
        default:        return '';
      }
    }

    fetch(`/.netlify/functions/get-page?slug=${encodeURIComponent(slug)}`)
      .then(r => r.json())
      .then(page => {
        if (!page || page.error) {
          document.getElementById('page-root').innerHTML = '<div style="text-align:center;padding:4rem;color:#9ca3af"><h1 style="font-size:2rem;margin-bottom:1rem">404 — Page Not Found</h1><a href="/" style="color:#7c3aed">Go home →</a></div>';
          return;
        }
        document.title = page.title + ' — Bliss Dermacare';
        document.getElementById('page-root').innerHTML =
          `<div class="page-content">${(page.blocks || []).map(renderBlock).join('')}</div>`;
      })
      .catch(() => {
        document.getElementById('page-root').innerHTML = '<div style="text-align:center;padding:4rem;color:#9ca3af"><p>Failed to load page. Please try again.</p></div>';
      });
  </script>
</Layout>
