---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Advanced Treatments – Bliss Dermacare" description="Medical-grade aesthetic procedures at Bliss Dermacare: PRP, Lip Filler, Erectile Dysfunction Injectables, Collagen Induction Therapy, and GLP-1 Weight Loss Program in Tampa, FL.">

  <section class="py-14 bg-[#faf9f7] border-b border-neutral-100">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="flex items-center justify-center gap-2 text-sm text-neutral-500 mb-4">
        <a href="/services/" class="hover:text-primary-600 transition-colors">All Services</a>
        <span>/</span>
        <span class="text-neutral-900 font-medium">Advanced Treatments</span>
      </div>
      <span class="text-primary-600 uppercase tracking-[0.2em] text-xs font-semibold mb-4 block">Clinical Aesthetics</span>
      <h1 class="text-5xl font-serif text-neutral-900 mb-4">Advanced Treatments</h1>
      <p class="text-lg text-neutral-600 max-w-xl mx-auto">Medical-grade aesthetic procedures for transformative, lasting results. All advanced services require a standalone booking. Consultation required for select treatments.</p>
    </div>
  </section>

  <section class="py-14 bg-white" id="svc-section" style="opacity:0">
    <div class="max-w-7xl mx-auto px-6">
    </div>
  </section>

  <section class="py-10 bg-neutral-50 border-t border-neutral-100">
    <div class="max-w-7xl mx-auto px-6">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-neutral-400 mb-4">Also Explore</p>
      <div class="flex flex-wrap gap-3">
        <a href="/services/facials/" class="px-4 py-2 bg-white border border-neutral-200 rounded-full text-sm text-neutral-700 hover:border-primary-300 hover:text-primary-600 transition-colors">Facials</a>
        <a href="/services/ancillary/" class="px-4 py-2 bg-white border border-neutral-200 rounded-full text-sm text-neutral-700 hover:border-primary-300 hover:text-primary-600 transition-colors">Ancillary Services</a>
        <a href="/services/semipermanent-makeup/" class="px-4 py-2 bg-white border border-neutral-200 rounded-full text-sm text-neutral-700 hover:border-primary-300 hover:text-primary-600 transition-colors">Semipermanent Makeup</a>
        <a href="/services/packages/" class="px-4 py-2 bg-white border border-neutral-200 rounded-full text-sm text-neutral-700 hover:border-primary-300 hover:text-primary-600 transition-colors">Seasonal Packages</a>
      </div>
    </div>
  </section>

  <section class="py-14 bg-neutral-900 text-white text-center">
    <div class="max-w-xl mx-auto px-6">
      <h2 class="text-3xl font-serif mb-4">Ready to book?</h2>
      <p class="text-neutral-400 mb-8">All advanced treatments are standalone bookings. We'll confirm your appointment within 24 hours.</p>
      <a href="/book/" class="inline-flex items-center gap-2 bg-primary-600 text-white px-8 py-4 rounded-full hover:bg-primary-700 transition-all font-medium shadow-lg">Request Booking <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg></a>
    </div>
  </section>

  <script>
    function _esc(s: unknown): string {
      return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function _card(svc: any): string {
      const price = svc.price ? '$' + Math.round(svc.price / 100) : 'Contact us';
      const dur   = svc.duration ? svc.duration + ' min' : '';
      const img   = svc.image_url
        ? '<img src="' + _esc(svc.image_url) + '" alt="' + _esc(svc.name) + '" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" loading="lazy"/>'
        : '<div class="w-full h-full bg-gradient-to-br from-primary-50 to-rose-50"></div>';
      const desc  = (svc.tagline || svc.description) ? '<p class="text-neutral-600 text-sm mb-4">' + _esc(svc.tagline || svc.description) + '</p>' : '';
      return (
        '<div class="group bg-white rounded-2xl overflow-hidden hover:shadow-xl transition-all border-2 border-primary-100 hover:border-primary-300">' +
        '<div class="relative h-44 overflow-hidden">' + img + '<div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div></div>' +
        '<div class="p-6"><h3 class="text-xl font-bold font-serif text-neutral-900 mb-2">' + _esc(svc.name) + '</h3>' + desc +
        '<div class="flex items-center justify-between"><div><p class="text-2xl font-bold text-primary-600">' + _esc(price) + '</p>' +
        (dur ? '<p class="text-xs text-neutral-500">' + _esc(dur) + '</p>' : '') +
        '</div><a href="/book/" class="px-4 py-2 bg-primary-600 text-white text-sm font-semibold rounded-full hover:bg-primary-700 transition-colors">Book</a></div></div></div>'
      );
    }
    function _show(): void {
      const s = document.getElementById('svc-section');
      if (s) { s.style.transition = 'opacity 0.2s'; s.style.opacity = '1'; }
    }
    fetch('/.netlify/functions/get-services?category=advanced')
      .then(r => r.json())
      .then(({ services }) => {
        if (!services?.length) { _show(); return; }
        const map = new Map<string, any>(services.map((s: any) => [s.slug, s]));
        const covered = new Set<string>();
        document.querySelectorAll<HTMLAnchorElement>('a[data-service-id]').forEach(link => {
          const slug = link.getAttribute('data-service-id') || '';
          const svc  = map.get(slug);
          const card = link.closest('.group') as HTMLElement | null;
          if (!card) return;
          if (!svc) { card.style.display = 'none'; return; }
          covered.add(slug);
          const priceEl = card.querySelector<HTMLElement>('[class*="font-bold"][class*="text-primary-6"]');
          if (priceEl && /^\$\d/.test(priceEl.textContent || '')) priceEl.textContent = '$' + Math.round(svc.price / 100);
          if (svc.image_url) { const img = card.querySelector<HTMLImageElement>('img'); if (img) img.src = svc.image_url; }
        });
        const extras = services.filter((s: any) => !covered.has(s.slug));
        if (extras.length) {
          const wrap = document.querySelector<HTMLElement>('section.py-14.bg-white .max-w-7xl');
          if (wrap) {
            const g = document.createElement('div');
            g.className = 'mt-6 grid md:grid-cols-2 lg:grid-cols-3 gap-6';
            g.innerHTML = extras.map(_card).join('');
            wrap.appendChild(g);
          }
        }
        _show();
      }).catch(_show);
  </script>

</Layout>
