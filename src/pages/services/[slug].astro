---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

const { slug } = Astro.params as { slug: string };

const CATEGORY_KEY: Record<string, string> = {
  'advanced-treatments':  'advanced',
  'semipermanent-makeup': 'semipermanent',
  'ancillary':            'wellness',
};
const dbCategory = CATEGORY_KEY[slug] ?? slug;

const supabase = createClient(
  import.meta.env.SUPABASE_URL!,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY!
);

const [{ data: allCats }, { data: rawServices }] = await Promise.all([
  supabase.from('service_categories').select('id,slug,name,tagline,description,page_url').eq('active', true).order('sort_order', { ascending: true }),
  supabase.from('services').select('id,slug,name,tagline,description,price,duration,image_url,badge,is_package,active').eq('category', dbCategory).neq('active', false).order('sort_order', { ascending: true }),
]);

const cats    = allCats ?? [];
const svcs    = rawServices ?? [];
const thisCat = cats.find(c => c.slug === slug || c.slug === dbCategory);
const others  = cats.filter(c => c.slug !== slug && c.slug !== dbCategory);

// Redirect unknown slugs
if (!thisCat && !svcs.length) return Astro.redirect('/services/', 302);

const catName = thisCat?.name ?? slug.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
const title   = `${catName} – Bliss Dermacare`;
const desc    = thisCat?.description ?? thisCat?.tagline ?? `${catName} at Bliss Dermacare in Tampa, FL.`;
---

<Layout title={title} description={desc}>

  <!-- Page Header â€” server-rendered -->
  <section class="py-14 bg-[#faf9f7] border-b border-neutral-100">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="flex items-center justify-center gap-2 text-sm text-neutral-500 mb-4">
        <a href="/services/" class="hover:text-primary-600 transition-colors">All Services</a>
        <span>/</span>
        <span class="text-neutral-900 font-medium">{catName}</span>
      </div>
      {thisCat?.tagline && (
        <span class="text-primary-600 uppercase tracking-[0.2em] text-xs font-semibold mb-4 block">{thisCat.tagline}</span>
      )}
      <h1 class="text-5xl font-serif text-neutral-900 mb-4">{catName}</h1>
      {(thisCat?.description) && (
        <p class="text-lg text-neutral-600 max-w-xl mx-auto">{thisCat.description}</p>
      )}
    </div>
  </section>

  <!-- Service Cards â€” server-rendered -->
  <section class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      {svcs.length > 0 ? (
        <div class={`grid gap-6 ${dbCategory === 'packages' ? 'md:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3'}`}>
          {svcs.map(svc => {
            const price = svc.price ? '$' + Math.round(svc.price / 100) : 'Contact us';
            const dur   = svc.duration ? svc.duration + ' min' : '';
            const body  = svc.tagline || svc.description;
            return (
              <div class="group bg-white rounded-2xl overflow-hidden hover:shadow-xl transition-all border-2 border-primary-100 hover:border-primary-300 relative">
                <div class="relative h-44 overflow-hidden">
                  {svc.image_url ? (
                    <img src={svc.image_url} alt={svc.name} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" loading="lazy" />
                  ) : (
                    <div class="w-full h-full bg-gradient-to-br from-primary-50 to-rose-50 flex items-center justify-center">
                      <svg class="w-10 h-10 text-primary-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                  {svc.badge && (
                    <span class="absolute top-2 right-2 text-[10px] font-bold bg-amber-500 text-white px-2 py-0.5 rounded-full">{svc.badge}</span>
                  )}
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-bold font-serif text-neutral-900 mb-2">{svc.name}</h3>
                  {body && <p class="text-neutral-600 text-sm mb-4">{body}</p>}
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-2xl font-bold text-primary-600">{price}</p>
                      {dur && <p class="text-xs text-neutral-500">{dur}</p>}
                    </div>
                    <a href="/book/" data-service-id={svc.slug} class="px-4 py-2 bg-primary-600 text-white text-sm font-semibold rounded-full hover:bg-primary-700 transition-colors">Book</a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <p class="text-center text-neutral-400 py-12">No services currently available in this category.</p>
      )}
    </div>
  </section>

  <!-- Also Explore â€” server-rendered -->
  {others.length > 0 && (
    <section class="py-10 bg-neutral-50 border-t border-neutral-100">
      <div class="max-w-7xl mx-auto px-6">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-neutral-400 mb-4">Also Explore</p>
        <div class="flex flex-wrap gap-3">
          {others.map(c => (
            <a href={c.page_url ?? `/services/${c.slug}/`} class="px-4 py-2 bg-white border border-neutral-200 rounded-full text-sm text-neutral-700 hover:border-primary-300 hover:text-primary-600 transition-colors">
              {c.name}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Book CTA -->
  <section class="py-14 bg-neutral-900 text-white text-center">
    <div class="max-w-xl mx-auto px-6">
      <h2 class="text-3xl font-serif mb-4">Ready to book?</h2>
      <p class="text-neutral-400 mb-8">Choose your service and request a time that works for you. We'll confirm within 24 hours.</p>
      <a href="/book/" class="inline-flex items-center gap-2 bg-primary-600 text-white px-8 py-4 rounded-full hover:bg-primary-700 transition-all font-medium shadow-lg">
        Request Booking
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>
  </section>

</Layout>