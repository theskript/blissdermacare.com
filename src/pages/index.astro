---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(import.meta.env.SUPABASE_URL!, import.meta.env.SUPABASE_SERVICE_ROLE_KEY!);

const [{ data: svcsData }, { data: partnersData }, { data: contentData }, { data: reviewsData }, { data: plansData }] = await Promise.all([
  supabase.from('services').select('slug,name,price,tagline,description,image_url,category,is_package,featured,active').neq('active', false).order('sort_order', { ascending: true }),
  supabase.from('partners').select('name,url,logo_url,badge_text').eq('featured', true).eq('active', true).order('sort_order', { ascending: true }),
  supabase.from('site_content').select('section_key,value').eq('page_key', 'home'),
  supabase.from('reviews').select('id,client_name,service_name,rating,review_text').eq('published', true).order('featured', { ascending: false }).order('sort_order').order('created_at', { ascending: false }).limit(3),
  supabase.from('membership_plans').select('slug,price').neq('active', false),
]);

const allSvcs = svcsData ?? [];
const partners = partnersData ?? [];
const reviews = reviewsData ?? [];

const sc: Record<string, string> = {};
for (const r of contentData ?? []) { if (r.value) sc[r.section_key] = r.value; }
function v(key: string, fallback = '') { return sc[key] ?? fallback; }

const featured = allSvcs.filter((s: any) => s.featured);
const plans = plansData ?? [];
const planPx = (slug: string, def: number) => { const p = plans.find((p: any) => p.slug === slug); return p ? Math.round(p.price / 100) : def; };
const hasPackages = allSvcs.some((s: any) => s.category === 'packages');
const sprayTan = allSvcs.find((s: any) => s.slug === 'spray-tan');
const sprayTanPrice = sprayTan ? Math.round((sprayTan as any).price / 100) : 35;

function safeUrl(u: string): string {
  try { const x = new URL(u); return (x.protocol === 'http:' || x.protocol === 'https:') ? u : '#'; } catch { return '#'; }
}
---

